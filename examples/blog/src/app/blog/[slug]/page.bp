//// `/blog/[slug]` — one post; a missing slug is jhonstart's notFound()
//// (404 before the first chunk). Imports through the app's aliases: only
//// `onze build` rewrites them, which is the point (front 49's alias map).

import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound} from "jhonstart";
import {readPost, parsePost} from "@/lib.db";

#[page("blog/[slug]")]
pub fn post(route: PageContext) -> @Component<ElementBase, Element> {
    val ps = postParams(route);
    val found = readPost(ps.slug);
    if (found.isError()) notFound();
    val one = found.unwrapOr(parsePost(ps.slug, ""));
    return article([h1([text(one.title, attrs: [])], attrs: []), p([text(one.body, attrs: [])], attrs: [])], attrs: []);
}
