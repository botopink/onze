//// `/blog` — every post, newest first, each in a PostCard (front 28 reads
//// the store; front 12's tag would cache it once rakun-cache has a surface).

import {page, layout, jhPage, jhLayout, ctxParam, ctxRest, PageContext, LayoutProps, Element, ElementBase, main, section, article, h1, h2, p, text, notFound} from "jhonstart";
import {listPosts} from "lib.db";
import {PostCard} from "components.post_card";

#[page("blog")]
pub fn blogIndex(route: PageContext) -> @Component<ElementBase, Element> {
    return section(listPosts().map({ post -> PostCard(post) }), attrs: []);
}
