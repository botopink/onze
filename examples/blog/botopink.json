{
  "name": "blog",
  "version": "0.0.1",
  "description": "onze's acceptance app (front 53) — a blog with an author dashboard: every seam of rakun, jhonstart and emilia at once",
  "src": "src/",
  "entry": "root.bp",
  "target": "commonJS",
  "files": [
    "root.bp",
    "lib/mod.bp",
    "lib/db.bp"
  ],
  "alias": {
    "@/components": "components",
    "@/lib": "lib"
  },
  "dependencies": {
    "jhonstart": {
      "path": "../../../jhonstart/modules/jhonstart"
    },
    "jhonstart-link": {
      "path": "../../../jhonstart/modules/jhonstart-link"
    },
    "jhonstart-forms": {
      "path": "../../../jhonstart/modules/jhonstart-forms"
    },
    "emilia": {
      "path": "../../../emilia/modules/emilia"
    },
    "jhonstart-emilia": {
      "path": "../../../jhonstart/modules/jhonstart-emilia"
    },
    "onze": {
      "workspace": true
    }
  }
}
