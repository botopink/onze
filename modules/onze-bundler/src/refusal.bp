//// onze-bundler — the build refusals (front 68 step 3).
////
//// Each rule is a statement about the file the browser downloads, so each is
//// a hard failure: no configuration value, decorator or CLI flag relaxes any
//// of them (decision 67). Only modules IN the client graph are checked, and
//// every refusal carries the chain from the client root that pulled the
//// module in — "module X reads a secret" fixes nothing; which component
//// dragged X into the browser does.
////
////   server-only     a client-graph module imports front 29's `serverOnly`
////   request-scope   a client-graph module imports jhonstart's `request`,
////                   `cookies` or `headers` (server-only by front 29's rule 3)
////   env-non-public  `env.read("X")` where `X` fails front 49's
////                   `isPublicEnvName` (the `ONZE_PUBLIC_` prefix, case-sensitive)
////   env-dynamic     `env.read(<not a literal>)` — a name the bundler cannot
////                   read is a name it cannot clear
////   env-vars        `env.vars()` — it would publish every name
////   env-write       `env.write` / `env.clear` — a client has no environment
////   emilia-non-literal  an `emilia(…)` whose token list is not a literal (or
////                   a module-level `val` of one): a class computed from runtime
////                   data cannot be in the server's stylesheet
////   emilia-flush    a `flush()` call — the `<style>` block is the server's
////   emilia-hash-split  a literal token list with a non-ASCII character:
////                   std's `contentHash` folds UTF-16 units on commonJS and
////                   code points on erlang, so the two class names could differ
////                   (`contracts.md § 4` clause 3)
////
//// Every refusal of a build is reported, never only the first.

import {isPublicEnvName, OnzeConfig} from "onze";
import {ImportRef, importsServerOnly, requestScopeImports} from "scan";
import {AppModule, ClientGraph, GraphNode, chainOf, chainText} from "graph";

pub type BuildRefusal(kind: string, subject: string, moduleId: string, chain: Array<string>)

pub type EmiliaCall(moduleId: string, line: i32, text: string, literal: bool, tokens: string)

pub type BuildReport(inlined: Array<#(string, string)>, styleMap: Array<#(string, string)>, refusals: Array<BuildRefusal>)

fn graphModules(graph: ClientGraph, modules: Array<AppModule>) -> Array<AppModule> {
    return graph.nodes.map({ n -> moduleOf(modules, n.moduleId) });
}

fn moduleOf(modules: Array<AppModule>, id: string) -> AppModule {
    val hit = modules.filter({ m -> m.id == id });
    return hit.at(0).unwrapOr(AppModule(id: id, path: "", source: "", refs: [], client: false));
}

// ── refusal 1 — server-only and request scope ───────────────────────────────

pub fn checkServerOnly(graph: ClientGraph, modules: Array<AppModule>) -> Array<BuildRefusal> {
    var out: Array<BuildRefusal> = [];
    for (graphModules(graph, modules)) { m ->
        if (importsServerOnly(m.refs)) out.push(BuildRefusal(kind: "server-only", subject: "serverOnly", moduleId: m.id, chain: chainOf(graph, m.id)));
        for (requestScopeImports(m.refs)) { name ->
            out.push(BuildRefusal(kind: "request-scope", subject: name, moduleId: m.id, chain: chainOf(graph, m.id)));
        };
    };
    return out;
}

// ── refusal 2 — the environment ─────────────────────────────────────────────

fn argAfter(text: string, open: i32) -> string {
    var depth = 0;
    var out = "";
    var done = false;
    for (text.slice(open).split("")) { c ->
        if (done == false) {
            if (c == "(") depth = depth + 1;
            if (c == ")") depth = depth - 1;
            if (depth == 0) {
                done = true;
            } else {
                out = out + c;
            };
        };
    };
    return out.slice(1).trim();
}

fn isStringLiteral(arg: string) -> bool {
    val quoted = arg.length() >= 2 && arg.startsWith("\"") && arg.endsWith("\"");
    return quoted && arg.slice(1, arg.length() - 1).contains("\"") == false;
}

// The positions of `needle` in `text`, left to right.
fn positionsOf(text: string, needle: string) -> i32[] {
    var out: i32[] = [];
    var offset = 0;
    var rest = text;
    var at = rest.indexOf(needle);
    while (at >= 0) {
        out.push(offset + at);
        offset = offset + at + needle.length();
        rest = text.slice(offset);
        at = rest.indexOf(needle);
    };
    return out;
}

// The environment calls of one client module and what the build does with
// each: `#(name, value)` pairs to inline, and the refusals.
pub fn checkEnvIn(m: AppModule, chain: Array<string>, envOf: fn(name: string) -> string) -> #(Array<#(string, string)>, Array<BuildRefusal>) {
    var inlined: Array<#(string, string)> = [];
    var refused: Array<BuildRefusal> = [];
    for (m.source.split("\n")) { line ->
        for (positionsOf(line, "env.read(")) { at ->
            val arg = argAfter(line, at + 8);
            if (isStringLiteral(arg)) {
                val name = arg.slice(1, arg.length() - 1);
                if (isPublicEnvName(name)) {
                    inlined.push(#(name, envOf(name)));
                } else {
                    refused.push(BuildRefusal(kind: "env-non-public", subject: name, moduleId: m.id, chain: chain));
                };
            } else {
                refused.push(BuildRefusal(kind: "env-dynamic", subject: "(expression)", moduleId: m.id, chain: chain));
            };
        };
        for (positionsOf(line, "env.vars(")) { at ->
            refused.push(BuildRefusal(kind: "env-vars", subject: "env.vars()", moduleId: m.id, chain: chain));
        };
        for (positionsOf(line, "env.write(")) { at ->
            refused.push(BuildRefusal(kind: "env-write", subject: "env.write", moduleId: m.id, chain: chain));
        };
        for (positionsOf(line, "env.clear(")) { at ->
            refused.push(BuildRefusal(kind: "env-write", subject: "env.clear", moduleId: m.id, chain: chain));
        };
    };
    return #(inlined, refused);
}

pub fn checkEnvReads(graph: ClientGraph, modules: Array<AppModule>, envOf: fn(name: string) -> string) -> #(Array<#(string, string)>, Array<BuildRefusal>) {
    var inlined: Array<#(string, string)> = [];
    var refused: Array<BuildRefusal> = [];
    for (graphModules(graph, modules)) { m ->
        val r = checkEnvIn(m, chainOf(graph, m.id), envOf);
        for (r._0) { p ->
            val seen = inlined.any({ q -> q._0 == p._0 });
            if (seen == false) inlined.push(p);
        };
        for (r._1) { x ->
            refused.push(x);
        };
    };
    return #(inlined, refused);
}

// ── refusal 3 — emilia in a client module ──────────────────────────────────

fn isAscii(text: string) -> bool {
    return text.split("").all({ c -> c.charCodeAt(0) < 128 });
}

fn literalValNames(source: string) -> string[] {
    var out: string[] = [];
    for (source.split("\n")) { raw ->
        val l = raw.trim();
        val decl = l.startsWith("val ") && l.contains("= [") && l.contains("emilia(") == false;
        if (decl) out.push(l.slice(4, l.indexOf("=")).trim().split(":").at(0).unwrapOr("").trim());
    };
    return out;
}

// Every `emilia(…)` call of `source`, with whether its token list is a
// literal (or a module-level `val` of one).
pub fn emiliaCallsOf(moduleId: string, source: string) -> Array<EmiliaCall> {
    var out: Array<EmiliaCall> = [];
    val vals = literalValNames(source);
    var n = 0;
    for (source.split("\n")) { line ->
        n = n + 1;
        for (positionsOf(line, "emilia(")) { at ->
            val before = if (at == 0) "" else line.slice(at - 1, at);
            val standalone = before == "" || " ([{,=!".contains(before);
            if (standalone) {
                val arg = argAfter(line, at + 6);
                val literal = (arg.startsWith("[") && arg.endsWith("]")) || vals.contains(arg);
                out.push(EmiliaCall(moduleId: moduleId, line: n, text: "emilia(" + arg + ")", literal: literal, tokens: arg));
            };
        };
    };
    return out;
}

fn flushLines(source: string) -> i32[] {
    var out: i32[] = [];
    var n = 0;
    for (source.split("\n")) { line ->
        n = n + 1;
        val calls = positionsOf(line, "flush(").filter({ at -> at == 0 || " (!=".contains(line.slice(at - 1, at)) });
        if (calls.length > 0) out.push(n);
    };
    return out;
}

pub fn checkEmiliaCalls(graph: ClientGraph, modules: Array<AppModule>) -> #(Array<#(string, string)>, Array<BuildRefusal>) {
    var styleMap: Array<#(string, string)> = [];
    var refused: Array<BuildRefusal> = [];
    for (graphModules(graph, modules)) { m ->
        var k = 0;
        for (emiliaCallsOf(m.id, m.source)) { c ->
            k = k + 1;
            val site = m.id + ":" + c.line.toString();
            if (c.literal == false) {
                refused.push(BuildRefusal(kind: "emilia-non-literal", subject: c.text, moduleId: site, chain: chainOf(graph, m.id)));
            } else if (isAscii(c.tokens) == false) {
                refused.push(BuildRefusal(kind: "emilia-hash-split", subject: c.text, moduleId: site, chain: chainOf(graph, m.id)));
            } else {
                styleMap.push(#(m.id + "#" + k.toString(), c.tokens));
            };
        };
        for (flushLines(m.source)) { line ->
            refused.push(BuildRefusal(kind: "emilia-flush", subject: "flush() in a client module", moduleId: m.id + ":" + line.toString(), chain: chainOf(graph, m.id)));
        };
    };
    return #(styleMap, refused);
}

// ── the report ──────────────────────────────────────────────────────────────

// Every refusal of the build, and what it inlines. `config` is read for
// nothing: it is a parameter so a test can prove no field relaxes a rule.
pub fn checkBuild(graph: ClientGraph, modules: Array<AppModule>, config: OnzeConfig, envOf: fn(name: string) -> string) -> BuildReport {
    val server = checkServerOnly(graph, modules);
    val env = checkEnvReads(graph, modules, envOf);
    val emilia = checkEmiliaCalls(graph, modules);
    return BuildReport(inlined: env._0, styleMap: emilia._0, refusals: server.append(env._1).append(emilia._1));
}

pub fn refusalMessage(r: BuildRefusal) -> string {
    val chain = chainText(r.chain);
    if (r.kind == "server-only") return "server-only module " + r.moduleId + " reached from client root " + r.chain.at(0).unwrapOr(r.moduleId) + "\n  " + chain;
    if (r.kind == "request-scope") return "request scope (" + r.subject + ") read in " + r.moduleId + ", reached from client root " + r.chain.at(0).unwrapOr(r.moduleId) + "\n  " + chain;
    return [r.kind.padEnd(18, " "), r.subject.padEnd(26, " "), r.moduleId.padEnd(22, " "), chain].join("  ");
}

pub fn describeReport(report: BuildReport) -> string {
    var rows: string[] = [];
    for (report.inlined) { p ->
        rows.push("inlined: " + p._0);
    };
    for (report.styleMap) { s ->
        rows.push("styleMap: " + s._0 + " -> " + s._1);
    };
    for (report.refusals) { r ->
        rows.push("refused: " + refusalMessage(r).trimEnd());
    };
    val n = report.refusals.length;
    rows.push(if (n == 0) "build ok: no refusals" else if (n == 1) "build failed: 1 refusal" else "build failed: " + n.toString() + " refusals");
    return rows.join("\n");
}
