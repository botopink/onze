// `botopink test` suite for `src/refusal.bp` (front 68 step 3), over fixture
// source strings.

import {parseFixture, ImportRef} from "scan";
import {AppModule, ClientGraph, GraphNode, loadModules, clientGraph} from "graph";
import {BuildReport, BuildRefusal, checkBuild, describeReport, refusalMessage, emiliaCallsOf} from "refusal";
import {AliasMap, OnzeConfig, defaultConfig, loadConfig} from "onze";
import {testing.snapshots} from "std";

fn aliases() -> AliasMap {
    return AliasMap(entries: [#("@/components", "components"), #("@/lib", "lib")]);
}

fn fakeEnv(name: string) -> string {
    return if (name == "ONZE_PUBLIC_API_URL") "https://api.example.com" else "";
}

fn reportWith(tree: string, cfg: OnzeConfig) -> @Result<BuildReport, string> {
    val modules = try loadModules(parseFixture(tree));
    val graph = clientGraph(modules, aliases(), "app");
    return checkBuild(graph, modules, cfg, { n -> fakeEnv(n) });
}

fn report(tree: string) -> @Result<BuildReport, string> {
    return try reportWith(tree, defaultConfig());
}

fn page(component: string) -> string {
    return ["== app/page.bp", "import { " + component + " } from \"@/components.w\";", "#[page(\"\")] pub fn home(route: PageContext) -> @Component<ElementBase, Element> { return p([]); }", "== components/w.bp", "#[client]"].join("\n");
}

test "refusal: server-only ---- the chain from the root" {
    val r = try report(["== app/page.bp", "import { Status } from \"@/components.status\";", "#[page(\"\")] pub fn home(route: PageContext) -> @Component<ElementBase, Element> { return p([]); }", "== components/status.bp", "#[client]", "import { fmt } from \"@/lib.format\";", "pub fn Status(props: P) -> Element { return p([]); }", "== lib/format.bp", "import { listPosts } from \"@/lib.db\";", "pub fn fmt() -> string { return \"\"; }", "== lib/db.bp", "import { serverOnly } from \"jhonstart\";", "pub fn listPosts() -> Post[] { return []; }"].join("\n"));
    val text = describeReport(r);
    assert text.contains("components.status > lib.format > lib.db");
    try snapshots.assertAs(@src(), "refusals", text);
}

test "refusal: request scope ---- cookies from a client module" {
    val r = try report(page("W") + "\nimport { cookies } from \"jhonstart\";\npub fn W(props: P) -> Element { return p([]); }");
    try snapshots.assertAs(@src(), "refusals", describeReport(r));
}

test "refusal: env ---- every row of the environment table" {
    val r = try report(page("Widget") + "\n" + [
        "import { io.env } from \"std\";",
        "val a = env.read(\"ONZE_PUBLIC_API_URL\");",
        "val b = env.read(\"DATABASE_URL\");",
        "val c = env.read(\"onze_public_x\");",
        "val d = env.read(someName());",
        "val e = env.vars();",
        "val f = env.write(\"X\", \"1\");",
        "val g = env.clear(\"X\");",
        "pub fn Widget(props: P) -> Element { return p([]); }",
    ].join("\n"));
    assert r.refusals.length == 6;
    assert r.inlined.length == 1;
    val text = describeReport(r);
    assert text.contains("DATABASE_URL");
    assert text.contains("components.w");
    try snapshots.assertAs(@src(), "refusals", text);
}

test "refusal: adversarial config ---- no setting relaxes anything" {
    val tree = page("Widget") + "\nimport { io.env } from \"std\";\nval b = env.read(\"DATABASE_URL\");\npub fn Widget(props: P) -> Element { return p([]); }";
    val plain = try report(tree);
    val loose = try loadConfig("{ \"name\": \"x\" }", "{ \"dev\": true, \"port\": 1, \"basePath\": \"/x\", \"appDir\": \"app\", \"publicDir\": \"\", \"outDir\": \"\", \"actionsBodyLimit\": 2147483647, \"allowedRedirects\": [\"*\"] }");
    val adversarial = try reportWith(tree, loose);
    assert describeReport(adversarial) == describeReport(plain);
    val keys = ["allowEnv", "publicEnvPrefix", "strict", "bundler"].map({ k -> k + ": " + loadError(k) });
    try snapshots.assertAs(@src(), "refusals", keys.join("\n") + "\n" + describeReport(adversarial));
}

fn loadError(key: string) -> string {
    return case loadConfig("{ \"name\": \"x\" }", "{ \"" + key + "\": true }") {
        Ok(c) -> "accepted";
        Error(message) -> "refused at config load";
    };
}

test "refusal: emilia ---- non-literal tokens, a client flush, a hash split" {
    val r = try report(page("Badge") + "\n" + [
        "import { emilia, flush, Token } from \"emilia\";",
        "val ok = emilia([.Text.Size.Sm, .Color.Gray.700]);",
        "val named = [.Gap.All.4];",
        "val viaVal = emilia(named);",
        "val astral = emilia([.Content.Text(\"\u{1F600}\")]);",
        "pub fn Badge(props: P) -> Element {",
        "    val cls = emilia(props.tokens);",
        "    val sheet = await flush();",
        "    return span([text(\"x\", attrs: [])], attrs: [#(\"class\", cls)]);",
        "}",
    ].join("\n"));
    try snapshots.assertAs(@src(), "refusals", describeReport(r));
}

test "refusal: a module outside the client graph is never checked" {
    val r = try report(["== app/page.bp", "import { io.env } from \"std\";", "import { serverOnly } from \"jhonstart\";", "val secret = env.read(\"DATABASE_URL\");", "#[page(\"\")] pub fn home(route: PageContext) -> @Component<ElementBase, Element> { return p([]); }"].join("\n"));
    assert r.refusals.length == 0;
}
