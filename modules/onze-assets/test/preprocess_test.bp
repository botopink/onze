// `botopink test` suite for `src/preprocess.bp` (front 69 step 4).

import {preprocess} from "preprocess";
import {io.fs, io.process, io.clock, path} from "std";

fn scratchFile(text: string) -> string {
    val dir = path.join([".botopinkbuild", "tmp", "pre-" + process.pid().toString() + "-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    val file = path.join([dir, "a.scss"]);
    val w = fs.writeText(file, text);
    return file;
}

fn errorOf(r: @Result<string, string>) -> string {
    return case r {
        Ok(v) -> "ok: " + v;
        Error(e) -> e;
    };
}

test "preprocess: no command returns the file unchanged" {
    val f = scratchFile("$c: red;\n.a { color: $c; }\n");
    assert preprocess("", f).unwrapOr("") == "$c: red;\n.a { color: $c; }\n";
}

test "preprocess: a command's stdout is the result" {
    val f = scratchFile("body{}\n");
    assert preprocess("cat", f).unwrapOr("") == "body{}\n";
}

test "preprocess: a missing command fails naming it" {
    val f = scratchFile("x");
    assert errorOf(preprocess("no-such-sassc-onze", f)).startsWith("preprocessor \"no-such-sassc-onze\" could not run");
}

test "preprocess: a non-zero exit fails with the command's output attached" {
    val f = path.join([".botopinkbuild", "tmp", "does-not-exist.scss"]);
    val msg = errorOf(preprocess("cat", f));
    assert msg.startsWith("preprocessor \"cat\" exited 1 on ");
    assert msg.contains(": cat: ");
}
