//// onze-cli — `scan` (front 50 step 3): the `app/` walk.
////
//// Every `.bp` file under `<root>/<appDir>` named after a routing
//// convention becomes a `RouteEntry`: its URL pattern (the bundled
//// `routing`'s `patternOf` — groups and slots contribute no segment, the
//// bracket spelling kept), its kind, the path the developer wrote, the module
//// the compiler sees after staging, and the decorator argument the file
//// actually carries. A `_`-prefixed folder is skipped with everything below
//// it. The scan fails — naming the AUTHORED path, never a staged one — when a
//// segment holds both `page.bp` and `route.bp`, when a convention file lacks
//// the decorator its kind requires, and when two authored directories stage
//// to one name (`[slug]` beside a literal `d_slug`).

import {io.fs, path} from "std";
import {segment: {parsePath, patternOf, pathProblem}} from "routing";
import {AppFile, classifyAppFile} from "onze";
import {moduleIdOf, stagedSegment} from "onze-bundler";

pub type RouteEntry(pattern: string, kind: string, authoredPath: string, modulePath: string, declared: string)

// The decorator a kind requires, `""` for the kinds the boot registers from
// the scan itself (`loading`, `error`, `not-found`, jhonstart's
// `jhLoading` / `jhError` / `jhNotFound`).
pub fn decoratorFor(kind: string) -> string {
    if (kind == "page") return "page";
    if (kind == "layout") return "layout";
    if (kind == "template") return "template";
    if (kind == "default") return "defaultView";
    if (kind == "route") return "getRoute|postRoute|putRoute|patchRoute|deleteRoute|headRoute|optionsRoute";
    return "";
}

// The argument of the first `#[<name>("…")]` in `source` for any `<name>` of
// `decorators` (`|`-separated), `null` when there is none.
pub fn declaredArgument(source: string, decorators: string) -> ?string {
    var found = "";
    var hit = false;
    for (decorators.split("|")) { name ->
        val open = "#[" + name + "(\"";
        val at = source.indexOf(open);
        if (hit == false && at >= 0) {
            val rest = source.slice(at + open.length());
            val close = rest.indexOf("\"");
            if (close >= 0) {
                found = rest.slice(0, close);
                hit = true;
            };
        };
    };
    if (hit == false) return null;
    return found;
}

pub fn patternOfSegment(seg: string) -> string {
    if (pathProblem(seg) != "") return "";
    return patternOf(parsePath(seg));
}

// The route entries of an app, from its files as `#(authored path, source)`
// pairs — the pure core of `scanApp`. `srcDir` is the package's source
// directory (`""` or `"src"`), which module ids are relative to.
pub fn scanFiles(srcDir: string, appDir: string, files: Array<#(string, string)>) -> @Result<Array<RouteEntry>, string> {
    var entries: Array<RouteEntry> = [];
    var problems: string[] = [];
    for (files) { f ->
        val classified = classifyAppFile(appDir, f._0);
        if (classified != null) {
            val af = classified ?? AppFile(authoredPath: "", segment: "", kind: "");
            val problem = pathProblem(af.segment);
            if (problem != "") problems.push(af.authoredPath + ": " + problem);
            val needs = decoratorFor(af.kind);
            val found = declaredArgument(f._1, needs);
            val missing = needs != "" && found == null;
            val carried = found ?? "";
            val declared = if (needs == "") af.segment else carried;
            if (missing) problems.push(af.authoredPath + ": a " + af.kind + " file needs #[" + needs.split("|").at(0).unwrapOr(needs) + "(\"" + af.segment + "\")]" + (if (af.kind == "route") " (or another verb's route decorator)" else ""));
            entries.push(RouteEntry(pattern: patternOfSegment(af.segment), kind: af.kind, authoredPath: af.authoredPath, modulePath: moduleIdOf(srcDir, af.authoredPath), declared: declared));
        };
    };
    for (entries) { e ->
        val segDir = path.dirname(e.authoredPath);
        val both = e.kind == "page" && entries.any({ o -> o.kind == "route" && path.dirname(o.authoredPath) == segDir });
        if (both) problems.push(segDir + ": a segment holds both page.bp and route.bp");
    };
    for (collisions(appDir, files.map({ f -> f._0 }))) { c ->
        problems.push(c);
    };
    if (problems.length > 0) throw problems.join("\n");
    return entries;
}

// Two authored directories that stage to one name, as messages naming both.
pub fn collisions(appDir: string, paths: string[]) -> string[] {
    var dirs: string[] = [];
    for (paths) { p ->
        val parts = p.split("/");
        var i = 1;
        while (i < parts.length) {
            val d = parts.take(i).join("/");
            if (dirs.contains(d) == false) dirs.push(d);
            i = i + 1;
        };
    };
    var out: string[] = [];
    for (dirs) { a ->
        for (dirs) { b ->
            val sameParent = path.dirname(a) == path.dirname(b);
            val clash = a < b && sameParent && stagedSegment(path.basename(a)) == stagedSegment(path.basename(b));
            if (clash) out.push("directories " + a + " and " + b + " both stage to " + path.dirname(a) + "/" + stagedSegment(path.basename(a)));
        };
    };
    return out;
}

// The `app/` walk on disk: `fs.walk` of `<root>/<appDir>`, sorted.
pub fn scanApp(root: string, srcDir: string, appDir: string) -> @Result<Array<RouteEntry>, string> {
    val rel = try fs.walk(path.join([root, appDir]));
    var files: Array<#(string, string)> = [];
    for (rel.filter({ r -> r.endsWith(".bp") })) { r ->
        val text = try fs.readText(path.join([root, appDir, r]));
        files.push(#(appDir + "/" + r, text));
    };
    return try scanFiles(srcDir, appDir, files);
}

pub fn describeScan(entries: Array<RouteEntry>) -> string {
    return entries.map({ e -> [e.pattern.padEnd(18, " "), e.kind.padEnd(10, " "), e.authoredPath.padEnd(34, " "), e.modulePath.padEnd(30, " "), "declared \"" + e.declared + "\""].join(" ") }).join("\n");
}
