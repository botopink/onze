//// onze-cli — `start` (front 50 step 8) and the server's generated main.
////
//// `onze build` stages the server package with one more module,
//// `onze_main.bp` (`serverMainSource`): the configuration `build` resolved,
//// written as a literal, and `main()` calling onze-server's `Onze.run` with
//// the port `PORT` names. It imports `onze_routes`, which imports every
//// decorated app module, so the program runs their `#[page]` / `#[layout]`
//// registrations before `main` (decision 140).
////
//// `start` compiles nothing. With no `<outDir>/build-id` it exits non-zero
//// naming the directory; otherwise it runs
////
////     erl -noshell -pa <outDir>/server/beam -eval '<package>@onze_main':main()
////
//// from the project root with `PORT` set — `-p`, else `PORT`, else
//// `onze.json`'s `port` (`startPort`) — and the server's output in
//// `<outDir>/server.log`.

import {io.fs, io.env, io.process, path, json.quote} from "std";
import {OnzeConfig, parsePort, packageName} from "onze";
import {Project} from "resolve";

// The configuration as botopink source: an `OnzeConfig(…)` literal.
pub fn configLiteral(c: OnzeConfig) -> string {
    val redirects = "[" + c.allowedRedirects.map({ r -> quote(r) }).join(", ") + "]";
    return "OnzeConfig(name: " + quote(c.name) + ", port: " + c.port.toString() + ", basePath: " + quote(c.basePath) + ", appDir: " + quote(c.appDir) + ", publicDir: " + quote(c.publicDir) + ", outDir: " + quote(c.outDir) + ", dev: " + (if (c.dev) "true" else "false") + ", actionsBodyLimit: " + c.actionsBodyLimit.toString() + ", allowedRedirects: " + redirects + ", lang: " + quote(c.lang) + ")";
}

// The server package's `onze_main.bp`.
pub fn serverMainSource(c: OnzeConfig) -> string {
    return [
        "// GENERATED by onze build — do not edit.",
        "",
        "import {io.env} from \"std\";",
        "import {OnzeConfig, withPort, parsePort} from \"onze\";",
        "import {Onze} from \"onze-server\";",
        "import {routeModules} from \"onze_routes\";",
        "",
        "pub fn onzeConfig() -> OnzeConfig {",
        "    return " + configLiteral(c) + ";",
        "}",
        "",
        "fn refuse(problem: string) -> i32 {",
        "    @panic(problem);",
        "}",
        "",
        "fn portOr(fallback: i32) -> i32 {",
        "    val raw = env.read(\"PORT\") ?? \"\";",
        "    if (raw == \"\") return fallback;",
        "    return case parsePort(raw, \"PORT\") {",
        "        Ok(n) -> n;",
        "        Error(e) -> refuse(e);",
        "    };",
        "}",
        "",
        "pub fn main() {",
        "    val loaded = routeModules();",
        "    val c = onzeConfig();",
        "    Onze.run(withPort(c, portOr(c.port)));",
        "}",
    ].join("\n") + "\n";
}

// The port `start` serves on: `-p <n>`, else `PORT`, else the config's.
pub fn startPort(args: string[], envPort: string, configPort: i32) -> @Result<i32, string> {
    val at = args.indexOf("-p");
    if (at >= 0) {
        val given = args.at(at + 1).unwrapOr("");
        return try parsePort(given, "onze start -p");
    }
    if (envPort != "") return try parsePort(envPort, "PORT");
    return configPort;
}

// The arguments `start` takes: `-p <port>` and nothing else.
pub fn startArgsProblem(args: string[]) -> string {
    var i = 0;
    var problem = "";
    while (i < args.length && problem == "") {
        val a = args.at(i).unwrapOr("");
        if (a == "-p") {
            i = i + 2;
        } else {
            problem = "onze start: unexpected argument " + a;
            i = args.length;
        };
    };
    return problem;
}

// Where `build` wrote the output: `outDir` against the project root.
pub fn outDirOf(p: Project) -> string {
    return if (path.isAbsolute(p.config.outDir)) p.config.outDir else path.join([p.root, p.config.outDir]);
}

fn shellQuote(s: string) -> string {
    return "'" + s.replaceAll("'", "'\\''") + "'";
}

// The package name `botopink.json` gives — the first part of every module
// atom of the staged server (`onze.json`'s `name` renames the app, not the
// package).
pub fn packageOf(p: Project) -> string {
    val manifest = fs.readText(path.join([p.root, "botopink.json"])).unwrapOr("");
    return packageName(manifest).unwrapOr(p.config.name);
}

// The command line that serves the build: from the project root, `PORT`
// set, the server's output into `<outDir>/server.log`.
pub fn serverCommand(p: Project, port: i32) -> string {
    val out = outDirOf(p);
    val entry = "'" + packageOf(p) + "@onze_main':main()";
    return "cd " + shellQuote(p.root) + " && PORT=" + port.toString() + " exec erl -noshell -pa " + shellQuote(path.join([out, "server", "beam"])) + " -eval " + shellQuote(entry) + " > " + shellQuote(path.join([out, "server.log"])) + " 2>&1";
}

// Refuses a project that was never built, naming the missing directory.
pub fn builtOutput(p: Project) -> @Result<string, string> {
    val out = outDirOf(p);
    if (fs.exists(path.join([out, "build-id"])) == false) throw "onze start: " + out + " holds no build (no build-id) - run `onze build` first; start compiles nothing";
    if (fs.exists(path.join([out, "server", "beam"])) == false) throw "onze start: " + path.join([out, "server", "beam"]) + " does not exist - run `onze build` first; start compiles nothing";
    return out;
}

// A decimal process id; `-1` for any other text.
pub fn pidOf(text: string) -> i32 {
    val digits = text.trim();
    if (digits == "") return 0 - 1;
    var n = 0;
    var ok = true;
    for (digits.split("")) { c ->
        val d = "0123456789".indexOf(c);
        if (d < 0) ok = false;
        n = n * 10 + d;
    };
    return if (ok) n else 0 - 1;
}

// Starts the server in the background and answers its process id — the
// half of `start` a test drives (the other half waits on it).
pub fn spawnServer(p: Project, port: i32) -> @Result<i32, string> {
    val out = try builtOutput(p);
    val r = try process.run("sh", ["-c", serverCommand(p, port) + " & echo $!"]);
    val pid = pidOf(r.stdout);
    if (pid < 0) throw "onze start: the server did not start: " + r.stdout.trim();
    return pid;
}

// `onze start`: serve the build in the foreground until the server exits.
pub fn startProject(p: Project, args: string[]) -> @Result<string, string> {
    val problem = startArgsProblem(args);
    if (problem != "") throw problem;
    val port = try startPort(args, env.read("PORT") ?? "", p.config.port);
    val out = try builtOutput(p);
    val r = try process.run("sh", ["-c", serverCommand(p, port)]);
    if (r.status != 0) throw "onze start: the server exited with status " + r.status.toString() + " - " + path.join([out, "server.log"]);
    return "onze start: the server stopped";
}
