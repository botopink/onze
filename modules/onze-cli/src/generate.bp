//// onze-cli — `generate` (front 50 step 4): the check, the staged tree and
//// the module tree.
////
//// `app/blog/[slug]/page.bp` cannot be reached by a `mod` path — `[slug]`,
//// `(marketing)` and `@feed` are not identifiers, `not-found` is not one and
//// `default` is a keyword — so the build STAGES the project's sources under
//// `<outDir>/src/`, renaming each directory and convention file (`d_slug`,
//// `g_marketing`, `s_feed`, `c_rest`, `o_rest`, `not_found`,
//// `default_view` — `onze-bundler`'s `stagedSegment` / `stagedStem`, the one
//// spelling the graph uses too), rewriting every alias prefix of an import
//// with front 49's `resolveAlias`, and generating:
////
////   * a `mod.bp` for every staged directory under the app that has none,
////     one `pub mod` line per child, sorted;
////   * `onze_routes.bp`, the registrations the boot owes the conventions
////     without a decorator — `jhLoading` / `jhError` / `jhNotFound` for each
////     `loading.bp`, `error.bp`, `not-found.bp`;
////   * `root.bp` — the project's own root plus `pub mod app;` and
////     `pub mod onze_routes;`;
////   * `<outDir>/botopink.json` — the project's manifest with `src` pointed
////     at the staged tree and each relative `path` dependency re-rooted.
////
//// `checkTree` compares each file's directory with its decorator argument
//// and names the AUTHORED path — the developer has never seen `d_slug`.

import {path, json.Json, json.decode, json.quote} from "std";
import {AppFile, classifyAppFile, AliasMap, resolveAlias} from "onze";
import {stagedSegment, stagedStem} from "onze-bundler";
import {RouteEntry, decoratorFor} from "scan";

pub fn banner() -> string {
    return "// GENERATED by onze build — do not edit.";
}

// ── the check ───────────────────────────────────────────────────────────────

pub fn checkTree(appDir: string, entries: Array<RouteEntry>) -> Array<string> {
    var out: string[] = [];
    for (entries) { e ->
        val f = classifyAppFile(appDir, e.authoredPath);
        val seg = f?.segment ?? "";
        val needs = decoratorFor(e.kind) != "";
        val drift = needs && e.declared != seg;
        if (drift) out.push(e.authoredPath + ": its decorator says \"" + e.declared + "\" but the file lives at \"" + seg + "\"");
    };
    return out;
}

// ── staging ─────────────────────────────────────────────────────────────────

// The staged relative path of a source file (relative to the project's
// `src`): every directory staged, the file stem staged.
pub fn stagedPath(rel: string) -> string {
    val parts = rel.split("/");
    val dirs = parts.take(parts.length - 1).map({ d -> stagedSegment(d) });
    val file = parts.at(parts.length - 1).unwrapOr("");
    val stem = if (file.endsWith(".bp")) stagedStem(file.slice(0, file.length() - 3)) + ".bp" else file;
    return dirs.append([stem]).join("/");
}

// `source` with every `from "<alias>…"` spec resolved.
pub fn rewriteImports(aliases: AliasMap, source: string) -> string {
    return source.split("\n").map({ line -> rewriteLine(aliases, line) }).join("\n");
}

fn rewriteLine(aliases: AliasMap, line: string) -> string {
    val marker = "from \"";
    val at = line.indexOf(marker);
    if (at < 0) return line;
    val rest = line.slice(at + marker.length());
    val close = rest.indexOf("\"");
    if (close < 0) return line;
    val spec = rest.slice(0, close);
    return line.slice(0, at + marker.length()) + resolveAlias(aliases, spec).replaceAll("/", ".") + rest.slice(close);
}

fn identOf(moduleId: string) -> string {
    return moduleId.replaceAll(".", "_");
}

// The `mod.bp` of every staged directory under `stagedApp` (e.g. `app`) that
// the staged file list does not already hold, as `#(path, text)`.
pub fn modFiles(stagedApp: string, stagedFiles: string[]) -> Array<#(string, string)> {
    var dirs: string[] = [stagedApp];
    for (stagedFiles.filter({ f -> f.startsWith(stagedApp + "/") })) { f ->
        val parts = f.split("/");
        var i = 2;
        while (i < parts.length) {
            val d = parts.take(i).join("/");
            if (dirs.contains(d) == false) dirs.push(d);
            i = i + 1;
        };
    };
    var out: Array<#(string, string)> = [];
    for (sortedText(dirs)) { d ->
        val own = d + "/mod.bp";
        if (stagedFiles.contains(own) == false) {
            var children: string[] = [];
            for (dirs) { c ->
                if (path.dirname(c) == d) children.push(path.basename(c));
            };
            for (stagedFiles) { f ->
                val isChild = path.dirname(f) == d && f.endsWith(".bp") && path.basename(f) != "mod.bp";
                if (isChild) children.push(path.basename(f).slice(0, path.basename(f).length() - 3));
            };
            val lines = sortedText(children).map({ c -> "pub mod " + c + ";" });
            out.push(#(own, banner() + "\n\n" + lines.join("\n") + "\n"));
        };
    };
    return out;
}

// The registrations of the conventions without a decorator.
pub fn routesModule(appDir: string, entries: Array<RouteEntry>) -> string {
    var imports: string[] = [];
    var vals: string[] = [];
    for (entries) { e ->
        val f = classifyAppFile(appDir, e.authoredPath);
        val seg = f?.segment ?? "";
        val local = identOf(e.modulePath);
        if (e.kind == "loading") {
            imports.push("import {Loading as " + local + "} from \"" + e.modulePath + "\";");
            vals.push("val __onze_" + local + " = jhLoading(" + quote(seg) + ", { -> " + local + "() });");
        } else if (e.kind == "error") {
            imports.push("import {ErrorPage as " + local + "} from \"" + e.modulePath + "\";");
            vals.push("val __onze_" + local + " = jhError(" + quote(seg) + ", { info -> " + local + "(info) });");
        } else if (e.kind == "not-found") {
            imports.push("import {NotFound as " + local + "} from \"" + e.modulePath + "\";");
            vals.push("val __onze_" + local + " = jhNotFound(" + quote(seg) + ", { -> " + local + "() });");
        };
    };
    val head = [banner(), "", "import {jhLoading, jhError, jhNotFound, Element, ErrorInfo} from \"jhonstart\";"];
    return head.append(sortedText(imports)).append([""]).append(sortedText(vals)).join("\n") + "\n";
}

// The staged package's manifest: the project's own, `src` pointed at the
// staged tree, each relative `path` dependency re-rooted one level down.
pub fn stagedManifest(manifest: string, files: string[]) -> @Result<string, string> {
    val doc = try decode(manifest);
    val members = case doc {
        Obj(members: ms) -> ms;
        _ -> [];
    };
    var fields: string[] = [];
    for (members) { m ->
        if (m._0 == "src") {
            fields.push(quote("src") + ": " + quote("src/"));
        } else if (m._0 == "files") {
            fields.push(quote("files") + ": [" + files.map({ f -> quote(f) }).join(", ") + "]");
        } else if (m._0 == "entry") {
            fields.push(quote("entry") + ": " + quote("root.bp"));
        } else if (m._0 == "dependencies") {
            fields.push(quote("dependencies") + ": " + rerootDeps(m._1));
        } else if (m._0 != "alias") {
            fields.push(quote(m._0) + ": " + jsonText(m._1));
        };
    };
    val hasFiles = members.any({ m -> m._0 == "files" });
    if (hasFiles == false) fields.push(quote("files") + ": [" + files.map({ f -> quote(f) }).join(", ") + "]");
    return "{\n  " + fields.join(",\n  ") + "\n}\n";
}

fn rerootDeps(v: Json) -> string {
    val members = case v {
        Obj(members: ms) -> ms;
        _ -> [];
    };
    return "{ " + members.map({ m -> quote(m._0) + ": " + rerootDep(m._1) }).join(", ") + " }";
}

fn rerootDep(v: Json) -> string {
    val members = case v {
        Obj(members: ms) -> ms;
        _ -> [];
    };
    return "{ " + members.map({ m -> quote(m._0) + ": " + (if (m._0 == "path") quote(reroot(textOf(m._1))) else jsonText(m._1)) }).join(", ") + " }";
}

fn reroot(p: string) -> string {
    return if (p.startsWith("/")) p else "../" + p;
}

fn textOf(v: Json) -> string {
    return case v {
        Str(value: s) -> s;
        _ -> "";
    };
}

fn jsonText(v: Json) -> string {
    return case v {
        Null -> "null";
        Bool(value: b) -> if (b) "true" else "false";
        Num(value: n) -> n.toString();
        Str(value: s) -> quote(s);
        Arr(items: xs) -> "[" + xs.map({ x -> jsonText(x) }).join(", ") + "]";
        Obj(members: ms) -> "{ " + ms.map({ m -> quote(m._0) + ": " + jsonText(m._1) }).join(", ") + " }";
    };
}

pub fn sortedText(xs: string[]) -> string[] {
    var out: string[] = [];
    for (xs) { x ->
        var placed = false;
        var next: string[] = [];
        for (out) { y ->
            val before = placed == false && x < y;
            if (before) {
                next.push(x);
                placed = true;
            };
            next.push(y);
        };
        if (placed == false) next.push(x);
        out = next;
    };
    return out;
}

// The staged package: every source file of the project (`#(path relative to
// its src, text)`), staged and alias-rewritten, the generated `mod.bp`s, the
// routes module and the root. `appRel` is the app directory relative to the
// project's src (`app` for `src/app`). Answers `#(path under <outDir>/, text)`.
pub fn stage(aliases: AliasMap, appRel: string, appDir: string, sources: Array<#(string, string)>, entries: Array<RouteEntry>, manifest: string) -> @Result<Array<#(string, string)>, string> {
    var staged: Array<#(string, string)> = [];
    var rootText = "";
    for (sources) { s ->
        if (s._0 == "root.bp") {
            rootText = s._1;
        } else {
            staged.push(#(stagedPath(s._0), rewriteImports(aliases, s._1)));
        };
    };
    val stagedApp = stagedPath(appRel + "/x.bp").split("/").take(appRel.split("/").length).join("/");
    val mods = modFiles(stagedApp, staged.map({ f -> f._0 }));
    val all = staged.append(mods).append([#("onze_routes.bp", routesModule(appDir, entries))]);
    val root = rootText.trimEnd() + "\n\n" + banner() + "\npub mod " + stagedApp.split("/").at(0).unwrapOr("app") + ";\npub mod onze_routes;\n";
    val withRoot = all.append([#("root.bp", root)]);
    val names = sortedText(withRoot.map({ f -> f._0 }));
    val manifestText = try stagedManifest(manifest, names);
    var out: Array<#(string, string)> = withRoot.map({ f -> #("src/" + f._0, f._1) });
    out.push(#("botopink.json", manifestText));
    return out;
}
