// `botopink test` suite for `src/build.bp` (front 50 step 7): `onze build`
// over the committed scaffold, twice, and a refusal that fails the build
// before anything compiles.

import {BuildResult, buildProject, srcDirOf, workspaceMembers} from "build";
import {Project, resolveProject} from "resolve";
import {OnzeConfig, AliasMap} from "onze";
import {Outcome, run} from "main";
import {io.fs, io.process, io.clock, path} from "std";

fn botopinkBin() -> string {
    var dir = process.cwd();
    var found = "";
    var guard = 0;
    while (found == "" && guard < 12) {
        val cand = path.join([dir, "repository", "botopink-lang", "zig-out", "bin", "botopink"]);
        if (fs.exists(cand)) found = cand;
        dir = path.dirname(dir);
        guard = guard + 1;
    };
    return found;
}

fn repositoryDir() -> string {
    return path.normalize(path.join([process.cwd(), "..", "..", ".."]));
}

fn failure(r: @Result<BuildResult, string>) -> string {
    return case r {
        Ok(b) -> "ok";
        Error(e) -> e;
    };
}

test "build: srcDirOf and the workspace members" {
    assert srcDirOf("{ \"name\": \"x\", \"src\": \"src/\" }") == "src";
    assert srcDirOf("{ \"name\": \"x\" }") == "src";
    val members = workspaceMembers(path.join([process.cwd(), "..", "..", "examples", "scaffold"]));
    assert members.any({ m -> m._0 == "onze" });
}

test "build: the scaffold ---- five entries, a stable build id, no server started" {
    val bin = botopinkBin();
    assert bin != "";
    val dir = path.normalize(path.join([process.cwd(), "..", "..", "examples", "scaffold"]));
    val p = try resolveProject(dir);
    val first = try buildProject(p, bin);
    val out = path.join([dir, ".onze"]);
    for (["src", "server", "static", "client-manifest.txt", "build-id"]) { entry ->
        assert fs.exists(path.join([out, entry]));
    };
    assert fs.readText(path.join([out, "build-id"])).unwrapOr("") == first.buildId + "\n";
    assert first.manifest.startsWith("V|1|" + first.buildId + "\n");
    val second = try buildProject(p, bin);
    assert second.buildId == first.buildId;
    val cleaned = process.run("rm", ["-rf", out]);
}

test "build: a client module reading a non-public variable fails the build, naming both" {
    val dir = path.join([process.cwd(), ".botopinkbuild", "tmp", "build-" + process.pid().toString() + "-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    val created = run(dir, ["create", "leaky", "--yes", "--libs", repositoryDir()], "test");
    assert created.code == 0;
    val app = path.join([dir, "leaky"]);
    val c = fs.writeText(path.join([app, "src", "app", "widget.bp"]), "import {Element, p} from \"jhonstart\";\nimport {io.env} from \"std\";\n\n#[client]\npub fn Widget() -> Element {\n    val secret = env.read(\"DATABASE_URL\");\n    return p([], attrs: []);\n}\n");
    val pg = fs.writeText(path.join([app, "src", "app", "page.bp"]), "import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, h1, text} from \"jhonstart\";\nimport {Widget} from \"app.widget\";\n\n#[page(\"\")]\npub fn home(route: PageContext) -> @Component<ElementBase, Element> {\n    return h1([text(\"x\", attrs: [])], attrs: []);\n}\n");
    val p = try resolveProject(app);
    val msg = failure(buildProject(p, botopinkBin()));
    assert msg.contains("env-non-public");
    assert msg.contains("DATABASE_URL");
    assert msg.contains("app.widget");
    assert fs.exists(path.join([app, ".onze"])) == false;
    val gone = process.run("rm", ["-rf", dir]);
}

test "build: a CSS module's generated accessors compile and its rules reach the stylesheet" {
    val dir = path.join([process.cwd(), ".botopinkbuild", "tmp", "styled-" + process.pid().toString() + "-" + clock.nowMillis().toString()]);
    val made = process.run("mkdir", ["-p", dir]);
    val created = run(dir, ["create", "styled", "--yes", "--no-emilia", "--libs", repositoryDir()], "test");
    assert created.code == 0;
    val app = path.join([dir, "styled"]);
    val css = fs.writeText(path.join([app, "src", "app", "home.module.css"]), ".card { padding: 8px; }\n");
    val globals = fs.writeText(path.join([app, "src", "app", "globals.css"]), "body { margin: 0; }\n");
    val pg = fs.writeText(path.join([app, "src", "app", "page.bp"]), "import {page, jhPage, ctxParam, ctxRest, PageContext, Element, ElementBase, h1, text} from \"jhonstart\";\nimport {card} from \"styles.app_home\";\n\n#[page(\"\")]\npub fn home(route: PageContext) -> @Component<ElementBase, Element> {\n    return h1([text(\"x\", attrs: [])], attrs: [#(\"class\", card())]);\n}\n");
    val p = try resolveProject(app);
    val b = try buildProject(p, botopinkBin());
    assert b.stylesheet.startsWith("body { margin: 0; }\n.home_card_");
    assert b.staged.contains("src/styles/app_home.bp");
    val gone = process.run("rm", ["-rf", dir]);
}
