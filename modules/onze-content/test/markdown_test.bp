// `markdown` beyond the spec fixtures (front 121, step 2): the default
// options (extensions, smart punctuation, heading ids), the `Element` tree
// rendered with jhonstart's escaping walker, `headings`, the node tree itself
// — the Markdown half of the front's `examples/markdown-example.bp`.

import {markdown, markdown.MdNode, markdown.MarkdownOptions};
import {Element, renderNode} from "jhonstart";

fn post() -> string {
    return """
## Introduction

Here is my _great_ post, with a [link](https://botopink.dev) and `code`.

- [x] written
- [ ] published

| Name | Stars |
|------|------:|
| Zod  |    40 |

## Conclusion

~~Wrong~~ Right. See the [introduction](#introduction).

## Conclusion
""";
}

fn rendered(source: string) -> string {
    return renderNode(markdown.toElement(markdown.parse(source)));
}

fn contains(html: string, part: string) -> @Result<void, string> {
    if (!html.contains(part)) throw "expected " + part + " in " + html;
    return;
}

test "content: inline Markdown renders to elements" {
    val html = rendered(post());
    try contains(html, "<em>great</em>");
    try contains(html, "<a href=\"https://botopink.dev\">link</a>");
    try contains(html, "<code>code</code>");
}

test "content: GitHub-flavoured extensions as elements" {
    val html = rendered(post());
    try contains(
        html,
        "<li><input type=\"checkbox\" checked=\"\" disabled=\"\"> written</li>",
    );
    try contains(
        html,
        "<li><input type=\"checkbox\" disabled=\"\"> published</li>",
    );
    try contains(html, "<th>Name</th>");
    try contains(html, "<td style=\"text-align:right\">40</td>");
    try contains(html, "<del>Wrong</del>");
}

test "content: headings get ids, and a repeated heading gets a suffix" {
    val doc = markdown.parse(post());
    val slugs = markdown
        .headings(doc)
        .map({ h -> h.depth.toString() + ":" + h.slug })
        .join(" ");
    assert slugs == "2:introduction 2:conclusion 2:conclusion-1", slugs;
    try contains(rendered(post()), "<h2 id=\"introduction\">Introduction</h2>");
    try contains(
        markdown.toHtml(doc),
        "<h2 id=\"conclusion-1\">Conclusion</h2>",
    );
}

test "content: a slug drops punctuation and keeps letters of any script" {
    val doc = markdown.parse(
        "# Hello, *World*!\n\n## Ação & reação: 2nd_take\n",
    );
    val slugs = markdown.headings(doc).map({ h -> h.slug }).join(" ");
    assert slugs == "hello-world ação--reação-2nd_take", slugs;
}

test "content: text in a document is escaped; raw HTML passes through" {
    val html = rendered("1 < 2 & 3\n\n<aside>kept</aside>");
    try contains(html, "<p>1 &lt; 2 &amp; 3</p>");
    try contains(html, "<aside>kept</aside>");
}

test "content: smart punctuation is on, and a field turns it off" {
    val smart = rendered("\"quoted\" -- and... 'single'");
    try contains(smart, "“quoted” – and… ‘single’");
    val plainDoc = markdown.parseWith(
        "\"quoted\"",
        MarkdownOptions(smartPunctuation: false),
    );
    assert renderNode(markdown.toElement(plainDoc)) == "<p>\"quoted\"</p>";
}

test "content: the extensions and the ids are options" {
    val plain = markdown.parseWith(
        "# Title\n\n~~x~~ www.botopink.dev\n",
        markdown.commonmarkOptions(),
    );
    assert markdown.toHtml(plain)
        == "<h1>Title</h1>\n<p>~~x~~ www.botopink.dev</p>\n", markdown.toHtml(
        plain,
    );
    val gfm = markdown.parse("~~x~~ www.botopink.dev\n");
    assert markdown.toHtml(gfm)
        == "<p><del>x</del> <a href=\"http://www.botopink.dev\">www.botopink.dev</a></p>\n", markdown.toHtml(
        gfm,
    );
}

test "content: the tree is the document's structure" {
    val doc = markdown.parse("# A\n\n- one\n- two\n\n```bp\nval x = 1;\n```\n");
    assert doc.nodes.length == 3;
    val kinds = doc.nodes
        .map({ n ->
            case n {
                Heading(depth, id, _) -> "h" + depth.toString() + "#" + id;
                List(ordered, _, tight: t, items) -> "list:"
                    + items.length.toString()
                    + ":"
                    + t.toString()
                    + ":"
                    + ordered.toString();
                Code(lang, body) -> "code:" + lang + ":" + body;
                _ -> "?";
            }
        })
        .join(" ");
    assert kinds == "h1#a list:2:true:false code:bp:val x = 1;\n", kinds;
}

test "content: a code block keeps its text and names its language" {
    val html = rendered("```bp\nval a = \"<b>\";\n```\n");
    assert html
        == "<pre><code class=\"language-bp\">val a = \"&lt;b&gt;\";\n</code></pre>", html;
}

test "content: footnotes are numbered by first reference and rendered last" {
    val doc = markdown.parse(
        "A[^b] and B[^a].\n\n[^a]: First.\n[^b]: Second.\n",
    );
    assert doc.footnotes
        .map({ f -> f.label + ":" + f.index.toString() })
        .join(" ")
        == "b:1 a:2";
    val html = rendered("A[^n].\n\n[^n]: The note.\n");
    try contains(
        html,
        "<sup class=\"footnote-ref\"><a href=\"#fn-n\" id=\"fnref-n\" data-footnote-ref=\"\">1</a></sup>",
    );
    try contains(
        html,
        "<section class=\"footnotes\" data-footnotes=\"\"><ol><li id=\"fn-n\"><p>The note.</p>",
    );
}

test "content: an image's alt is the plain text of its description" {
    val html = rendered("![a *b* `c`](/x.png \"T\")");
    try contains(html, "<img src=\"/x.png\" alt=\"a b c\" title=\"T\">");
}

test "content: a hard break and a thematic break are void elements" {
    val html = rendered("a  \nb\n\n***\n");
    assert html == "<p>a<br>b</p><hr>", html;
}
