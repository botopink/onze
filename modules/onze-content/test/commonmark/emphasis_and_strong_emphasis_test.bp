// CommonMark 0.31.2 spec examples — § Emphasis and strong emphasis (front 121, step 2).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 350: Emphasis and strong emphasis" {
    try same("*foo bar*\n", "<p><em>foo bar</em></p>\n");
}

test "commonmark 351: Emphasis and strong emphasis" {
    try same("a * foo bar*\n", "<p>a * foo bar*</p>\n");
}

test "commonmark 352: Emphasis and strong emphasis" {
    try same("a*\"foo\"*\n", "<p>a*&quot;foo&quot;*</p>\n");
}

test "commonmark 353: Emphasis and strong emphasis" {
    try same("*\u{A0}a\u{A0}*\n", "<p>*\u{A0}a\u{A0}*</p>\n");
}

test "commonmark 354: Emphasis and strong emphasis" {
    try same(
        "*\$*alpha.\n\n*£*bravo.\n\n*€*charlie.\n",
