// CommonMark 0.31.2 spec examples — § Indented code blocks (front 121, step 1).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 107: Indented code blocks" {
    try same(
        "    a simple\n      indented code block\n",
        "<pre><code>a simple\n  indented code block\n</code></pre>\n",
    );
}

test "commonmark 108: Indented code blocks" {
    try same(
        "  - foo\n\n    bar\n",
        "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n",
    );
}

test "commonmark 109: Indented code blocks" {
    try same(
        "1.  foo\n\n    - bar\n",
        "<ol>\n<li>\n<p>foo</p>\n<ul>\n<li>bar</li>\n</ul>\n</li>\n</ol>\n",
    );
}

test "commonmark 110: Indented code blocks" {
    try same(
        "    <a/>\n    *hi*\n\n    - one\n",
        "<pre><code>&lt;a/&gt;\n*hi*\n\n- one\n</code></pre>\n",
    );
}

test "commonmark 111: Indented code blocks" {
    try same(
        "    chunk1\n\n    chunk2\n  \n \n \n    chunk3\n",
        "<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>\n",
    );
}

test "commonmark 112: Indented code blocks" {
    try same(
        "    chunk1\n      \n      chunk2\n",
        "<pre><code>chunk1\n  \n  chunk2\n</code></pre>\n",
    );
}

test "commonmark 113: Indented code blocks" {
    try same("Foo\n    bar\n\n", "<p>Foo\nbar</p>\n");
}

test "commonmark 114: Indented code blocks" {
    try same("    foo\nbar\n", "<pre><code>foo\n</code></pre>\n<p>bar</p>\n");
}

test "commonmark 115: Indented code blocks" {
    try same(
        "# Heading\n    foo\nHeading\n------\n    foo\n----\n",
        "<h1>Heading</h1>\n<pre><code>foo\n</code></pre>\n<h2>Heading</h2>\n<pre><code>foo\n</code></pre>\n<hr />\n",
    );
}

test "commonmark 116: Indented code blocks" {
    try same(
        "        foo\n    bar\n",
        "<pre><code>    foo\nbar\n</code></pre>\n",
    );
}

test "commonmark 117: Indented code blocks" {
    try same("\n    \n    foo\n    \n\n", "<pre><code>foo\n</code></pre>\n");
}

test "commonmark 118: Indented code blocks" {
    try same("    foo  \n", "<pre><code>foo  \n</code></pre>\n");
}
