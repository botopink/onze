// CommonMark 0.31.2 spec examples — § Setext headings (front 121, step 1).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 080: Setext headings" {
    try same(
        "Foo *bar*\n=========\n\nFoo *bar*\n---------\n",
        "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n",
    );
}

test "commonmark 081: Setext headings" {
    try same("Foo *bar\nbaz*\n====\n", "<h1>Foo <em>bar\nbaz</em></h1>\n");
}

test "commonmark 082: Setext headings" {
    try same("  Foo *bar\nbaz*\t\n====\n", "<h1>Foo <em>bar\nbaz</em></h1>\n");
}

test "commonmark 083: Setext headings" {
    try same(
        "Foo\n-------------------------\n\nFoo\n=\n",
        "<h2>Foo</h2>\n<h1>Foo</h1>\n",
    );
}

test "commonmark 084: Setext headings" {
    try same(
        "   Foo\n---\n\n  Foo\n-----\n\n  Foo\n  ===\n",
        "<h2>Foo</h2>\n<h2>Foo</h2>\n<h1>Foo</h1>\n",
    );
}

test "commonmark 085: Setext headings" {
    try same(
        "    Foo\n    ---\n\n    Foo\n---\n",
        "<pre><code>Foo\n---\n\nFoo\n</code></pre>\n<hr />\n",
    );
}

test "commonmark 086: Setext headings" {
    try same("Foo\n   ----      \n", "<h2>Foo</h2>\n");
}

test "commonmark 087: Setext headings" {
    try same("Foo\n    ---\n", "<p>Foo\n---</p>\n");
}

test "commonmark 088: Setext headings" {
    try same(
        "Foo\n= =\n\nFoo\n--- -\n",
        "<p>Foo\n= =</p>\n<p>Foo</p>\n<hr />\n",
    );
}

test "commonmark 089: Setext headings" {
    try same("Foo  \n-----\n", "<h2>Foo</h2>\n");
}

test "commonmark 090: Setext headings" {
    try same("Foo\\\n----\n", "<h2>Foo\\</h2>\n");
}

test "commonmark 091: Setext headings" {
    try same(
        "`Foo\n----\n`\n\n<a title=\"a lot\n---\nof dashes\"/>\n",
        "<h2>`Foo</h2>\n<p>`</p>\n<h2>&lt;a title=&quot;a lot</h2>\n<p>of dashes&quot;/&gt;</p>\n",
    );
}

test "commonmark 092: Setext headings" {
    try same(
        "> Foo\n---\n",
        "<blockquote>\n<p>Foo</p>\n</blockquote>\n<hr />\n",
    );
}

test "commonmark 093: Setext headings" {
    try same(
        "> foo\nbar\n===\n",
        "<blockquote>\n<p>foo\nbar\n===</p>\n</blockquote>\n",
    );
}

test "commonmark 094: Setext headings" {
    try same("- Foo\n---\n", "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n");
}

test "commonmark 095: Setext headings" {
    try same("Foo\nBar\n---\n", "<h2>Foo\nBar</h2>\n");
}

test "commonmark 096: Setext headings" {
    try same(
        "---\nFoo\n---\nBar\n---\nBaz\n",
        "<hr />\n<h2>Foo</h2>\n<h2>Bar</h2>\n<p>Baz</p>\n",
    );
}

test "commonmark 097: Setext headings" {
    try same("\n====\n", "<p>====</p>\n");
}

test "commonmark 098: Setext headings" {
    try same("---\n---\n", "<hr />\n<hr />\n");
}

test "commonmark 099: Setext headings" {
    try same("- foo\n-----\n", "<ul>\n<li>foo</li>\n</ul>\n<hr />\n");
}

test "commonmark 100: Setext headings" {
    try same("    foo\n---\n", "<pre><code>foo\n</code></pre>\n<hr />\n");
}

test "commonmark 101: Setext headings" {
    try same(
        "> foo\n-----\n",
        "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n",
    );
}

test "commonmark 102: Setext headings" {
    try same("\\> foo\n------\n", "<h2>&gt; foo</h2>\n");
}

test "commonmark 103: Setext headings" {
    try same(
        "Foo\n\nbar\n---\nbaz\n",
        "<p>Foo</p>\n<h2>bar</h2>\n<p>baz</p>\n",
    );
}

test "commonmark 104: Setext headings" {
    try same(
        "Foo\nbar\n\n---\n\nbaz\n",
        "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n",
    );
}

test "commonmark 105: Setext headings" {
    try same("Foo\nbar\n* * *\nbaz\n", "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n");
}

test "commonmark 106: Setext headings" {
    try same("Foo\nbar\n\\---\nbaz\n", "<p>Foo\nbar\n---\nbaz</p>\n");
}
