// CommonMark 0.31.2 spec examples — § Thematic breaks (front 121, step 1).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 043: Thematic breaks" {
    try same("***\n---\n___\n", "<hr />\n<hr />\n<hr />\n");
}

test "commonmark 044: Thematic breaks" {
    try same("+++\n", "<p>+++</p>\n");
}

test "commonmark 045: Thematic breaks" {
    try same("===\n", "<p>===</p>\n");
}

test "commonmark 046: Thematic breaks" {
    try same("--\n**\n__\n", "<p>--\n**\n__</p>\n");
}

test "commonmark 047: Thematic breaks" {
    try same(" ***\n  ***\n   ***\n", "<hr />\n<hr />\n<hr />\n");
}

test "commonmark 048: Thematic breaks" {
    try same("    ***\n", "<pre><code>***\n</code></pre>\n");
}

test "commonmark 049: Thematic breaks" {
    try same("Foo\n    ***\n", "<p>Foo\n***</p>\n");
}

test "commonmark 050: Thematic breaks" {
    try same("_____________________________________\n", "<hr />\n");
}

test "commonmark 051: Thematic breaks" {
    try same(" - - -\n", "<hr />\n");
}

test "commonmark 052: Thematic breaks" {
    try same(" **  * ** * ** * **\n", "<hr />\n");
}

test "commonmark 053: Thematic breaks" {
    try same("-     -      -      -\n", "<hr />\n");
}

test "commonmark 054: Thematic breaks" {
    try same("- - - -    \n", "<hr />\n");
}

test "commonmark 055: Thematic breaks" {
    try same(
        "_ _ _ _ a\n\na------\n\n---a---\n",
        "<p>_ _ _ _ a</p>\n<p>a------</p>\n<p>---a---</p>\n",
    );
}

test "commonmark 056: Thematic breaks" {
    try same(" *-*\n", "<p><em>-</em></p>\n");
}

test "commonmark 057: Thematic breaks" {
    try same(
        "- foo\n***\n- bar\n",
        "<ul>\n<li>foo</li>\n</ul>\n<hr />\n<ul>\n<li>bar</li>\n</ul>\n",
    );
}

test "commonmark 058: Thematic breaks" {
    try same("Foo\n***\nbar\n", "<p>Foo</p>\n<hr />\n<p>bar</p>\n");
}

test "commonmark 059: Thematic breaks" {
    try same("Foo\n---\nbar\n", "<h2>Foo</h2>\n<p>bar</p>\n");
}

test "commonmark 060: Thematic breaks" {
    try same(
        "* Foo\n* * *\n* Bar\n",
        "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n<ul>\n<li>Bar</li>\n</ul>\n",
    );
}

test "commonmark 061: Thematic breaks" {
    try same(
        "- Foo\n- * * *\n",
        "<ul>\n<li>Foo</li>\n<li>\n<hr />\n</li>\n</ul>\n",
    );
}
