// CommonMark 0.31.2 spec examples — § Code spans (front 121, step 2).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 328: Code spans" {
    try same("`foo`\n", "<p><code>foo</code></p>\n");
}

test "commonmark 329: Code spans" {
    try same("`` foo ` bar ``\n", "<p><code>foo ` bar</code></p>\n");
}

test "commonmark 330: Code spans" {
    try same("` `` `\n", "<p><code>``</code></p>\n");
}

test "commonmark 331: Code spans" {
    try same("`  ``  `\n", "<p><code> `` </code></p>\n");
}

test "commonmark 332: Code spans" {
    try same("` a`\n", "<p><code> a</code></p>\n");
}

test "commonmark 333: Code spans" {
    try same("`\u{A0}b\u{A0}`\n", "<p><code>\u{A0}b\u{A0}</code></p>\n");
}

test "commonmark 334: Code spans" {
    try same(
        "`\u{A0}`\n`  `\n",
        "<p><code>\u{A0}</code>\n<code>  </code></p>\n",
    );
}

test "commonmark 335: Code spans" {
    try same(
        "``\nfoo\nbar  \nbaz\n``\n",
        "<p><code>foo bar   baz</code></p>\n",
    );
}

test "commonmark 336: Code spans" {
    try same("``\nfoo \n``\n", "<p><code>foo </code></p>\n");
}

test "commonmark 337: Code spans" {
    try same("`foo   bar \nbaz`\n", "<p><code>foo   bar  baz</code></p>\n");
}

test "commonmark 338: Code spans" {
    try same("`foo\\`bar`\n", "<p><code>foo\\</code>bar`</p>\n");
}

test "commonmark 339: Code spans" {
    try same("``foo`bar``\n", "<p><code>foo`bar</code></p>\n");
}

test "commonmark 340: Code spans" {
    try same("` foo `` bar `\n", "<p><code>foo `` bar</code></p>\n");
}

test "commonmark 341: Code spans" {
    try same("*foo`*`\n", "<p>*foo<code>*</code></p>\n");
}

test "commonmark 342: Code spans" {
    try same(
        "[not a `link](/foo`)\n",
        "<p>[not a <code>link](/foo</code>)</p>\n",
    );
}

test "commonmark 343: Code spans" {
    try same(
        "`<a href=\"`\">`\n",
        "<p><code>&lt;a href=&quot;</code>&quot;&gt;`</p>\n",
    );
}

test "commonmark 344: Code spans" {
    try same("<a href=\"`\">`\n", "<p><a href=\"`\">`</p>\n");
}

test "commonmark 345: Code spans" {
    try same(
        "`<https://foo.bar.`baz>`\n",
        "<p><code>&lt;https://foo.bar.</code>baz&gt;`</p>\n",
    );
}

test "commonmark 346: Code spans" {
    try same(
        "<https://foo.bar.`baz>`\n",
        "<p><a href=\"https://foo.bar.%60baz\">https://foo.bar.`baz</a>`</p>\n",
    );
}

test "commonmark 347: Code spans" {
    try same("```foo``\n", "<p>```foo``</p>\n");
}

test "commonmark 348: Code spans" {
    try same("`foo\n", "<p>`foo</p>\n");
}

test "commonmark 349: Code spans" {
    try same("`foo``bar``\n", "<p>`foo<code>bar</code></p>\n");
}
