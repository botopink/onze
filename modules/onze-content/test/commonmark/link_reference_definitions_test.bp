// CommonMark 0.31.2 spec examples — § Link reference definitions (front 121, step 1).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 192: Link reference definitions" {
    try same(
        "[foo]: /url \"title\"\n\n[foo]\n",
        "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
    );
}

test "commonmark 193: Link reference definitions" {
    try same(
        "   [foo]: \n      /url  \n           'the title'  \n\n[foo]\n",
        "<p><a href=\"/url\" title=\"the title\">foo</a></p>\n",
    );
}

test "commonmark 194: Link reference definitions" {
    try same(
        "[Foo*bar\\]]:my_(url) 'title (with parens)'\n\n[Foo*bar\\]]\n",
        "<p><a href=\"my_(url)\" title=\"title (with parens)\">Foo*bar]</a></p>\n",
    );
}

test "commonmark 195: Link reference definitions" {
    try same(
        "[Foo bar]:\n<my url>\n'title'\n\n[Foo bar]\n",
        "<p><a href=\"my%20url\" title=\"title\">Foo bar</a></p>\n",
    );
}

test "commonmark 196: Link reference definitions" {
    try same(
        "[foo]: /url '\ntitle\nline1\nline2\n'\n\n[foo]\n",
        "<p><a href=\"/url\" title=\"\ntitle\nline1\nline2\n\">foo</a></p>\n",
    );
}

test "commonmark 197: Link reference definitions" {
    try same(
        "[foo]: /url 'title\n\nwith blank line'\n\n[foo]\n",
        "<p>[foo]: /url 'title</p>\n<p>with blank line'</p>\n<p>[foo]</p>\n",
    );
}

test "commonmark 198: Link reference definitions" {
    try same("[foo]:\n/url\n\n[foo]\n", "<p><a href=\"/url\">foo</a></p>\n");
}

test "commonmark 199: Link reference definitions" {
    try same("[foo]:\n\n[foo]\n", "<p>[foo]:</p>\n<p>[foo]</p>\n");
}

test "commonmark 200: Link reference definitions" {
    try same("[foo]: <>\n\n[foo]\n", "<p><a href=\"\">foo</a></p>\n");
}

test "commonmark 201: Link reference definitions" {
    try same(
        "[foo]: <bar>(baz)\n\n[foo]\n",
        "<p>[foo]: <bar>(baz)</p>\n<p>[foo]</p>\n",
    );
}

test "commonmark 202: Link reference definitions" {
    try same(
        "[foo]: /url\\bar\\*baz \"foo\\\"bar\\baz\"\n\n[foo]\n",
        "<p><a href=\"/url%5Cbar*baz\" title=\"foo&quot;bar\\baz\">foo</a></p>\n",
    );
}

test "commonmark 203: Link reference definitions" {
    try same("[foo]\n\n[foo]: url\n", "<p><a href=\"url\">foo</a></p>\n");
}

test "commonmark 204: Link reference definitions" {
    try same(
        "[foo]\n\n[foo]: first\n[foo]: second\n",
        "<p><a href=\"first\">foo</a></p>\n",
    );
}

test "commonmark 205: Link reference definitions" {
    try same("[FOO]: /url\n\n[Foo]\n", "<p><a href=\"/url\">Foo</a></p>\n");
}

test "commonmark 206: Link reference definitions" {
    try same(
        "[ΑΓΩ]: /φου\n\n[αγω]\n",
        "<p><a href=\"/%CF%86%CE%BF%CF%85\">αγω</a></p>\n",
    );
}

test "commonmark 207: Link reference definitions" {
    try same("[foo]: /url\n", "");
}

test "commonmark 208: Link reference definitions" {
    try same("[\nfoo\n]: /url\nbar\n", "<p>bar</p>\n");
}

test "commonmark 209: Link reference definitions" {
    try same(
        "[foo]: /url \"title\" ok\n",
        "<p>[foo]: /url &quot;title&quot; ok</p>\n",
    );
}

test "commonmark 210: Link reference definitions" {
    try same("[foo]: /url\n\"title\" ok\n", "<p>&quot;title&quot; ok</p>\n");
}

test "commonmark 211: Link reference definitions" {
    try same(
        "    [foo]: /url \"title\"\n\n[foo]\n",
        "<pre><code>[foo]: /url &quot;title&quot;\n</code></pre>\n<p>[foo]</p>\n",
    );
}

test "commonmark 212: Link reference definitions" {
    try same(
        "```\n[foo]: /url\n```\n\n[foo]\n",
        "<pre><code>[foo]: /url\n</code></pre>\n<p>[foo]</p>\n",
    );
}

test "commonmark 213: Link reference definitions" {
    try same(
        "Foo\n[bar]: /baz\n\n[bar]\n",
        "<p>Foo\n[bar]: /baz</p>\n<p>[bar]</p>\n",
    );
}

test "commonmark 214: Link reference definitions" {
    try same(
        "# [Foo]\n[foo]: /url\n> bar\n",
        "<h1><a href=\"/url\">Foo</a></h1>\n<blockquote>\n<p>bar</p>\n</blockquote>\n",
    );
}

test "commonmark 215: Link reference definitions" {
    try same(
        "[foo]: /url\nbar\n===\n[foo]\n",
        "<h1>bar</h1>\n<p><a href=\"/url\">foo</a></p>\n",
    );
}

test "commonmark 216: Link reference definitions" {
    try same(
        "[foo]: /url\n===\n[foo]\n",
        "<p>===\n<a href=\"/url\">foo</a></p>\n",
    );
}

test "commonmark 217: Link reference definitions" {
    try same(
        "[foo]: /foo-url \"foo\"\n[bar]: /bar-url\n  \"bar\"\n[baz]: /baz-url\n\n[foo],\n[bar],\n[baz]\n",
        "<p><a href=\"/foo-url\" title=\"foo\">foo</a>,\n<a href=\"/bar-url\" title=\"bar\">bar</a>,\n<a href=\"/baz-url\">baz</a></p>\n",
    );
}

test "commonmark 218: Link reference definitions" {
    try same(
        "[foo]\n\n> [foo]: /url\n",
        "<p><a href=\"/url\">foo</a></p>\n<blockquote>\n</blockquote>\n",
    );
}
