// CommonMark 0.31.2 spec examples — § Hard line breaks (front 121, step 2).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 633: Hard line breaks" {
    try same("foo  \nbaz\n", "<p>foo<br />\nbaz</p>\n");
}

test "commonmark 634: Hard line breaks" {
    try same("foo\\\nbaz\n", "<p>foo<br />\nbaz</p>\n");
}

test "commonmark 635: Hard line breaks" {
    try same("foo       \nbaz\n", "<p>foo<br />\nbaz</p>\n");
}

test "commonmark 636: Hard line breaks" {
    try same("foo  \n     bar\n", "<p>foo<br />\nbar</p>\n");
}

test "commonmark 637: Hard line breaks" {
    try same("foo\\\n     bar\n", "<p>foo<br />\nbar</p>\n");
}

test "commonmark 638: Hard line breaks" {
    try same("*foo  \nbar*\n", "<p><em>foo<br />\nbar</em></p>\n");
}

test "commonmark 639: Hard line breaks" {
    try same("*foo\\\nbar*\n", "<p><em>foo<br />\nbar</em></p>\n");
}

test "commonmark 640: Hard line breaks" {
    try same("`code  \nspan`\n", "<p><code>code   span</code></p>\n");
}

test "commonmark 641: Hard line breaks" {
    try same("`code\\\nspan`\n", "<p><code>code\\ span</code></p>\n");
}

test "commonmark 642: Hard line breaks" {
    try same("<a href=\"foo  \nbar\">\n", "<p><a href=\"foo  \nbar\"></p>\n");
}

test "commonmark 643: Hard line breaks" {
    try same("<a href=\"foo\\\nbar\">\n", "<p><a href=\"foo\\\nbar\"></p>\n");
}

test "commonmark 644: Hard line breaks" {
    try same("foo\\\n", "<p>foo\\</p>\n");
}

test "commonmark 645: Hard line breaks" {
    try same("foo  \n", "<p>foo</p>\n");
}

test "commonmark 646: Hard line breaks" {
    try same("### foo\\\n", "<h3>foo\\</h3>\n");
}

test "commonmark 647: Hard line breaks" {
    try same("### foo  \n", "<h3>foo</h3>\n");
}
