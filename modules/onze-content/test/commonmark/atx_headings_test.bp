// CommonMark 0.31.2 spec examples — § ATX headings (front 121, step 1).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 062: ATX headings" {
    try same(
        "# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n",
        "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n",
    );
}

test "commonmark 063: ATX headings" {
    try same("####### foo\n", "<p>####### foo</p>\n");
}

test "commonmark 064: ATX headings" {
    try same("#5 bolt\n\n#hashtag\n", "<p>#5 bolt</p>\n<p>#hashtag</p>\n");
}

test "commonmark 065: ATX headings" {
    try same("\\## foo\n", "<p>## foo</p>\n");
}

test "commonmark 066: ATX headings" {
    try same("# foo *bar* \\*baz\\*\n", "<h1>foo <em>bar</em> *baz*</h1>\n");
}

test "commonmark 067: ATX headings" {
    try same("#                  foo                     \n", "<h1>foo</h1>\n");
}

test "commonmark 068: ATX headings" {
    try same(
        " ### foo\n  ## foo\n   # foo\n",
        "<h3>foo</h3>\n<h2>foo</h2>\n<h1>foo</h1>\n",
    );
}

test "commonmark 069: ATX headings" {
    try same("    # foo\n", "<pre><code># foo\n</code></pre>\n");
}

test "commonmark 070: ATX headings" {
    try same("foo\n    # bar\n", "<p>foo\n# bar</p>\n");
}

test "commonmark 071: ATX headings" {
    try same("## foo ##\n  ###   bar    ###\n", "<h2>foo</h2>\n<h3>bar</h3>\n");
}

test "commonmark 072: ATX headings" {
    try same(
        "# foo ##################################\n##### foo ##\n",
        "<h1>foo</h1>\n<h5>foo</h5>\n",
    );
}

test "commonmark 073: ATX headings" {
    try same("### foo ###     \n", "<h3>foo</h3>\n");
}

test "commonmark 074: ATX headings" {
    try same("### foo ### b\n", "<h3>foo ### b</h3>\n");
}

test "commonmark 075: ATX headings" {
    try same("# foo#\n", "<h1>foo#</h1>\n");
}

test "commonmark 076: ATX headings" {
    try same(
        "### foo \\###\n## foo #\\##\n# foo \\#\n",
        "<h3>foo ###</h3>\n<h2>foo ###</h2>\n<h1>foo #</h1>\n",
    );
}

test "commonmark 077: ATX headings" {
    try same("****\n## foo\n****\n", "<hr />\n<h2>foo</h2>\n<hr />\n");
}

test "commonmark 078: ATX headings" {
    try same(
        "Foo bar\n# baz\nBar foo\n",
        "<p>Foo bar</p>\n<h1>baz</h1>\n<p>Bar foo</p>\n",
    );
}

test "commonmark 079: ATX headings" {
    try same("## \n#\n### ###\n", "<h2></h2>\n<h1></h1>\n<h3></h3>\n");
}
