    );
}

test "commonmark 557: Links" {
    try same(
        "[foo]\n\n[foo]: /url \"title\"\n",
        "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
    );
}

test "commonmark 558: Links" {
    try same(
        "[*foo* bar]\n\n[*foo* bar]: /url \"title\"\n",
        "<p><a href=\"/url\" title=\"title\"><em>foo</em> bar</a></p>\n",
    );
}

test "commonmark 559: Links" {
    try same(
        "[[*foo* bar]]\n\n[*foo* bar]: /url \"title\"\n",
        "<p>[<a href=\"/url\" title=\"title\"><em>foo</em> bar</a>]</p>\n",
    );
}

test "commonmark 560: Links" {
    try same(
        "[[bar [foo]\n\n[foo]: /url\n",
        "<p>[[bar <a href=\"/url\">foo</a></p>\n",
    );
}

test "commonmark 561: Links" {
    try same(
        "[Foo]\n\n[foo]: /url \"title\"\n",
        "<p><a href=\"/url\" title=\"title\">Foo</a></p>\n",
    );
}

test "commonmark 562: Links" {
    try same(
        "[foo] bar\n\n[foo]: /url\n",
        "<p><a href=\"/url\">foo</a> bar</p>\n",
    );
}

test "commonmark 563: Links" {
    try same("\\[foo]\n\n[foo]: /url \"title\"\n", "<p>[foo]</p>\n");
}

test "commonmark 564: Links" {
    try same(
        "[foo*]: /url\n\n*[foo*]\n",
        "<p>*<a href=\"/url\">foo*</a></p>\n",
    );
}

test "commonmark 565: Links" {
    try same(
        "[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n",
        "<p><a href=\"/url2\">foo</a></p>\n",
    );
}

test "commonmark 566: Links" {
    try same("[foo][]\n\n[foo]: /url1\n", "<p><a href=\"/url1\">foo</a></p>\n");
}

test "commonmark 567: Links" {
    try same("[foo]()\n\n[foo]: /url1\n", "<p><a href=\"\">foo</a></p>\n");
}

test "commonmark 568: Links" {
    try same(
        "[foo](not a link)\n\n[foo]: /url1\n",
        "<p><a href=\"/url1\">foo</a>(not a link)</p>\n",
    );
}

test "commonmark 569: Links" {
    try same(
        "[foo][bar][baz]\n\n[baz]: /url\n",
        "<p>[foo]<a href=\"/url\">bar</a></p>\n",
    );
}

test "commonmark 570: Links" {
    try same(
        "[foo][bar][baz]\n\n[baz]: /url1\n[bar]: /url2\n",
        "<p><a href=\"/url2\">foo</a><a href=\"/url1\">baz</a></p>\n",
    );
}

test "commonmark 571: Links" {
    try same(
        "[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2\n",
        "<p>[foo]<a href=\"/url1\">bar</a></p>\n",
    );
}
