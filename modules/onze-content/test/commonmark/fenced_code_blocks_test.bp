test "commonmark 139: Fenced code blocks" {
    try same(
        "~~~~~~\naaa\n~~~ ~~\n",
        "<pre><code>aaa\n~~~ ~~\n</code></pre>\n",
    );
}

test "commonmark 140: Fenced code blocks" {
    try same(
        "foo\n```\nbar\n```\nbaz\n",
        "<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n",
    );
}

test "commonmark 141: Fenced code blocks" {
    try same(
        "foo\n---\n~~~\nbar\n~~~\n# baz\n",
        "<h2>foo</h2>\n<pre><code>bar\n</code></pre>\n<h1>baz</h1>\n",
    );
}

test "commonmark 142: Fenced code blocks" {
    try same(
        "```ruby\ndef foo(x)\n  return 3\nend\n```\n",
        "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n",
    );
}

test "commonmark 143: Fenced code blocks" {
    try same(
        "~~~~    ruby startline=3 \$%@#\$\ndef foo(x)\n  return 3\nend\n~~~~~~~\n",
        "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n",
    );
}

test "commonmark 144: Fenced code blocks" {
    try same(
        "````;\n````\n",
        "<pre><code class=\"language-;\"></code></pre>\n",
    );
}

test "commonmark 145: Fenced code blocks" {
    try same("``` aa ```\nfoo\n", "<p><code>aa</code>\nfoo</p>\n");
}

test "commonmark 146: Fenced code blocks" {
    try same(
        "~~~ aa ``` ~~~\nfoo\n~~~\n",
        "<pre><code class=\"language-aa\">foo\n</code></pre>\n",
    );
}

test "commonmark 147: Fenced code blocks" {
    try same("```\n``` aaa\n```\n", "<pre><code>``` aaa\n</code></pre>\n");
}
