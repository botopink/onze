// CommonMark 0.31.2 spec examples — § List items (front 121, step 1).
//
// Generated from <https://spec.commonmark.org/0.31.2/spec.json>: one test per
// example, Markdown in, the reference HTML out, named by the example's number.
// Rendered with `commonmarkOptions()` — CommonMark alone, no extension, no
// smart punctuation, no heading ids — as the spec renders them.

import {markdown.parseWith, markdown.toHtml, markdown.commonmarkOptions};

fn same(source: string, expected: string) -> @Result<void, string> {
    val got = toHtml(parseWith(source, commonmarkOptions()));
    if (got != expected) throw "expected " + expected + " got " + got;
    return;
}

test "commonmark 253: List items" {
    try same(
        "A paragraph\nwith two lines.\n\n    indented code\n\n> A block quote.\n",
        "<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n",
    );
}

test "commonmark 254: List items" {
    try same(
        "1.  A paragraph\n    with two lines.\n\n        indented code\n\n    > A block quote.\n",
        "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<pre><code>indented code\n</code></pre>\n<blockquote>\n<p>A block quote.</p>\n</blockquote>\n</li>\n</ol>\n",
    );
}

test "commonmark 255: List items" {
    try same("- one\n\n two\n", "<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n");
}

test "commonmark 256: List items" {
    try same(
        "- one\n\n  two\n",
        "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n",
    );
}

test "commonmark 257: List items" {
    try same(
        " -    one\n\n     two\n",
        "<ul>\n<li>one</li>\n</ul>\n<pre><code> two\n</code></pre>\n",
    );
}

test "commonmark 258: List items" {
    try same(
        " -    one\n\n      two\n",
        "<ul>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ul>\n",
    );
}

test "commonmark 259: List items" {
    try same(
        "   > > 1.  one\n>>\n>>     two\n",
        "<blockquote>\n<blockquote>\n<ol>\n<li>\n<p>one</p>\n<p>two</p>\n</li>\n</ol>\n</blockquote>\n</blockquote>\n",
    );
}

test "commonmark 260: List items" {
    try same(
        ">>- one\n>>\n  >  > two\n",
        "<blockquote>\n<blockquote>\n<ul>\n<li>one</li>\n</ul>\n<p>two</p>\n</blockquote>\n</blockquote>\n",
    );
}

test "commonmark 261: List items" {
    try same("-one\n\n2.two\n", "<p>-one</p>\n<p>2.two</p>\n");
}

test "commonmark 262: List items" {
    try same(
        "- foo\n\n\n  bar\n",
        "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n",
    );
}

test "commonmark 263: List items" {
    try same(
        "1.  foo\n\n    ```\n    bar\n    ```\n\n    baz\n\n    > bam\n",
        "<ol>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n<blockquote>\n<p>bam</p>\n</blockquote>\n</li>\n</ol>\n",
    );
}

test "commonmark 264: List items" {
    try same(
        "- Foo\n\n      bar\n\n\n      baz\n",
        "<ul>\n<li>\n<p>Foo</p>\n<pre><code>bar\n\n\nbaz\n</code></pre>\n</li>\n</ul>\n",
    );
}

test "commonmark 265: List items" {
    try same(
        "123456789. ok\n",
        "<ol start=\"123456789\">\n<li>ok</li>\n</ol>\n",
    );
}

test "commonmark 266: List items" {
    try same("1234567890. not ok\n", "<p>1234567890. not ok</p>\n");
}

test "commonmark 267: List items" {
    try same("0. ok\n", "<ol start=\"0\">\n<li>ok</li>\n</ol>\n");
}

test "commonmark 268: List items" {
    try same("003. ok\n", "<ol start=\"3\">\n<li>ok</li>\n</ol>\n");
}

test "commonmark 269: List items" {
    try same("-1. not ok\n", "<p>-1. not ok</p>\n");
}

test "commonmark 270: List items" {
    try same(
        "- foo\n\n      bar\n",
        "<ul>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ul>\n",
    );
}

test "commonmark 271: List items" {
    try same(
        "  10.  foo\n\n           bar\n",
        "<ol start=\"10\">\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ol>\n",
    );
}

test "commonmark 272: List items" {
    try same(
        "    indented code\n\nparagraph\n\n    more code\n",
        "<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n",
    );
}

test "commonmark 273: List items" {
    try same(
        "1.     indented code\n\n   paragraph\n\n       more code\n",
        "<ol>\n<li>\n<pre><code>indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n</li>\n</ol>\n",
    );
}

test "commonmark 274: List items" {
    try same(
        "1.      indented code\n\n   paragraph\n\n       more code\n",
        "<ol>\n<li>\n<pre><code> indented code\n</code></pre>\n<p>paragraph</p>\n<pre><code>more code\n</code></pre>\n</li>\n</ol>\n",
    );
}

test "commonmark 275: List items" {
    try same("   foo\n\nbar\n", "<p>foo</p>\n<p>bar</p>\n");
}

test "commonmark 276: List items" {
    try same("-    foo\n\n  bar\n", "<ul>\n<li>foo</li>\n</ul>\n<p>bar</p>\n");
}

test "commonmark 277: List items" {
    try same(
        "-  foo\n\n   bar\n",
        "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n",
    );
}

test "commonmark 278: List items" {
    try same(
        "-\n  foo\n-\n  ```\n  bar\n  ```\n-\n      baz\n",
        "<ul>\n<li>foo</li>\n<li>\n<pre><code>bar\n</code></pre>\n</li>\n<li>\n<pre><code>baz\n</code></pre>\n</li>\n</ul>\n",
    );
}

test "commonmark 279: List items" {
    try same("-   \n  foo\n", "<ul>\n<li>foo</li>\n</ul>\n");
}

test "commonmark 280: List items" {
    try same("-\n\n  foo\n", "<ul>\n<li></li>\n</ul>\n<p>foo</p>\n");
}

test "commonmark 281: List items" {
    try same(
        "- foo\n-\n- bar\n",
