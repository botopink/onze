test "commonmark 283: List items" {
    try same(
        "1. foo\n2.\n3. bar\n",
        "<ol>\n<li>foo</li>\n<li></li>\n<li>bar</li>\n</ol>\n",
    );
}

test "commonmark 284: List items" {
    try same("*\n", "<ul>\n<li></li>\n</ul>\n");
}

test "commonmark 285: List items" {
    try same("foo\n*\n\nfoo\n1.\n", "<p>foo\n*</p>\n<p>foo\n1.</p>\n");
}

