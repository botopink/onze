//// onze-content/markdown — Markdown to an `MdNode` tree, HTML and `Element`
//// (front 121, steps 1–2).
////
//// `parse(text)` reads CommonMark 0.31.2 and the GitHub-flavoured
//// extensions — tables, strikethrough, task list items, extended autolinks,
//// footnotes and the tag filter — into an `MdDoc`. `toHtml(doc)` writes the
//// HTML the CommonMark reference renderer writes (the spec's examples are the
//// member's fixtures, `test/commonmark/`); `toElement(doc)` builds the same
//// tree as jhonstart's `Element`, raw HTML passing through `raw(…)` (the
//// author's own markup, as in a template); `headings(doc)` lists every heading
//// with its id. Heading ids follow GitHub's slug rule and are unique per
//// document (`conclusion`, `conclusion-1`). `MarkdownOptions` turns smart
//// punctuation, the extensions and the ids off; `commonmarkOptions()` is
//// CommonMark alone.
////
//// The parser is the reference implementation's two passes (commonmark.js):
//// blocks line by line — the open blocks are a stack, `P` the parser's state,
//// every step a new value of it, records being immutable — then inlines per
//// paragraph, heading and table cell, with the delimiter stack of § 6.2 run
//// over an array of pending items.

import {md_text.Chars, md_text.charsOf, md_text.charText, md_text.isSpaceOrTab, md_text.isUnicodeSpace, md_text.isAsciiPunct, md_text.isPunct, md_text.isDigit, md_text.isAsciiAlpha, md_text.isAsciiAlnum, md_text.escapeHtml, md_text.matchEntity, md_text.unescapeString, md_text.normalizeLabel, md_text.normalizeUri};
import {Element, text, fragment, el, voidEl, raw} from "jhonstart";

// ── the public surface ──────────────────────────────────────────────────────

// What a parse does beyond CommonMark. Every field on by default.
// `smartPunctuation`: straight quotes curled, `--` / `---` to dashes, `...` to
// an ellipsis. `gfm`: tables, strikethrough, task list items, extended
// autolinks, footnotes and the tag filter. `headingIds`: an `id` on every
// heading, GitHub's slug, unique per document.
pub type MarkdownOptions(
    smartPunctuation: bool = true,
    gfm: bool = true,
    headingIds: bool = true,
)

// CommonMark alone — the options the spec's examples are rendered with.
pub fn commonmarkOptions() -> MarkdownOptions {
    return MarkdownOptions(
        smartPunctuation: false,
        gfm: false,
        headingIds: false,
    );
}

// The GFM spec's examples: the extensions, no smart punctuation, no ids.
pub fn gfmOptions() -> MarkdownOptions {
    return MarkdownOptions(
        smartPunctuation: false,
        gfm: true,
        headingIds: false,
    );
}

// One node of a document. Blocks: `Heading` … `Cell`; inlines: `Text` …
// `FootnoteRef`. `Item.task` is `0` for an ordinary item, `1` for an
// unchecked task, `2` for a checked one. `Table.aligns` holds `""`, `left`,
// `center` or `right` per column.
pub type MdNode {
    Heading(depth: i32, id: string, kids: Array<MdNode>),
    Paragraph(kids: Array<MdNode>),
    Code(lang: string, text: string),
    Quote(kids: Array<MdNode>),
    List(ordered: bool, start: i32, tight: bool, items: Array<MdNode>),
    Item(task: i32, kids: Array<MdNode>),
    Rule,
    Html(text: string),
    Table(aligns: Array<string>, head: Array<MdNode>, rows: Array<MdNode>),
    Row(cells: Array<MdNode>),
    Cell(kids: Array<MdNode>),
    Text(value: string),
    SoftBreak,
    HardBreak,
    CodeSpan(text: string),
    Emph(kids: Array<MdNode>),
    Strong(kids: Array<MdNode>),
    Strike(kids: Array<MdNode>),
    Link(href: string, title: string, kids: Array<MdNode>),
    Image(src: string, alt: string, title: string),
    InlineHtml(text: string),
    FootnoteRef(label: string, index: i32, nth: i32),
}

// A footnote that is referenced: its definition's label, its number (the
// order of first reference), how many references it has, its blocks.
pub type Footnote(label: string, index: i32, refs: i32, kids: Array<MdNode>)

pub type MdDoc(nodes: Array<MdNode>, footnotes: Array<Footnote>)

// A heading as a table of contents reads it.
pub type Heading(depth: i32, slug: string, text: string)

pub fn parse(source: string) -> MdDoc {
    return parseWith(source, MarkdownOptions());
}

pub fn parseWith(source: string, options: MarkdownOptions) -> MdDoc {
    val doc = parseBlocks(source, options.gfm);
    val gathered = gatherDefinitions(doc.children, doc.refs, []);
    var ctx = Ctx(
        refs: gathered._0,
        notes: gathered._1,
        used: [],
        slugs: [],
        options: options,
    );
    val main = convertBlocks(doc.children, ctx);
    ctx = main._1;
    var footnotes: Footnote[] = [];
    var done = 0;
    while (done < ctx.used.length) {
        val usage = ctx.used.at(done) ?? NoteUse(
            norm: "",
            label: "",
            index: 0,
            count: 0,
        );
        val body = noteBody(ctx.notes, usage.norm);
        val converted = convertBlocks(body, ctx);
        ctx = converted._1;
        footnotes.push(
            Footnote(
                label: usage.label,
                index: usage.index,
                refs: 0,
                kids: converted._0,
            ),
        );
        done = done + 1;
    }
    val used = ctx.used;
    val counted = footnotes.map(
        { f -> Footnote(..f, refs: refsOf(used, f.index)) },
    );
    return MdDoc(nodes: main._0, footnotes: counted);
}

// ── blocks ──────────────────────────────────────────────────────────────────

type Kind {
    BDoc,
    BList,
    BQuote,
    BItem,
    BHeading,
    BRule,
    BCode,
    BHtml,
    BPara,
    BTable,
    BNote,
}

type ListData(
    ordered: bool,
    bullet: i32,
    start: i32,
    delim: i32,
    padding: i32,
    markerOffset: i32,
)

fn noList() -> ListData {
    return ListData(
        ordered: false,
        bullet: 0,
        start: 0,
        delim: 0,
        padding: 0,
        markerOffset: 0,
    );
}

// A block still open: its closed children and, for a block that takes
// lines, its lines.
type Open(
    kind: Kind,
    startLine: i32,
    children: Array<Blk> = [],
    lines: Array<string> = [],
    level: i32 = 0,
    fenced: bool = false,
    fenceChar: i32 = 0,
    fenceLength: i32 = 0,
    fenceOffset: i32 = 0,
    htmlType: i32 = 0,
    list: ListData = noList(),
    label: string = "",
)

// A closed block. `content`: a paragraph's or heading's raw text, a code
// block's or HTML block's literal. `rows`: a table's lines.
type Blk(
    kind: Kind,
    startLine: i32,
    endLine: i32,
    children: Array<Blk> = [],
    content: string = "",
    info: string = "",
    rows: Array<string> = [],
    level: i32 = 0,
    list: ListData = noList(),
    tight: bool = true,
    label: string = "",
)

type Ref(label: string, dest: string, title: string)

// The block parser's state for the line being read: the open blocks
// (`stack[0]` the document), the line, the position (`offset` in code
// points, `column` with tabs expanded to stops of four), the next non-space
// character and what it says (`indent`, `blank`), and what the container
// walk matched.
type P(
    stack: Array<Open>,
    line: Chars,
    lineNumber: i32,
    offset: i32,
    column: i32,
    nextNonspace: i32,
    nextNonspaceColumn: i32,
    indent: i32,
    indented: bool,
    blank: bool,
    partial: bool,
    allClosed: bool,
    lastMatched: i32,
    refs: Array<Ref>,
    gfm: bool,
)

type Parsed(children: Array<Blk>, refs: Array<Ref>)

fn emptyOpen() -> Open {
    return Open(kind: Kind.BDoc, startLine: 0);
}

fn parseBlocks(source: string, gfm: bool) -> Parsed {
    val normal = source.replaceAll("\r\n", "\n").replaceAll("\r", "\n");
    var lines = normal.split("\n");
    if (normal.endsWith("\n")) lines = lines.slice(0, lines.length - 1);
    var p = P(
        stack: [Open(kind: Kind.BDoc, startLine: 1)],
        line: charsOf(""),
        lineNumber: 0,
        offset: 0,
        column: 0,
        nextNonspace: 0,
        nextNonspaceColumn: 0,
        indent: 0,
        indented: false,
        blank: false,
        partial: false,
        allClosed: true,
        lastMatched: 0,
        refs: [],
        gfm: gfm,
    );
    for (lines) { ln ->
        p = incorporateLine(p, ln);
    }
    val total = lines.length;
    while (p.stack.length > 1) {
        p = finalizeTop(p, total);
    }
    val doc = openAt(p, 0);
    return Parsed(children: doc.children, refs: p.refs);
}

fn openAt(p: P, i: i32) -> Open {
    return p.stack.at(i) ?? emptyOpen();
}

fn topOf(p: P) -> Open {
    return openAt(p, p.stack.length - 1);
}

fn kindAt(p: P, i: i32) -> Kind {
    return openAt(p, i).kind;
}

fn setTop(p: P, o: Open) -> P {
    return P(..p, stack: p.stack.slice(0, p.stack.length - 1).append([o]));
}

fn peekAt(p: P, i: i32) -> i32 {
    return p.line.at(i);
}

fn findNextNonspace(p: P) -> P {
    var i = p.offset;
    var cols = p.column;
    var c = p.line.at(i);
    while (c == 32 || c == 9) {
        if (c == 32) cols = cols + 1 else cols = cols + (4 - cols % 4);
        i = i + 1;
        c = p.line.at(i);
    }
    val indent = cols - p.column;
    return P(
        ..p,
        blank: c == -1,
        nextNonspace: i,
        nextNonspaceColumn: cols,
        indent: indent,
        indented: indent >= 4,
    );
}

fn advanceOffset(p: P, count0: i32, columns: bool) -> P {
    var count = count0;
    var offset = p.offset;
    var column = p.column;
    var partial = p.partial;
    var c = p.line.at(offset);
    while (count > 0 && c != -1) {
        if (c == 9) {
            val toTab = 4 - column % 4;
            if (columns) {
                partial = toTab > count;
                val step = if (toTab > count) count else toTab;
                column = column + step;
                if (!partial) offset = offset + 1;
                count = count - step;
            } else {
                partial = false;
                column = column + toTab;
                offset = offset + 1;
                count = count - 1;
            }
        } else {
            partial = false;
            offset = offset + 1;
            column = column + 1;
            count = count - 1;
        }
        c = p.line.at(offset);
    }
    return P(..p, offset: offset, column: column, partial: partial);
}

fn advanceNextNonspace(p: P) -> P {
    return P(
        ..p,
        offset: p.nextNonspace,
        column: p.nextNonspaceColumn,
        partial: false,
    );
}

fn toLineEnd(p: P) -> P {
    return advanceOffset(p, p.line.size - p.offset, false);
}

// The rest of the line from `offset`, a partly consumed tab as its spaces.
fn addLine(p0: P) -> P {
    var p = p0;
    var prefix = "";
    if (p0.partial) {
        p = P(..p0, offset: p0.offset + 1);
        prefix = " ".repeat(4 - p0.column % 4);
    }
    val top = topOf(p);
    val content = prefix + p.line.text(p.offset, p.line.size);
    return setTop(p, Open(..top, lines: top.lines.append([content])));
}

fn contentOf(lines: Array<string>) -> string {
    return lines.map({ l -> l + "\n" }).join("");
}

fn linesOf(content: string) -> Array<string> {
    if (content == "") return [];
    val body = if (content.endsWith("\n"))
        content.slice(0, content.length - 1)
    else
        content;
    return [body];
}

fn canContain(parent: Kind, child: Kind) -> bool {
    return case parent {
        BDoc | BQuote | BItem | BNote -> child != Kind.BItem;
        BList -> child == Kind.BItem;
        _ -> false;
    };
}

fn acceptsLines(k: Kind) -> bool {
    return k == Kind.BCode || k == Kind.BHtml || k == Kind.BPara;
}

// Close the top block at `lineNumber` and hand it to its parent.
fn finalizeTop(p: P, lineNumber: i32) -> P {
    val n = p.stack.length;
    val top = openAt(p, n - 1);
    val parent = openAt(p, n - 2);
    val blk = closeBlock(top, lineNumber);
    val grown = Open(..parent, children: parent.children.append([blk]));
    return P(..p, stack: p.stack.slice(0, n - 2).append([grown]));
}

fn closeBlock(o: Open, lineNumber: i32) -> Blk {
    val base = Blk(
        kind: o.kind,
        startLine: o.startLine,
        endLine: lineNumber,
        children: o.children,
        level: o.level,
        list: o.list,
        label: o.label,
    );
    return case o.kind {
        BPara | BHeading -> Blk(..base, content: contentOf(o.lines));
        BHtml -> Blk(..base, content: o.lines.join("\n"));
        BTable -> Blk(..base, rows: o.lines);
        BCode -> closeCode(o, base);
        BList -> closeList(base);
        BItem -> closeItem(base);
        _ -> base;
    };
}

fn closeCode(o: Open, base: Blk) -> Blk {
    if (o.fenced) {
        val first = o.lines.at(0) ?? "";
        val rest = o.lines.slice(1, o.lines.length);
        return Blk(
            ..base,
            info: unescapeString(first.trim()),
            content: contentOf(rest),
        );
    }
    var n = o.lines.length;
    while (n > 0 && isBlankText(o.lines.at(n - 1) ?? "")) {
        n = n - 1;
    }
    val kept = o.lines.slice(0, n);
    return Blk(
        ..base,
        content: kept.join("\n") + "\n",
        endLine: base.startLine + n - 1,
    );
}

fn isBlankText(s: string) -> bool {
    val c = charsOf(s);
    var i = 0;
    while (i < c.size && isSpaceOrTab(c.at(i))) {
        i = i + 1;
    }
    return i == c.size;
}

fn endsWithBlankLine(a: Blk, b: Blk) -> bool {
    return a.endLine != b.startLine - 1;
}

fn closeList(base: Blk) -> Blk {
    var tight = true;
    val items = base.children;
    var i = 0;
    while (tight && i < items.length) {
        val item = items.at(i) ?? base;
        val next = items.at(i + 1);
        if (next) {
            n ->
            if (endsWithBlankLine(item, n)) tight = false;
        }
        var j = 0;
        while (tight && j + 1 < item.children.length) {
            val a = item.children.at(j) ?? base;
            val b = item.children.at(j + 1) ?? base;
            if (endsWithBlankLine(a, b)) tight = false;
            j = j + 1;
        }
        i = i + 1;
    }
    val last = items.at(items.length - 1) ?? base;
    return Blk(..base, tight: tight, endLine: last.endLine);
}

fn closeItem(base: Blk) -> Blk {
    if (base.children.length == 0) return Blk(..base, endLine: base.startLine);
    val last = base.children.at(base.children.length - 1) ?? base;
    return Blk(..base, endLine: last.endLine);
}

fn closeUnmatched(p0: P) -> P {
    if (p0.allClosed) return p0;
    var p = p0;
    while (p.stack.length - 1 > p.lastMatched) {
        p = finalizeTop(p, p.lineNumber - 1);
    }
    return P(..p, allClosed: true);
}

fn addChild(p0: P, child: Open) -> P {
    var p = p0;
    while (!canContain(topOf(p).kind, child.kind)) {
        p = finalizeTop(p, p.lineNumber - 1);
    }
    return P(
        ..p,
        stack: p.stack.append([Open(..child, startLine: p.lineNumber)]),
    );
}

fn incorporateLine(p0: P, ln: string) -> P {
    val clean = if (ln.contains("\u{0}"))
        ln.replaceAll("\u{0}", "\u{FFFD}")
    else
        ln;
    var p = P(
        ..p0,
        line: charsOf(clean),
        lineNumber: p0.lineNumber + 1,
        offset: 0,
        column: 0,
        blank: false,
        partial: false,
    );
    val oldtip = p.stack.length - 1;
    var container = 0;
    var walking = true;
    var finished = false;
    while (walking && container < oldtip) {
        p = findNextNonspace(p);
        val r = continueBlock(p, container + 1);
        p = r._0;
        if (r._1 == 0) container = container + 1 else if (r._1 == 2) {
            finished = true;
            walking = false;
        } else walking = false;
    }
    if (finished) return p;
    p = P(..p, allClosed: container == oldtip, lastMatched: container);
    val ck = kindAt(p, container);
    var matchedLeaf = ck == Kind.BCode || ck == Kind.BHtml;
    var searching = !matchedLeaf;
    var consumed = false;
    while (searching) {
        p = findNextNonspace(p);
        val special = maybeSpecial(peekAt(p, p.nextNonspace), p.gfm);
        if (!p.indented && !special) {
            p = advanceNextNonspace(p);
            searching = false;
        } else {
            val r = blockStart(p, container);
            p = r._0;
            if (r._1 == 0) {
                p = advanceNextNonspace(p);
                searching = false;
            } else if (r._1 == 3) {
                consumed = true;
                searching = false;
            } else {
                container = p.stack.length - 1;
                if (r._1 == 2) {
                    matchedLeaf = true;
                    searching = false;
                }
            }
        }
    }
    if (consumed) return p;
    val tipKind = topOf(p).kind;
    if (!p.allClosed && !p.blank && tipKind == Kind.BPara) return addLine(p);
    return addText(closeUnmatched(p), container);
}

// What is left of the line once the containers are matched: a line of the
// leaf block, a table row, or a new paragraph.
fn addText(p0: P, container: i32) -> P {
    var p = p0;
    val kind = kindAt(p, container);
    if (acceptsLines(kind)) {
        p = addLine(p);
        val html = openAt(p, container);
        val ended = kind == Kind.BHtml
            && html.htmlType >= 1
            && html.htmlType <= 5
            && htmlBlockEnds(html.htmlType, p.line.text(p.offset, p.line.size));
        if (ended) p = finalizeTop(p, p.lineNumber);
        return p;
    }
    if (kind == Kind.BTable) {
        if (p.blank) return p;
        val top = topOf(p);
        val row = p.line.text(p.offset, p.line.size);
        p = setTop(p, Open(..top, lines: top.lines.append([row])));
        return p;
    }
    if (p.offset < p.line.size && !p.blank) {
        p = addChild(p, Open(kind: Kind.BPara, startLine: 0));
        return addLine(advanceNextNonspace(p));
    }
    return p;
}

// `[#`~*+_=<>0-9-]` — a character that may begin a block; with the
// extensions also `|`, `:` (a table's delimiter row) and `[` (a footnote).
fn maybeSpecial(c: i32, gfm: bool) -> bool {
    if (c == 35 || c == 96 || c == 126 || c == 42 || c == 43 || c == 95)
        return true;
    if (c == 61 || c == 60 || c == 62 || c == 45 || isDigit(c)) return true;
    return gfm && (c == 124 || c == 58 || c == 91);
}

// Whether the open block at depth `d` goes on: `0` it does, `1` it does not,
// `2` the line closed it and is spent (a closing code fence).
fn continueBlock(p: P, d: i32) -> #(P, i32) {
    val o = openAt(p, d);
    return case o.kind {
        BList -> #(p, 0);
        BQuote -> continueQuote(p);
        BItem -> continueItem(p, d, o);
        BCode -> continueCode(p, o);
        BHtml -> #(
            p,
            if (p.blank && (o.htmlType == 6 || o.htmlType == 7)) 1 else 0,
        );
        BPara | BTable -> #(p, if (p.blank) 1 else 0);
        BNote -> continueNote(p);
        _ -> #(p, 1);
    };
}

fn continueQuote(p: P) -> #(P, i32) {
    if (p.indented || peekAt(p, p.nextNonspace) != 62) return #(p, 1);
    var q = advanceOffset(advanceNextNonspace(p), 1, false);
    if (isSpaceOrTab(peekAt(q, q.offset))) q = advanceOffset(q, 1, true);
    return #(q, 0);
}

fn continueItem(p: P, d: i32, o: Open) -> #(P, i32) {
    if (p.blank) {
        val empty = o.children.length == 0 && p.stack.length - 1 == d;
        if (empty) return #(p, 1);
        return #(advanceNextNonspace(p), 0);
    }
    val width = o.list.markerOffset + o.list.padding;
    if (p.indent >= width) return #(advanceOffset(p, width, true), 0);
    return #(p, 1);
}

fn continueNote(p: P) -> #(P, i32) {
    if (p.indent >= 4) return #(advanceOffset(p, 4, true), 0);
    if (p.blank) return #(p, 0);
    return #(p, 1);
}

fn continueCode(p: P, o: Open) -> #(P, i32) {
    if (o.fenced) {
        val run = runLength(p.line, p.nextNonspace, o.fenceChar);
        val closes = p.indent <= 3
            && run >= 3
            && run >= o.fenceLength
            && restIsSpace(p.line, p.nextNonspace + run);
        if (closes) return #(finalizeTop(p, p.lineNumber), 2);
        var q = p;
        var i = o.fenceOffset;
        while (i > 0 && isSpaceOrTab(peekAt(q, q.offset))) {
            q = advanceOffset(q, 1, true);
            i = i - 1;
        }
        return #(q, 0);
    }
    if (p.indent >= 4) return #(advanceOffset(p, 4, true), 0);
    if (p.blank) return #(advanceNextNonspace(p), 0);
    return #(p, 1);
}

fn runLength(c: Chars, begin: i32, ch: i32) -> i32 {
    var i = begin;
    while (c.at(i) == ch) {
        i = i + 1;
    }
    return i - begin;
}

fn restIsSpace(c: Chars, begin: i32) -> bool {
    var i = begin;
    while (isSpaceOrTab(c.at(i))) {
        i = i + 1;
    }
    return c.at(i) == -1;
}

// The block starts in the reference order: `0` none, `1` a container opened,
// `2` a leaf opened, `3` a leaf opened that spent the line (a table).
fn blockStart(p: P, container: i32) -> #(P, i32) {
    val ck = kindAt(p, container);
    val quote = startQuote(p);
    if (quote._1 != 0) return quote;
    val atx = startAtx(p);
    if (atx._1 != 0) return atx;
    val fence = startFence(p);
    if (fence._1 != 0) return fence;
    val html = startHtml(p, ck);
    if (html._1 != 0) return html;
    val setext = startSetext(p, ck);
    if (setext._1 != 0) return setext;
    val rule = startRule(p);
    if (rule._1 != 0) return rule;
    if (p.gfm) {
        val note = startNote(p);
        if (note._1 != 0) return note;
    }
    val item = startItem(p, ck);
    if (item._1 != 0) return item;
    val code = startIndentedCode(p);
    if (code._1 != 0) return code;
    if (p.gfm) return startTable(p, container);
    return #(p, 0);
}

fn startQuote(p: P) -> #(P, i32) {
    if (p.indented || peekAt(p, p.nextNonspace) != 62) return #(p, 0);
    var q = advanceOffset(advanceNextNonspace(p), 1, false);
    if (isSpaceOrTab(peekAt(q, q.offset))) q = advanceOffset(q, 1, true);
    q = closeUnmatched(q);
    return #(addChild(q, Open(kind: Kind.BQuote, startLine: 0)), 1);
}

fn startAtx(p: P) -> #(P, i32) {
    if (p.indented) return #(p, 0);
    val level = runLength(p.line, p.nextNonspace, 35);
    if (level < 1 || level > 6) return #(p, 0);
    val after = p.nextNonspace + level;
    val c = peekAt(p, after);
    if (c != -1 && !isSpaceOrTab(c)) return #(p, 0);
    var spaces = 0;
    while (isSpaceOrTab(peekAt(p, after + spaces))) {
        spaces = spaces + 1;
    }
    var q = advanceOffset(advanceNextNonspace(p), level + spaces, false);
    q = closeUnmatched(q);
    val title = atxContent(q.line, q.offset);
    q = addChild(
        q,
        Open(kind: Kind.BHeading, startLine: 0, level: level, lines: [title]),
    );
    return #(toLineEnd(q), 2);
}

// The heading's text with its closing sequence removed: `#`s at the end
// preceded by a space or tab (or the whole rest), trailing spaces with them.
fn atxContent(c: Chars, begin: i32) -> string {
    var end = c.size;
    while (end > begin && isSpaceOrTab(c.at(end - 1))) {
        end = end - 1;
    }
    var hashes = end;
    while (hashes > begin && c.at(hashes - 1) == 35) {
        hashes = hashes - 1;
    }
    if (hashes == end) return c.text(begin, c.size);
    if (hashes == begin) return "";
    if (!isSpaceOrTab(c.at(hashes - 1))) return c.text(begin, c.size);
    var cut = hashes;
    while (cut > begin && isSpaceOrTab(c.at(cut - 1))) {
        cut = cut - 1;
    }
    return c.text(begin, cut);
}

fn startFence(p: P) -> #(P, i32) {
    if (p.indented) return #(p, 0);
    val ch = peekAt(p, p.nextNonspace);
    if (ch != 96 && ch != 126) return #(p, 0);
    val n = runLength(p.line, p.nextNonspace, ch);
    if (n < 3) return #(p, 0);
    if (ch == 96) {
        var i = p.nextNonspace + n;
        while (i < p.line.size) {
            if (p.line.at(i) == 96) return #(p, 0);
            i = i + 1;
        }
    }
    var q = closeUnmatched(p);
    q = addChild(
        q,
        Open(
            kind: Kind.BCode,
            startLine: 0,
            fenced: true,
            fenceChar: ch,
            fenceLength: n,
            fenceOffset: p.indent,
        ),
    );
    q = advanceOffset(advanceNextNonspace(q), n, false);
    return #(q, 2);
}

fn startHtml(p: P, ck: Kind) -> #(P, i32) {
    if (p.indented || peekAt(p, p.nextNonspace) != 60) return #(p, 0);
    val t = htmlBlockStart(p.line, p.nextNonspace);
    if (t == 0) return #(p, 0);
    val maybeLazy = !p.allClosed && !p.blank && topOf(p).kind == Kind.BPara;
    if (t == 7 && (ck == Kind.BPara || maybeLazy)) return #(p, 0);
    val q = closeUnmatched(p);
    return #(addChild(q, Open(kind: Kind.BHtml, startLine: 0, htmlType: t)), 2);
}

fn startSetext(p: P, ck: Kind) -> #(P, i32) {
    if (p.indented || ck != Kind.BPara) return #(p, 0);
    val ch = peekAt(p, p.nextNonspace);
    if (ch != 61 && ch != 45) return #(p, 0);
    val n = runLength(p.line, p.nextNonspace, ch);
    if (!restIsSpace(p.line, p.nextNonspace + n)) return #(p, 0);
    var q = closeUnmatched(p);
    val para = topOf(q);
    var content = contentOf(para.lines);
    var refs = q.refs;
    var reading = true;
    while (reading && content.startsWith("[")) {
        val r = parseReference(content, refs);
        if (r._0 == 0) reading = false else {
            content = charsOf(content).text(r._0, 2147483647);
            refs = r._1;
        }
    }
    q = P(..q, refs: refs);
    if (content == "") return #(setTop(q, Open(..para, lines: [])), 0);
    val level = if (ch == 61) 1 else 2;
    val heading = Open(
        kind: Kind.BHeading,
        startLine: para.startLine,
        level: level,
        lines: linesOf(content),
    );
    return #(toLineEnd(setTop(q, heading)), 2);
}

fn startRule(p: P) -> #(P, i32) {
    if (p.indented) return #(p, 0);
    val ch = peekAt(p, p.nextNonspace);
    if (ch != 42 && ch != 95 && ch != 45) return #(p, 0);
    var i = p.nextNonspace;
    var count = 0;
    var ok = true;
    while (ok && i < p.line.size) {
        val c = p.line.at(i);
        if (c == ch) count = count + 1 else if (!isSpaceOrTab(c)) ok = false;
        i = i + 1;
    }
    if (!ok || count < 3) return #(p, 0);
    val q = closeUnmatched(p);
    return #(toLineEnd(addChild(q, Open(kind: Kind.BRule, startLine: 0))), 2);
}

// `[^label]:` and the spaces after it — a footnote definition (GFM).
fn startNote(p: P) -> #(P, i32) {
    if (p.indented) return #(p, 0);
    val s = p.nextNonspace;
    if (peekAt(p, s) != 91 || peekAt(p, s + 1) != 94) return #(p, 0);
    var i = s + 2;
    var going = true;
    while (going) {
        val c = peekAt(p, i);
        val stop = c == -1 || c == 93 || c == 32 || c == 9 || c == 0;
        if (stop) going = false else i = i + 1;
    }
    if (i == s + 2 || peekAt(p, i) != 93 || peekAt(p, i + 1) != 58)
        return #(p, 0);
    val label = p.line.text(s + 2, i);
    var end = i + 2;
    while (isSpaceOrTab(peekAt(p, end))) {
        end = end + 1;
    }
    var q = closeUnmatched(p);
    q = addChild(q, Open(kind: Kind.BNote, startLine: 0, label: label));
    q = advanceOffset(advanceNextNonspace(q), end - s, false);
    return #(q, 1);
}

fn startItem(p: P, ck: Kind) -> #(P, i32) {
    if (p.indented && ck != Kind.BList) return #(p, 0);
    if (p.indent >= 4) return #(p, 0);
    val s = p.nextNonspace;
    val c = peekAt(p, s);
    var markLen = 0;
    var ordered = false;
    var start = 0;
    var delim = 0;
    if (c == 42 || c == 43 || c == 45) markLen = 1 else {
        var i = s;
        var value = 0;
        while (isDigit(peekAt(p, i)) && i - s < 9) {
            value = value * 10 + (peekAt(p, i) - 48);
            i = i + 1;
        }
        val d = peekAt(p, i);
        val digits = i - s;
        val marker = digits >= 1
            && (d == 46 || d == 41)
            && (ck != Kind.BPara || value == 1);
        if (!marker) return #(p, 0);
        ordered = true;
        start = value;
        delim = d;
        markLen = digits + 1;
    }
    val nextc = peekAt(p, s + markLen);
    if (nextc != -1 && !isSpaceOrTab(nextc)) return #(p, 0);
    if (ck == Kind.BPara && restIsSpace(p.line, s + markLen)) return #(p, 0);
    var q = advanceOffset(advanceNextNonspace(p), markLen, true);
    val spacesStartCol = q.column;
    val spacesStartOffset = q.offset;
    var going = true;
    while (going) {
        q = advanceOffset(q, 1, true);
        going = q.column - spacesStartCol < 5
            && isSpaceOrTab(peekAt(q, q.offset));
    }
    val blankItem = peekAt(q, q.offset) == -1;
    val spacesAfter = q.column - spacesStartCol;
    var padding = markLen + spacesAfter;
    if (spacesAfter >= 5 || spacesAfter < 1 || blankItem) {
        padding = markLen + 1;
        q = P(..q, column: spacesStartCol, offset: spacesStartOffset);
        if (isSpaceOrTab(peekAt(q, q.offset))) q = advanceOffset(q, 1, true);
    }
    val data = ListData(
        ordered: ordered,
        bullet: if (ordered) 0 else c,
        start: start,
        delim: delim,
        padding: padding,
        markerOffset: p.indent,
    );
    q = closeUnmatched(q);
    val top = topOf(q);
    val sameList = top.kind == Kind.BList
        && top.list.ordered == data.ordered
        && top.list.delim == data.delim
        && top.list.bullet == data.bullet;
    if (!sameList)
        q = addChild(q, Open(kind: Kind.BList, startLine: 0, list: data));
    return #(addChild(q, Open(kind: Kind.BItem, startLine: 0, list: data)), 1);
}

fn startIndentedCode(p: P) -> #(P, i32) {
    val ok = p.indented && topOf(p).kind != Kind.BPara && !p.blank;
    if (!ok) return #(p, 0);
    var q = advanceOffset(p, 4, true);
    q = closeUnmatched(q);
    return #(addChild(q, Open(kind: Kind.BCode, startLine: 0)), 2);
}

// A delimiter row under a paragraph whose last line has as many cells: the
// paragraph's earlier lines stay a paragraph, the last line is the header.
fn startTable(p: P, container: i32) -> #(P, i32) {
    val top = topOf(p);
    val ok = !p.indented
        && kindAt(p, container) == Kind.BPara
        && container == p.stack.length - 1;
    if (!ok) return #(p, 0);
    val delimiter = p.line.text(p.nextNonspace, p.line.size);
    val aligns = delimiterRow(delimiter);
    if (aligns.length == 0) return #(p, 0);
    val header = top.lines.at(top.lines.length - 1) ?? "";
    if (splitRow(header).length != aligns.length) return #(p, 0);
    val before = top.lines.slice(0, top.lines.length - 1);
    var q = closeUnmatched(p);
    if (before.length == 0)
        q = P(..q, stack: q.stack.slice(0, q.stack.length - 1))
    else {
        q = setTop(q, Open(..top, lines: before));
        q = finalizeTop(q, q.lineNumber - 1);
    }
    val table = Open(
        kind: Kind.BTable,
        startLine: q.lineNumber - 1,
        lines: [header, delimiter],
    );
    q = P(..q, stack: q.stack.append([table]));
    return #(toLineEnd(q), 3);
}

// The alignments of a delimiter row (`| :-- | :-: | --: |`), `[]` when the
// text is none.
fn delimiterRow(s: string) -> Array<string> {
    val cells = splitRow(s);
    var out: string[] = [];
    var ok = cells.length > 0;
    for (cells) { cell ->
        val c = charsOf(cell);
        val left = c.at(0) == 58;
        val right = c.size > 0 && c.at(c.size - 1) == 58;
        val begin = if (left) 1 else 0;
        val to = if (right && c.size > begin) c.size - 1 else c.size;
        var i = begin;
        while (i < to && c.at(i) == 45) {
            i = i + 1;
        }
        if (i != to || to == begin) ok = false;
        val align = if (left && right)
            "center"
        else if (right)
            "right"
        else if (left)
            "left"
        else
            "";
        out.push(align);
    }
    if (!ok) return [];
    return out;
}

// A table row's cells, trimmed: split at every `|` not escaped by a
// backslash, a leading and a trailing pipe dropped, `\|` kept for the inline
// pass to unescape.
fn splitRow(s: string) -> Array<string> {
    val c = charsOf(s.trim());
    var cells: string[] = [];
    var start = 0;
    var i = 0;
    if (c.at(0) == 124) {
        start = 1;
        i = 1;
    }
    while (i < c.size) {
        val ch = c.at(i);
        if (ch == 92) i = i + 2 else if (ch == 124) {
            cells.push(c.text(start, i).trim());
            start = i + 1;
            i = i + 1;
        } else i = i + 1;
    }
    if (start < c.size) cells.push(c.text(start, c.size).trim());
    return cells;
}

// ── HTML block conditions (§ 4.6) ───────────────────────────────────────────

fn lowerAscii(c: i32) -> i32 {
    return if (c >= 65 && c <= 90) c + 32 else c;
}

// Whether `word` (lower-case ASCII) is at `begin`, any case.
fn wordAt(c: Chars, begin: i32, word: string) -> bool {
    val w = charsOf(word);
    var i = 0;
    while (i < w.size) {
        if (lowerAscii(c.at(begin + i)) != w.at(i)) return false;
        i = i + 1;
    }
    return true;
}

fn tagNameEnd(c: Chars, begin: i32) -> i32 {
    if (!isAsciiAlpha(c.at(begin))) return begin;
    var i = begin + 1;
    while (isAsciiAlnum(c.at(i)) || c.at(i) == 45) {
        i = i + 1;
    }
    return i;
}

fn isHtmlSpace(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13;
}

val rawTags = ["script", "pre", "textarea", "style"];

val blockTags = [
    "address",
    "article",
    "aside",
    "base",
    "basefont",
    "blockquote",
    "body",
    "caption",
    "center",
    "col",
    "colgroup",
    "dd",
    "details",
    "dialog",
    "dir",
    "div",
    "dl",
    "dt",
    "fieldset",
    "figcaption",
    "figure",
    "footer",
    "form",
    "frame",
    "frameset",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "head",
    "header",
    "hr",
    "html",
    "iframe",
    "legend",
    "li",
    "link",
    "main",
    "menu",
    "menuitem",
    "nav",
    "noframes",
    "ol",
    "optgroup",
    "option",
    "p",
    "param",
    "search",
    "section",
    "summary",
    "table",
    "tbody",
    "td",
    "tfoot",
    "th",
    "thead",
    "title",
    "tr",
    "track",
    "ul",
];

// The kind (1–7) of the HTML block the line opens at `s` (its `<`), `0`
// for none.
fn htmlBlockStart(c: Chars, s: i32) -> i32 {
    val c1 = c.at(s + 1);
    if (c1 == 33) {
        if (c.at(s + 2) == 45 && c.at(s + 3) == 45) return 2;
        if (isAsciiAlpha(c.at(s + 2))) return 4;
        if (wordAt(c, s + 2, "[cdata[")) {
            val upper = c.text(s + 3, s + 8) == "CDATA";
            if (upper) return 5;
        }
        return 0;
    }
    if (c1 == 63) return 3;
    val close = c1 == 47;
    val nameAt = if (close) s + 2 else s + 1;
    val end = tagNameEnd(c, nameAt);
    if (end > nameAt) {
        val name = c.text(nameAt, end).toLower();
        val after = c.at(end);
        if (!close && rawTags.contains(name))
            if (after == -1 || after == 62 || isHtmlSpace(after)) return 1;
        if (blockTags.contains(name)) {
            val ends = after == -1
                || isHtmlSpace(after)
                || after == 62
                || (after == 47 && c.at(end + 1) == 62);
            if (ends) return 6;
        }
    }
    val tagEnd = if (close) matchCloseTag(c, s) else matchOpenTag(c, s);
    if (tagEnd > 0) {
        var i = tagEnd;
        while (isHtmlSpace(c.at(i))) {
            i = i + 1;
        }
        if (c.at(i) == -1) return 7;
    }
    return 0;
}

fn htmlBlockEnds(kind: i32, line: string) -> bool {
    if (kind == 1) {
        val low = line.toLower();
        return low.contains("</script>")
            || low.contains("</pre>")
            || low.contains("</textarea>")
            || low.contains("</style>");
    }
    if (kind == 2) return line.contains("-->");
    if (kind == 3) return line.contains("?>");
    if (kind == 4) return line.contains(">");
    return line.contains("]]>");
}

// ── raw HTML (§ 6.6) ────────────────────────────────────────────────────────

fn skipHtmlSpace(c: Chars, begin: i32) -> i32 {
    var i = begin;
    while (isHtmlSpace(c.at(i))) {
        i = i + 1;
    }
    return i;
}

fn isAttrNameStart(c: i32) -> bool {
    return isAsciiAlpha(c) || c == 95 || c == 58;
}

fn isAttrNameChar(c: i32) -> bool {
    return isAsciiAlnum(c) || c == 95 || c == 58 || c == 46 || c == 45;
}

// The end of an attribute value at `begin`, `-1` for none.
fn attrValueEnd(c: Chars, begin: i32) -> i32 {
    val q = c.at(begin);
    if (q == 39 || q == 34) {
        var i = begin + 1;
        while (c.at(i) != q) {
            if (c.at(i) == -1) return -1;
            i = i + 1;
        }
        return i + 1;
    }
    var i = begin;
    var going = true;
    while (going) {
        val ch = c.at(i);
        val stop = ch == -1
            || ch <= 32
            || ch == 34
            || ch == 39
            || ch == 61
            || ch == 60
            || ch == 62
            || ch == 96;
        if (stop) going = false else i = i + 1;
    }
    if (i == begin) return -1;
    return i;
}

// An open tag at `s` (its `<`): the index after its `>`, `-1` for none.
fn matchOpenTag(c: Chars, s: i32) -> i32 {
    val nameEnd = tagNameEnd(c, s + 1);
    if (nameEnd == s + 1) return -1;
    var i = nameEnd;
    var going = true;
    while (going) {
        val ws = skipHtmlSpace(c, i);
        if (ws == i || !isAttrNameStart(c.at(ws))) going = false else {
            var j = ws + 1;
            while (isAttrNameChar(c.at(j))) {
                j = j + 1;
            }
            i = j;
            val eq = skipHtmlSpace(c, j);
            if (c.at(eq) == 61) {
                val valueAt = skipHtmlSpace(c, eq + 1);
                val end = attrValueEnd(c, valueAt);
                if (end > 0) i = end;
            }
        }
    }
    var k = skipHtmlSpace(c, i);
    if (c.at(k) == 47) k = k + 1;
    if (c.at(k) != 62) return -1;
    return k + 1;
}

fn matchCloseTag(c: Chars, s: i32) -> i32 {
    if (c.at(s + 1) != 47) return -1;
    val nameEnd = tagNameEnd(c, s + 2);
    if (nameEnd == s + 2) return -1;
    val k = skipHtmlSpace(c, nameEnd);
    if (c.at(k) != 62) return -1;
    return k + 1;
}

// The index after `close`, searching from `begin`; `-1` when absent.
fn findText(c: Chars, begin: i32, close: string) -> i32 {
    val w = charsOf(close);
    var i = begin;
    while (i + w.size <= c.size) {
        var k = 0;
        while (k < w.size && c.at(i + k) == w.at(k)) {
            k = k + 1;
        }
        if (k == w.size) return i + w.size;
        i = i + 1;
    }
    return -1;
}

// Any raw HTML at `s`: open or closing tag, comment, processing
// instruction, declaration, CDATA section. The index after it, or `-1`.
fn matchHtmlTag(c: Chars, s: i32) -> i32 {
    val c1 = c.at(s + 1);
    if (c1 == 47) return matchCloseTag(c, s);
    if (c1 == 63) return findText(c, s + 2, "?>");
    if (c1 == 33) {
        if (c.at(s + 2) == 45 && c.at(s + 3) == 45) {
            if (c.at(s + 4) == 62) return s + 5;
            if (c.at(s + 4) == 45 && c.at(s + 5) == 62) return s + 6;
            return findText(c, s + 4, "-->");
        }
        if (c.text(s + 2, s + 9) == "[CDATA[") return findText(c, s + 9, "]]>");
        if (isAsciiAlpha(c.at(s + 2))) {
            var i = s + 3;
            while (isAsciiAlpha(c.at(i))) {
                i = i + 1;
            }
            val end = findText(c, i, ">");
            return end;
        }
        return -1;
    }
    return matchOpenTag(c, s);
}

// ── link syntax: labels, destinations, titles, definitions (§ 4.7, § 6.3) ──

// A link label at `pos` (its `[`): its length with both brackets, `0` for
// none (more than 999 characters inside is none).
fn linkLabelLength(c: Chars, pos: i32) -> i32 {
    if (c.at(pos) != 91) return 0;
    var i = pos + 1;
    while (i - pos <= 1000) {
        val ch = c.at(i);
        if (ch == -1 || ch == 91) return 0;
        if (ch == 93) return i + 1 - pos;
        if (ch == 92 && c.at(i + 1) != -1) i = i + 2 else i = i + 1;
    }
    return 0;
}

// Spaces, at most one line ending, spaces.
fn spnl(c: Chars, pos: i32) -> i32 {
    var i = pos;
    while (c.at(i) == 32) {
        i = i + 1;
    }
    if (c.at(i) == 10) {
        i = i + 1;
        while (c.at(i) == 32) {
            i = i + 1;
        }
    }
    return i;
}

fn isWs(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13;
}

// A link destination at `pos`: `#(next, destination)`, `next == -1` for none.
fn linkDestination(c: Chars, pos: i32) -> #(i32, string) {
    if (c.at(pos) == 60) {
        var i = pos + 1;
        while (true) {
            val ch = c.at(i);
            if (ch == 62)
                return #(
                    i + 1,
                    normalizeUri(unescapeString(c.text(pos + 1, i))),
                );
            if (ch == -1 || ch == 10 || ch == 60) return #(-1, "");
            if (ch == 92 && c.at(i + 1) != -1 && c.at(i + 1) != 10)
                i = i + 2
            else
                i = i + 1;
        }
    }
    var i = pos;
    var parens = 0;
    var going = true;
    var last = -1;
    while (going) {
        val ch = c.at(i);
        last = ch;
        if (ch == -1)
            going = false
        else if (ch == 92 && isAsciiPunct(c.at(i + 1)))
            i = i + 2
        else if (ch == 40) {
            parens = parens + 1;
            i = i + 1;
        } else if (ch == 41) {
            if (parens < 1) going = false else {
                parens = parens - 1;
                i = i + 1;
            }
        } else if (isWs(ch)) going = false else i = i + 1;
    }
    if (i == pos && last != 41) return #(-1, "");
    if (parens != 0) return #(-1, "");
    return #(i, normalizeUri(unescapeString(c.text(pos, i))));
}

// A link title at `pos`: `#(next, title)`, `next == -1` for none.
fn linkTitle(c: Chars, pos: i32) -> #(i32, string) {
    val open = c.at(pos);
    val close = if (open == 40) 41 else open;
    if (open != 34 && open != 39 && open != 40) return #(-1, "");
    var i = pos + 1;
    while (true) {
        val ch = c.at(i);
        if (ch == -1) return #(-1, "");
        if (ch == close) return #(i + 1, unescapeString(c.text(pos + 1, i)));
        if (open == 40 && ch == 40) return #(-1, "");
        if (ch == 92 && c.at(i + 1) != -1) i = i + 2 else i = i + 1;
    }
    return #(-1, "");
}

fn lineEndAt(c: Chars, pos: i32) -> i32 {
    var i = pos;
    while (c.at(i) == 32) {
        i = i + 1;
    }
    if (c.at(i) == 10) return i + 1;
    if (c.at(i) == -1) return i;
    return -1;
}

fn findRef(refs: Array<Ref>, label: string) -> ?Ref {
    for (refs) { r ->
        if (r.label == label) return r;
    }
    return null;
}

// A link reference definition at the start of `s`: the length it takes and
// the definitions with it added (an earlier one of the same label wins);
// `0` when the text is none.
fn parseReference(s: string, refs: Array<Ref>) -> #(i32, Array<Ref>) {
    val c = charsOf(s);
    val n = linkLabelLength(c, 0);
    if (n == 0 || c.at(n) != 58) return #(0, refs);
    val raw = c.text(1, n - 1);
    val destAt = spnl(c, n + 1);
    val dest = linkDestination(c, destAt);
    if (dest._0 < 0) return #(0, refs);
    val beforeTitle = dest._0;
    val titleAt = spnl(c, beforeTitle);
    var title = "";
    var hasTitle = false;
    var pos = beforeTitle;
    if (titleAt != beforeTitle) {
        val t = linkTitle(c, titleAt);
        if (t._0 >= 0) {
            hasTitle = true;
            title = t._1;
            pos = t._0;
        }
    }
    var end = lineEndAt(c, pos);
    if (end < 0 && hasTitle) {
        title = "";
        end = lineEndAt(c, beforeTitle);
    }
    if (end < 0) return #(0, refs);
    val norm = normalizeLabel(raw);
    if (norm == "") return #(0, refs);
    if (findRef(refs, norm) != null) return #(end, refs);
    return #(end, refs.append([Ref(label: norm, dest: dest._1, title: title)]));
}

// ── definitions: references and footnotes, before any inline ────────────────

type NoteDef(norm: string, label: string, body: Array<Blk>)

type NoteUse(norm: string, label: string, index: i32, count: i32)

// Every link reference definition at the start of a paragraph (in document
// order) and every footnote definition.
fn gatherDefinitions(
    blocks: Array<Blk>,
    refs0: Array<Ref>,
    notes0: Array<NoteDef>,
) -> #(Array<Ref>, Array<NoteDef>) {
    var refs = refs0;
    var notes = notes0;
    for (blocks) { b ->
        if (b.kind == Kind.BPara)
            refs = takeReferences(b.content, refs)._1
        else if (b.kind == Kind.BNote) {
            val norm = normalizeLabel(b.label);
            if (notes.filter({ n -> n.norm == norm }).length == 0)
                notes.push(
                    NoteDef(norm: norm, label: b.label, body: b.children),
                );
            val inner = gatherDefinitions(b.children, refs, notes);
            refs = inner._0;
            notes = inner._1;
        } else {
            val inner = gatherDefinitions(b.children, refs, notes);
            refs = inner._0;
            notes = inner._1;
        }
    }
    return #(refs, notes);
}

// The paragraph text left after its leading definitions, and the
// definitions with them added.
fn takeReferences(
    content0: string,
    refs0: Array<Ref>,
) -> #(string, Array<Ref>) {
    var content = content0;
    var refs = refs0;
    var reading = true;
    while (reading && content.startsWith("[")) {
        val r = parseReference(content, refs);
        if (r._0 == 0) reading = false else {
            content = charsOf(content).text(r._0, 2147483647);
            refs = r._1;
        }
    }
    return #(content, refs);
}

fn noteBody(notes: Array<NoteDef>, norm: string) -> Array<Blk> {
    for (notes) { n ->
        if (n.norm == norm) return n.body;
    }
    return [];
}

fn refsOf(used: Array<NoteUse>, index: i32) -> i32 {
    for (used) { u ->
        if (u.index == index) return u.count;
    }
    return 0;
}

// ── blocks to nodes ─────────────────────────────────────────────────────────

type Ctx(
    refs: Array<Ref>,
    notes: Array<NoteDef>,
    used: Array<NoteUse>,
    slugs: Array<string>,
    options: MarkdownOptions,
)

fn convertBlocks(blocks: Array<Blk>, ctx0: Ctx) -> #(Array<MdNode>, Ctx) {
    var ctx = ctx0;
    var out: MdNode[] = [];
    for (blocks) { b ->
        val r = convertBlock(b, ctx);
        ctx = r._2;
        if (r._1) out.push(r._0);
    }
    return #(out, ctx);
}

// A block as a node — `#(node, kept, ctx)`; a paragraph of definitions only
// and a footnote definition (rendered after the document) are not kept.
fn convertBlock(b: Blk, ctx: Ctx) -> #(MdNode, bool, Ctx) {
    return case b.kind {
        BPara -> convertParagraph(b, ctx);
        BHeading -> convertHeading(b, ctx);
        BCode -> #(
            MdNode.Code(lang: firstWord(b.info), text: b.content),
            true,
            ctx,
        );
        BHtml -> #(
            MdNode.Html(text: tagFilter(b.content, ctx.options.gfm)),
            true,
            ctx,
        );
        BRule -> #(MdNode.Rule, true, ctx);
        BQuote -> convertQuote(b, ctx);
        BList -> convertList(b, ctx);
        BItem -> convertItem(b, ctx);
        BTable -> convertTable(b, ctx);
        _ -> #(MdNode.Rule, false, ctx);
    };
}

fn convertParagraph(b: Blk, ctx: Ctx) -> #(MdNode, bool, Ctx) {
    val left = takeReferences(b.content, ctx.refs)._0;
    if (left != b.content && isBlankText(left.replaceAll("\n", "")))
        return #(MdNode.Rule, false, ctx);
    val r = parseInlines(left, ctx);
    return #(MdNode.Paragraph(kids: r._0), true, r._1);
}

fn convertHeading(b: Blk, ctx0: Ctx) -> #(MdNode, bool, Ctx) {
    val r = parseInlines(b.content, ctx0);
    var ctx = r._1;
    var id = "";
    if (ctx.options.headingIds) {
        id = uniqueSlug(slugOf(plainText(r._0)), ctx.slugs);
        ctx = Ctx(..ctx, slugs: ctx.slugs.append([id]));
    }
    return #(MdNode.Heading(depth: b.level, id: id, kids: r._0), true, ctx);
}

fn convertQuote(b: Blk, ctx: Ctx) -> #(MdNode, bool, Ctx) {
    val r = convertBlocks(b.children, ctx);
    return #(MdNode.Quote(kids: r._0), true, r._1);
}

fn convertList(b: Blk, ctx: Ctx) -> #(MdNode, bool, Ctx) {
    val r = convertBlocks(b.children, ctx);
    val node = MdNode.List(
        ordered: b.list.ordered,
        start: b.list.start,
        tight: b.tight,
        items: r._0,
    );
    return #(node, true, r._1);
}

fn convertItem(b: Blk, ctx: Ctx) -> #(MdNode, bool, Ctx) {
    var children = b.children;
    var task = 0;
    val first = children.at(0);
    if (ctx.options.gfm && first != null) {
        val para = first ?? b;
        val c = charsOf(para.content);
        val mark = c.at(1);
        val isTask = para.kind == Kind.BPara
            && c.at(0) == 91
            && (mark == 32 || mark == 120 || mark == 88)
            && c.at(2) == 93
            && isWs(c.at(3));
        if (isTask) {
            task = if (mark == 32) 1 else 2;
            val rest = Blk(..para, content: c.text(4, c.size));
            children = [rest].append(children.slice(1, children.length));
        }
    }
    val r = convertBlocks(children, ctx);
    return #(MdNode.Item(task: task, kids: r._0), true, r._1);
}

fn convertTable(b: Blk, ctx0: Ctx) -> #(MdNode, bool, Ctx) {
    var ctx = ctx0;
    val aligns = delimiterRow(b.rows.at(1) ?? "");
    val width = aligns.length;
    val head = convertCells(splitRow(b.rows.at(0) ?? ""), width, ctx);
    ctx = head._1;
    var rows: MdNode[] = [];
    for (b.rows.slice(2, b.rows.length)) { line ->
        val r = convertCells(splitRow(line), width, ctx);
        ctx = r._1;
        rows.push(MdNode.Row(cells: r._0));
    }
    return #(
        MdNode.Table(aligns: aligns, head: head._0, rows: rows),
        true,
        ctx,
    );
}

fn convertCells(
    cells: Array<string>,
    width: i32,
    ctx0: Ctx,
) -> #(Array<MdNode>, Ctx) {
    var ctx = ctx0;
    var out: MdNode[] = [];
    var i = 0;
    while (i < width) {
        val cell = (cells.at(i) ?? "").replaceAll("\\|", "|");
        val r = parseInlines(cell, ctx);
        ctx = r._1;
        out.push(MdNode.Cell(kids: r._0));
        i = i + 1;
    }
    return #(out, ctx);
}

fn firstWord(info: string) -> string {
    val c = charsOf(info);
    var i = 0;
    while (i < c.size && !isWs(c.at(i))) {
        i = i + 1;
    }
    return c.text(0, i);
}

// GFM's tag filter: the `<` of `title`, `textarea`, `style`, `xmp`,
// `iframe`, `noembed`, `noframes`, `script` and `plaintext` tags as `&lt;`.
fn tagFilter(html: string, gfm: bool) -> string {
    if (!gfm || !html.contains("<")) return html;
    val c = charsOf(html);
    var parts: string[] = [];
    var start = 0;
    var i = 0;
    while (i < c.size) {
        if (c.at(i) == 60 && filteredTagAt(c, i)) {
            parts.push(c.text(start, i));
            parts.push("&lt;");
            start = i + 1;
        }
        i = i + 1;
    }
    if (start == 0) return html;
    parts.push(c.text(start, c.size));
    return parts.join("");
}

val filteredTags = [
    "title",
    "textarea",
    "style",
    "xmp",
    "iframe",
    "noembed",
    "noframes",
    "script",
    "plaintext",
];

fn filteredTagAt(c: Chars, lt: i32) -> bool {
    val begin = if (c.at(lt + 1) == 47) lt + 2 else lt + 1;
    val end = tagNameEnd(c, begin);
    if (end == begin) return false;
    val name = c.text(begin, end).toLower();
    if (!filteredTags.contains(name)) return false;
    val after = c.at(end);
    return after == -1
        || after == 62
        || isHtmlSpace(after)
        || (after == 47 && c.at(end + 1) == 62);
}

// ── inlines (§ 6) ───────────────────────────────────────────────────────────

// A pending inline: literal text (a delimiter run's or a bracket's when `id`
// is not `0` — the delimiter and bracket stacks find it by that id) or a
// finished node.
type Inl {
    Lit(id: i32, value: string),
    Done(node: MdNode),
}

type Delim(id: i32, cc: i32, num: i32, orig: i32, canOpen: bool, canClose: bool)

type Brk(id: i32, index: i32, image: bool, active: bool, bracketAfter: bool, below: i32)

type IP(
    c: Chars,
    pos: i32,
    items: Array<Inl>,
    delims: Array<Delim>,
    brackets: Array<Brk>,
    nextId: i32,
    ctx: Ctx,
)

fn trimWs(s: string) -> string {
    val c = charsOf(s);
    var a = 0;
    var b = c.size;
    while (a < b && isWs(c.at(a))) {
        a = a + 1;
    }
    while (b > a && isWs(c.at(b - 1))) {
        b = b - 1;
    }
    if (a == 0 && b == c.size) return s;
    return c.text(a, b);
}

fn parseInlines(content: string, ctx: Ctx) -> #(Array<MdNode>, Ctx) {
    var ip = IP(
        c: charsOf(trimWs(content)),
        pos: 0,
        items: [],
        delims: [],
        brackets: [],
        nextId: 1,
        ctx: ctx,
    );
    while (ip.pos < ip.c.size) {
        ip = parseInline(ip);
    }
    ip = processEmphasis(ip, 0);
    var nodes = itemsToNodes(ip.items);
    if (ctx.options.gfm) nodes = autolinkAll(nodes);
    return #(nodes, ip.ctx);
}

fn pushText(ip: IP, value: string, next: i32) -> IP {
    return IP(
        ..ip,
        items: ip.items.append([Inl.Lit(id: 0, value: value)]),
        pos: next,
    );
}

fn pushNode(ip: IP, node: MdNode, next: i32) -> IP {
    return IP(..ip, items: ip.items.append([Inl.Done(node: node)]), pos: next);
}

fn parseInline(ip: IP) -> IP {
    val c = ip.c.at(ip.pos);
    val smart = ip.ctx.options.smartPunctuation;
    val gfm = ip.ctx.options.gfm;
    if (c == 10) return parseNewline(ip);
    if (c == 92) return parseBackslash(ip);
    if (c == 96) return parseBackticks(ip);
    if (c == 42 || c == 95) return handleDelim(ip, c);
    if (c == 126 && gfm) return handleDelim(ip, c);
    if ((c == 39 || c == 34) && smart) return handleDelim(ip, c);
    if (c == 91) return openBracket(ip, ip.pos, ip.pos + 1, false, "[");
    if (c == 33) {
        if (ip.c.at(ip.pos + 1) == 91)
            return openBracket(ip, ip.pos + 1, ip.pos + 2, true, "![");
        return pushText(ip, "!", ip.pos + 1);
    }
    if (c == 93) return closeBracket(ip);
    if (c == 60) return parseAngle(ip);
    if (c == 38) {
        val m = matchEntity(ip.c, ip.pos);
        if (m._0 > 0) return pushText(ip, m._1, m._0);
        return pushText(ip, "&", ip.pos + 1);
    }
    return parseString(ip);
}

fn isSpecial(c: i32, gfm: bool) -> bool {
    return c == 10
        || c == 96
        || c == 91
        || c == 93
        || c == 92
        || c == 33
        || c == 60
        || c == 38
        || c == 42
        || c == 95
        || c == 39
        || c == 34
        || (gfm && c == 126);
}

fn parseString(ip: IP) -> IP {
    val gfm = ip.ctx.options.gfm;
    var i = ip.pos + 1;
    while (i < ip.c.size && !isSpecial(ip.c.at(i), gfm)) {
        i = i + 1;
    }
    val run = ip.c.text(ip.pos, i);
    if (ip.ctx.options.smartPunctuation) return pushText(ip, smartText(run), i);
    return pushText(ip, run, i);
}

// `...` to an ellipsis; a run of hyphens to em and en dashes the way the
// reference implementation splits it.
fn smartText(s: string) -> string {
    if (!(s.contains("...") || s.contains("--"))) return s;
    val c = charsOf(s.replaceAll("...", "…"));
    var parts: string[] = [];
    var start = 0;
    var i = 0;
    while (i < c.size) {
        if (c.at(i) == 45 && c.at(i + 1) == 45) {
            val n = runLength(c, i, 45);
            parts.push(c.text(start, i));
            parts.push(dashes(n));
            i = i + n;
            start = i;
        } else i = i + 1;
    }
    parts.push(c.text(start, c.size));
    return parts.join("");
}

fn dashes(n: i32) -> string {
    if (n % 3 == 0) return "—".repeat(n / 3);
    if (n % 2 == 0) return "–".repeat(n / 2);
    if (n % 3 == 2) return ["—".repeat((n - 2) / 3), "–"].join("");
    return ["—".repeat((n - 4) / 3), "––"].join("");
}

fn parseNewline(ip0: IP) -> IP {
    var ip = ip0;
    var hard = false;
    val last = ip.items.at(ip.items.length - 1);
    if (last) {
        item ->
        val lit = case item {
            Lit(id, value) -> #(id, value);
            Done(_) -> #(-1, "");
        };
        if (lit._0 >= 0 && lit._1.endsWith(" ")) {
            hard = lit._1.endsWith("  ");
            val trimmed = Inl.Lit(id: lit._0, value: lit._1.trimEnd());
            ip = IP(
                ..ip,
                items: ip.items.slice(0, ip.items.length - 1).append([trimmed]),
            );
        }
    }
    var i = ip.pos + 1;
    while (ip.c.at(i) == 32) {
        i = i + 1;
    }
    val node = if (hard) MdNode.HardBreak else MdNode.SoftBreak;
    return pushNode(ip, node, i);
}

fn parseBackslash(ip: IP) -> IP {
    val next = ip.c.at(ip.pos + 1);
    if (next == 10) {
        var i = ip.pos + 2;
        while (ip.c.at(i) == 32) {
            i = i + 1;
        }
        return pushNode(ip, MdNode.HardBreak, i);
    }
    if (isAsciiPunct(next)) return pushText(ip, charText(next), ip.pos + 2);
    return pushText(ip, "\\", ip.pos + 1);
}

fn parseBackticks(ip: IP) -> IP {
    val n = runLength(ip.c, ip.pos, 96);
    val after = ip.pos + n;
    var i = after;
    while (i < ip.c.size) {
        if (ip.c.at(i) == 96) {
            val m = runLength(ip.c, i, 96);
            if (m == n) {
                val raw = ip.c.text(after, i).replaceAll("\n", " ");
                val strip = raw.length >= 2
                    && raw.startsWith(" ")
                    && raw.endsWith(" ")
                    && raw.trim() != "";
                val body = if (strip) raw.slice(1, raw.length - 1) else raw;
                return pushNode(ip, MdNode.CodeSpan(text: body), i + m);
            }
            i = i + m;
        } else i = i + 1;
    }
    return pushText(ip, ip.c.text(ip.pos, after), after);
}

// `<…>`: an autolink, else raw HTML, else a `<`.
fn parseAngle(ip: IP) -> IP {
    val email = emailAutolinkEnd(ip.c, ip.pos);
    if (email > 0) {
        val address = ip.c.text(ip.pos + 1, email - 1);
        val link = MdNode.Link(
            href: normalizeUri("mailto:" + address),
            title: "",
            kids: [MdNode.Text(value: address)],
        );
        return pushNode(ip, link, email);
    }
    val uri = uriAutolinkEnd(ip.c, ip.pos);
    if (uri > 0) {
        val dest = ip.c.text(ip.pos + 1, uri - 1);
        val link = MdNode.Link(
            href: normalizeUri(dest),
            title: "",
            kids: [MdNode.Text(value: dest)],
        );
        return pushNode(ip, link, uri);
    }
    val tag = matchHtmlTag(ip.c, ip.pos);
    if (tag > 0) {
        val html = tagFilter(ip.c.text(ip.pos, tag), ip.ctx.options.gfm);
        return pushNode(ip, MdNode.InlineHtml(text: html), tag);
    }
    return pushText(ip, "<", ip.pos + 1);
}

fn uriAutolinkEnd(c: Chars, s: i32) -> i32 {
    if (!isAsciiAlpha(c.at(s + 1))) return -1;
    var i = s + 2;
    while (isAsciiAlnum(c.at(i))
        || c.at(i) == 46
        || c.at(i) == 43
        || c.at(i) == 45) {
        i = i + 1;
    }
    val schemeLength = i - s - 1;
    if (schemeLength < 2 || schemeLength > 32 || c.at(i) != 58) return -1;
    i = i + 1;
    while (true) {
        val ch = c.at(i);
        if (ch == 62) return i + 1;
        if (ch == -1 || ch <= 32 || ch == 60) return -1;
        i = i + 1;
    }
    return -1;
}

fn isEmailLocal(c: i32) -> bool {
    if (isAsciiAlnum(c)) return true;
    return c == 46
        || c == 33
        || c == 35
        || c == 36
        || c == 37
        || c == 38
        || c == 39
        || c == 42
        || c == 43
        || c == 47
        || c == 61
        || c == 63
        || c == 94
        || c == 95
        || c == 96
        || c == 123
        || c == 124
        || c == 125
        || c == 126
        || c == 45;
}

fn emailAutolinkEnd(c: Chars, s: i32) -> i32 {
    var i = s + 1;
    while (isEmailLocal(c.at(i))) {
        i = i + 1;
    }
    if (i == s + 1 || c.at(i) != 64) return -1;
    i = i + 1;
    var going = true;
    while (going) {
        if (!isAsciiAlnum(c.at(i))) return -1;
        var j = i;
        while (isAsciiAlnum(c.at(j)) || c.at(j) == 45) {
            j = j + 1;
        }
        if (j - i > 63 || c.at(j - 1) == 45) return -1;
        i = j;
        if (c.at(i) == 46) i = i + 1 else going = false;
    }
    if (c.at(i) != 62) return -1;
    return i + 1;
}

// ── emphasis (§ 6.2) ────────────────────────────────────────────────────────

fn handleDelim(ip: IP, cc: i32) -> IP {
    val quote = cc == 39 || cc == 34;
    val num = if (quote) 1 else runLength(ip.c, ip.pos, cc);
    val before = if (ip.pos == 0) 10 else ip.c.at(ip.pos - 1);
    val rawAfter = ip.c.at(ip.pos + num);
    val after = if (rawAfter == -1) 10 else rawAfter;
    val afterSpace = isUnicodeSpace(after);
    val afterPunct = isPunct(after);
    val beforeSpace = isUnicodeSpace(before);
    val beforePunct = isPunct(before);
    val leftFlanking = !afterSpace
        && (!afterPunct || beforeSpace || beforePunct);
    val rightFlanking = !beforeSpace
        && (!beforePunct || afterSpace || afterPunct);
    var canOpen = leftFlanking;
    var canClose = rightFlanking;
    if (cc == 95) {
        canOpen = leftFlanking && (!rightFlanking || beforePunct);
        canClose = rightFlanking && (!leftFlanking || afterPunct);
    } else if (quote) canOpen = leftFlanking && !rightFlanking;
    val literal = if (cc == 39)
        "’"
    else if (cc == 34)
        "“"
    else
        ip.c.text(ip.pos, ip.pos + num);
    val tilde = cc == 126;
    val counted = !tilde || num <= 2;
    val id = ip.nextId;
    var out = IP(
        ..ip,
        items: ip.items.append([Inl.Lit(id: id, value: literal)]),
        pos: ip.pos + num,
        nextId: id + 1,
    );
    if ((canOpen || canClose) && counted) {
        val d = Delim(
            id: id,
            cc: cc,
            num: num,
            orig: num,
            canOpen: canOpen,
            canClose: canClose,
        );
        out = IP(..out, delims: out.delims.append([d]));
    }
    return out;
}

fn indexOfItem(items: Array<Inl>, id: i32) -> i32 {
    var i = 0;
    for (items) { item ->
        val hit = case item {
            Lit(k, _) -> k == id;
            Done(_) -> false;
        };
        if (hit) return i;
        i = i + 1;
    }
    return -1;
}

fn litValue(item: Inl) -> string {
    return case item {
        Lit(_, value) -> value;
        Done(_) -> "";
    };
}

fn setLit(items: Array<Inl>, at: i32, value: string, id: i32) -> Array<Inl> {
    return items
        .slice(0, at)
        .append([Inl.Lit(id: id, value: value)])
        .append(items.slice(at + 1, items.length));
}

fn removeAt<T>(xs: Array<T>, at: i32) -> Array<T> {
    return xs.slice(0, at).append(xs.slice(at + 1, xs.length));
}

fn bottomSlot(closer: Delim) -> i32 {
    if (closer.cc == 39) return 0;
    if (closer.cc == 34) return 1;
    if (closer.cc == 126) return 14;
    val opens = if (closer.canOpen) 3 else 0;
    val base = if (closer.cc == 95) 2 else 8;
    return base + opens + closer.orig % 3;
}

// The delimiter stack above `bottom` (an index into `delims`) resolved into
// emphasis, strong emphasis, strikethrough and curly quotes, then dropped.
fn processEmphasis(ip0: IP, bottom: i32) -> IP {
    var items = ip0.items;
    var delims = ip0.delims;
    var floors = Array.repeat(-1, 15);
    var ci = bottom;
    while (ci < delims.length) {
        val closer = delims.at(ci) ?? Delim(
            id: 0,
            cc: 0,
            num: 0,
            orig: 0,
            canOpen: false,
            canClose: false,
        );
        if (!closer.canClose) ci = ci + 1 else {
            val slot = bottomSlot(closer);
            val floor = floors.at(slot) ?? -1;
            var oi = ci - 1;
            var found = false;
            while (!found && oi >= bottom) {
                val opener = delims.at(oi) ?? closer;
                if (opener.id <= floor) oi = bottom - 1 else {
                    val odd = (closer.canOpen || opener.canClose)
                        && closer.orig % 3 != 0
                        && (opener.orig + closer.orig) % 3 == 0;
                    val tildeMatch = closer.cc != 126
                        || opener.num == closer.num;
                    if (opener.cc == closer.cc
                        && opener.canOpen
                        && !odd
                        && tildeMatch)
                        found = true
                    else
                        oi = oi - 1;
                }
            }
            val emphasis = closer.cc == 42
                || closer.cc == 95
                || closer.cc == 126;
            if (emphasis && found) {
                val opener = delims.at(oi) ?? closer;
                val spent = if (closer.cc == 126)
                    closer.num
                else if (closer.num >= 2 && opener.num >= 2)
                    2
                else
                    1;
                val po = indexOfItem(items, opener.id);
                val pc = indexOfItem(items, closer.id);
                val openText = litValue(
                    items.at(po) ?? Inl.Lit(id: 0, value: ""),
                );
                val closeText = litValue(
                    items.at(pc) ?? Inl.Lit(id: 0, value: ""),
                );
                val inner = itemsToNodes(items.slice(po + 1, pc));
                val wrapped = if (closer.cc == 126)
                    MdNode.Strike(kids: inner)
                else if (spent == 2)
                    MdNode.Strong(kids: inner)
                else
                    MdNode.Emph(kids: inner);
                val openLeft = openText.slice(0, openText.length - spent);
                val closeLeft = closeText.slice(0, closeText.length - spent);
                items = items
                    .slice(0, po)
                    .append(
                        [
                            Inl.Lit(id: opener.id, value: openLeft),
                            Inl.Done(node: wrapped),
                            Inl.Lit(id: closer.id, value: closeLeft),
                        ],
                    )
                    .append(items.slice(pc + 1, items.length));
                val newOpener = Delim(..opener, num: opener.num - spent);
                val newCloser = Delim(..closer, num: closer.num - spent);
                delims = delims
                    .slice(0, oi)
                    .append([newOpener, newCloser])
                    .append(delims.slice(ci + 1, delims.length));
                ci = oi + 1;
                if (newOpener.num == 0) {
                    items = removeAt(items, indexOfItem(items, opener.id));
                    delims = removeAt(delims, oi);
                    ci = ci - 1;
                }
                if (newCloser.num == 0) {
                    items = removeAt(items, indexOfItem(items, closer.id));
                    delims = removeAt(delims, ci);
                }
            } else {
                if (closer.cc == 39 || closer.cc == 34) {
                    val closeMark = if (closer.cc == 39) "’" else "”";
                    items = setLit(
                        items,
                        indexOfItem(items, closer.id),
                        closeMark,
                        closer.id,
                    );
                    if (found) {
                        val opener = delims.at(oi) ?? closer;
                        val openMark = if (closer.cc == 39) "‘" else "“";
                        items = setLit(
                            items,
                            indexOfItem(items, opener.id),
                            openMark,
                            opener.id,
                        );
                    }
                }
                if (!found) {
                    val below = delims.at(ci - 1);
                    val floorId = if (ci - 1 >= 0 && below != null)
                        (below ?? closer).id
                    else
                        -1;
                    floors = floors
                        .slice(0, slot)
                        .append([floorId])
                        .append(floors.slice(slot + 1, floors.length));
                    if (!closer.canOpen)
                        delims = removeAt(delims, ci)
                    else
                        ci = ci + 1;
                } else ci = ci + 1;
            }
        }
    }
    return IP(..ip0, items: items, delims: delims.slice(0, bottom));
}

// ── links and images (§ 6.3, § 6.4) ─────────────────────────────────────────

fn openBracket(
    ip: IP,
    index: i32,
    next: i32,
    image: bool,
    literal: string,
) -> IP {
    val id = ip.nextId;
    val marked = ip.brackets.map({ b -> Brk(..b, bracketAfter: true) });
    val brk = Brk(
        id: id,
        index: index,
        image: image,
        active: true,
        bracketAfter: false,
        below: ip.delims.length,
    );
    return IP(
        ..ip,
        items: ip.items.append([Inl.Lit(id: id, value: literal)]),
        pos: next,
        nextId: id + 1,
        brackets: marked.append([brk]),
    );
}

fn dropBracket(ip: IP) -> IP {
    return IP(..ip, brackets: ip.brackets.slice(0, ip.brackets.length - 1));
}

fn closeBracket(ip0: IP) -> IP {
    val startpos = ip0.pos + 1;
    val ip = IP(..ip0, pos: startpos);
    val top = ip.brackets.at(ip.brackets.length - 1);
    if (top == null) return pushText(ip, "]", startpos);
    val opener = top ?? Brk(
        id: 0,
        index: 0,
        image: false,
        active: false,
        bracketAfter: false,
        below: 0,
    );
    if (!opener.active) return pushText(dropBracket(ip), "]", startpos);
    var matched = false;
    var dest = "";
    var title = "";
    var pos = startpos;
    if (ip.c.at(startpos) == 40) {
        val d = linkDestination(ip.c, spnl(ip.c, startpos + 1));
        if (d._0 >= 0) {
            val afterDest = spnl(ip.c, d._0);
            var afterTitle = afterDest;
            var t = "";
            if (isWs(ip.c.at(afterDest - 1))) {
                val tt = linkTitle(ip.c, afterDest);
                if (tt._0 >= 0) {
                    afterTitle = tt._0;
                    t = tt._1;
                }
            }
            val end = spnl(ip.c, afterTitle);
            if (ip.c.at(end) == 41) {
                matched = true;
                dest = d._1;
                title = t;
                pos = end + 1;
            }
        }
    }
    if (!matched) {
        val n = linkLabelLength(ip.c, startpos);
        var label = "";
        var hasLabel = false;
        if (n > 2) {
            label = ip.c.text(startpos + 1, startpos + n - 1);
            hasLabel = true;
        } else if (!opener.bracketAfter) {
            label = ip.c.text(opener.index + 1, startpos - 1);
            hasLabel = true;
        }
        pos = if (n == 0) startpos else startpos + n;
        if (hasLabel) {
            val found = findRef(ip.ctx.refs, normalizeLabel(label));
            if (found) {
                r ->
                matched = true;
                dest = r.dest;
                title = r.title;
            }
        }
    }
    if (!matched && ip.ctx.options.gfm) {
        val note = footnoteRef(ip, opener, startpos);
        if (note._1) return note._0;
    }
    if (!matched) return pushText(dropBracket(ip), "]", startpos);
    val processed = processEmphasis(IP(..ip, pos: pos), opener.below);
    val po = indexOfItem(processed.items, opener.id);
    val kids = itemsToNodes(
        processed.items.slice(po + 1, processed.items.length),
    );
    val node = if (opener.image)
        MdNode.Image(src: dest, alt: plainText(kids), title: title)
    else
        MdNode.Link(href: dest, title: title, kids: kids);
    var brackets = processed.brackets.slice(0, processed.brackets.length - 1);
    if (!opener.image)
        brackets = brackets.map(
            { b -> if (b.image) b else Brk(..b, active: false) },
        );
    return IP(
        ..processed,
        items: processed.items.slice(0, po).append([Inl.Done(node: node)]),
        brackets: brackets,
    );
}

// `[^label]` naming a footnote definition: its reference, numbered by first
// use. After a `!` the `!` stays text, as cmark-gfm reads `![^1]`.
fn footnoteRef(ip: IP, opener: Brk, startpos: i32) -> #(IP, bool) {
    if (ip.c.at(opener.index + 1) != 94) return #(ip, false);
    val raw = ip.c.text(opener.index + 2, startpos - 1);
    val norm = normalizeLabel(raw);
    val defs = ip.ctx.notes.filter({ n -> n.norm == norm });
    if (raw == "" || defs.length == 0) return #(ip, false);
    val def = defs.at(0) ?? NoteDef(norm: "", label: "", body: []);
    val prior = ip.ctx.used.filter({ u -> u.norm == norm });
    var used = ip.ctx.used;
    var usage = NoteUse(
        norm: norm,
        label: def.label,
        index: used.length + 1,
        count: 1,
    );
    if (prior.length > 0) {
        val old = prior.at(0) ?? usage;
        usage = NoteUse(..old, count: old.count + 1);
        used = used.map({ u -> if (u.norm == norm) usage else u });
    } else used = used.append([usage]);
    val po = indexOfItem(ip.items, opener.id);
    val node = MdNode.FootnoteRef(
        label: def.label,
        index: usage.index,
        nth: usage.count,
    );
    val bang = if (opener.image) [Inl.Lit(id: 0, value: "!")] else [];
    val next = IP(
        ..ip,
        items: ip.items
            .slice(0, po)
            .append(bang)
            .append([Inl.Done(node: node)]),
        delims: ip.delims.slice(0, opener.below),
        brackets: ip.brackets.slice(0, ip.brackets.length - 1),
        ctx: Ctx(..ip.ctx, used: used),
    );
    return #(next, true);
}

// Pending items as nodes, adjacent text merged.
fn itemsToNodes(items: Array<Inl>) -> Array<MdNode> {
    var out: MdNode[] = [];
    var pending: string[] = [];
    for (items) { item ->
        case item {
            Lit(_, value) {
                pending.push(value);
            }
            Done(node) {
                if (pending.length > 0) {
                    val joined = pending.join("");
                    if (joined != "") out.push(MdNode.Text(value: joined));
                    pending = [];
                }
                out.push(node);
            }
        }
    }
    if (pending.length > 0) {
        val joined = pending.join("");
        if (joined != "") out.push(MdNode.Text(value: joined));
    }
    return out;
}

// The text of inlines as an image's `alt` reads it.
pub fn plainText(nodes: Array<MdNode>) -> string {
    return nodes.map({ n -> plainOf(n) }).join("");
}

fn plainOf(n: MdNode) -> string {
    return case n {
        Text(value) -> value;
        CodeSpan(text) -> text;
        SoftBreak -> "\n";
        HardBreak -> "\n";
        Emph(kids) -> plainText(kids);
        Strong(kids) -> plainText(kids);
        Strike(kids) -> plainText(kids);
        Link(_, _, kids) -> plainText(kids);
        Image(_, alt, _) -> alt;
        InlineHtml(text) -> text;
        Paragraph(kids) -> plainText(kids);
        Heading(_, _, kids) -> plainText(kids);
        Cell(kids) -> plainText(kids);
        _ -> "";
    };
}

// ── extended autolinks (GFM) ────────────────────────────────────────────────

// Text outside links and code, with its extended autolinks.
fn autolinkAll(nodes: Array<MdNode>) -> Array<MdNode> {
    var out: MdNode[] = [];
    for (nodes) { n ->
        case n {
            Text(value) {
                for (autolinkText(value)) { k ->
                    out.push(k);
                }
            }
            Emph(kids) {
                out.push(MdNode.Emph(kids: autolinkAll(kids)));
            }
            Strong(kids) {
                out.push(MdNode.Strong(kids: autolinkAll(kids)));
            }
            Strike(kids) {
                out.push(MdNode.Strike(kids: autolinkAll(kids)));
            }
            _ {
                out.push(n);
            }
        }
    }
    return out;
}

fn isDomainChar(c: i32) -> bool {
    return isAsciiAlnum(c) || c == 45 || c == 95 || c > 127;
}

// The end of a valid domain at `begin` (segments of letters, digits, `_` and
// `-` joined by `.`, one `.` at least, no `_` in the last two segments), `-1`.
fn domainEnd(c: Chars, begin: i32) -> i32 {
    var i = begin;
    var dots = 0;
    var lastUnderscore = 0;
    var prevUnderscore = 0;
    var segUnderscore = 0;
    var going = true;
    while (going) {
        val ch = c.at(i);
        if (ch == 46 && isDomainChar(c.at(i + 1))) {
            dots = dots + 1;
            prevUnderscore = lastUnderscore;
            lastUnderscore = segUnderscore;
            segUnderscore = 0;
            i = i + 1;
        } else if (isDomainChar(ch)) {
            if (ch == 95) segUnderscore = 1;
            i = i + 1;
        } else going = false;
    }
    if (i == begin || dots == 0) return -1;
    if (segUnderscore == 1 || lastUnderscore == 1) return -1;
    return i;
}

// The end of an extended autolink's path from `begin`, trailing punctuation
// and unmatched `)` and an entity-like `&…;` trimmed.
fn pathEnd(c: Chars, begin: i32) -> i32 {
    var end = begin;
    while (end < c.size && !isUnicodeSpace(c.at(end)) && c.at(end) != 60) {
        end = end + 1;
    }
    var trimming = true;
    while (trimming && end > begin) {
        val last = c.at(end - 1);
        val trail = last == 63
            || last == 33
            || last == 46
            || last == 44
            || last == 58
            || last == 42
            || last == 95
            || last == 126;
        if (trail) end = end - 1 else if (last == 41) {
            // `)` is trimmed while the path has more `)` than `(`.
            var opens = 0;
            var closes = 0;
            var k = begin;
            while (k < end) {
                if (c.at(k) == 40) opens = opens + 1;
                if (c.at(k) == 41) closes = closes + 1;
                k = k + 1;
            }
            if (closes > opens) end = end - 1 else trimming = false;
        } else if (last == 59) {
            // An entity-like tail: `&` + alphanumerics + `;`.
            var k = end - 2;
            while (k >= begin && isAsciiAlnum(c.at(k))) {
                k = k - 1;
            }
            if (k >= begin && k < end - 2 && c.at(k) == 38)
                end = k
            else
                trimming = false;
        } else trimming = false;
    }
    return end;
}

fn autolinkBoundary(c: Chars, i: i32) -> bool {
    if (i == 0) return true;
    val b = c.at(i - 1);
    return isUnicodeSpace(b) || b == 42 || b == 95 || b == 126 || b == 40;
}

fn autolinkText(value: string) -> Array<MdNode> {
    val hasCandidate = value.contains("www.")
        || value.contains("WWW.")
        || value.contains("://")
        || value.contains("@");
    if (!hasCandidate) return [MdNode.Text(value: value)];
    val c = charsOf(value);
    var out: MdNode[] = [];
    var start = 0;
    var i = 0;
    while (i < c.size) {
        val hit = autolinkAt(c, i, start);
        if (hit._0 > i) {
            if (hit._3 > start)
                out.push(MdNode.Text(value: c.text(start, hit._3)));
            out.push(
                MdNode.Link(
                    href: hit._1,
                    title: "",
                    kids: [MdNode.Text(value: hit._2)],
                ),
            );
            i = hit._0;
            start = i;
        } else i = i + 1;
    }
    if (start < c.size) out.push(MdNode.Text(value: c.text(start, c.size)));
    return out;
}

// An extended autolink found at `i`: `#(end, href, text, linkStart)`; `end`
// equal to `i` when none. An email autolink starts before `i` (its `@`), not
// before `floor`.
fn autolinkAt(c: Chars, i: i32, floor: i32) -> #(i32, string, string, i32) {
    val none = #(i, "", "", i);
    val ch = c.at(i);
    if ((ch == 119 || ch == 87)
        && wordAt(c, i, "www.")
        && autolinkBoundary(c, i)) {
        val d = domainEnd(c, i + 4);
        if (d < 0) return none;
        val end = pathEnd(c, d);
        val shown = c.text(i, end);
        return #(end, normalizeUri("http://" + shown), shown, i);
    }
    val schemes = ["http://", "https://", "ftp://"];
    for (schemes) { scheme ->
        if (wordAt(c, i, scheme) && autolinkBoundary(c, i)) {
            val after = i + charsOf(scheme).size;
            val d = domainEnd(c, after);
            if (d < 0) return none;
            val end = pathEnd(c, d);
            val shown = c.text(i, end);
            return #(end, normalizeUri(shown), shown, i);
        }
    }
    if (ch == 64) {
        var s = i;
        while (s > floor && isEmailLocalGfm(c.at(s - 1))) {
            s = s - 1;
        }
        if (s == i) return none;
        var j = i + 1;
        var dots = 0;
        while (isAsciiAlnum(c.at(j))
            || c.at(j) == 45
            || c.at(j) == 95
            || (c.at(j) == 46 && isAsciiAlnum(c.at(j + 1)))) {
            if (c.at(j) == 46) dots = dots + 1;
            j = j + 1;
        }
        val last = c.at(j - 1);
        if (dots == 0 || last == 45 || last == 95 || j == i + 1) return none;
        val shown = c.text(s, j);
        return #(j, normalizeUri("mailto:" + shown), shown, s);
    }
    return none;
}

fn isEmailLocalGfm(c: i32) -> bool {
    return isAsciiAlnum(c) || c == 46 || c == 45 || c == 95 || c == 43;
}

// ── heading ids ─────────────────────────────────────────────────────────────

// GitHub's slug of `title` — the rule heading ids follow, and the one a
// collection entry's id is made with (`collections`).
pub fn slug(title: string) -> string {
    return slugOf(title);
}

// GitHub's slug: lower case, spaces to `-`, punctuation and symbols other
// than `-` and `_` dropped.
fn slugOf(title: string) -> string {
    val c = charsOf(title.toLower());
    var parts: string[] = [];
    var i = 0;
    while (i < c.size) {
        val ch = c.at(i);
        if (ch == 32)
            parts.push("-")
        else if (ch == 45 || ch == 95)
            parts.push(charText(ch))
        else if (!isPunct(ch) && !isUnicodeSpace(ch))
            parts.push(charText(ch));
        i = i + 1;
    }
    return parts.join("");
}

fn uniqueSlug(slug: string, taken: Array<string>) -> string {
    if (!taken.contains(slug)) return slug;
    var n = 1;
    while (taken.contains(slug + "-" + n.toString())) {
        n = n + 1;
    }
    return slug + "-" + n.toString();
}

// Every heading of the document, in order, nested ones included.
pub fn headings(doc: MdDoc) -> Array<Heading> {
    return headingsIn(doc.nodes);
}

fn headingsIn(nodes: Array<MdNode>) -> Array<Heading> {
    var out: Heading[] = [];
    for (nodes) { n ->
        out = out.append(headingsOf(n));
    }
    return out;
}

fn headingsOf(n: MdNode) -> Array<Heading> {
    return case n {
        Heading(depth, id, kids) -> [
            Heading(depth: depth, slug: id, text: plainText(kids)),
        ];
        Quote(kids) -> headingsIn(kids);
        List(_, _, _, items) -> headingsIn(items);
        Item(_, kids) -> headingsIn(kids);
        _ -> [];
    };
}

// ── HTML ────────────────────────────────────────────────────────────────────

// The document as the CommonMark reference renderer writes it (and
// cmark-gfm for the extensions).
pub fn toHtml(doc: MdDoc) -> string {
    val body = doc.nodes.map({ n -> blockHtml(n, false) }).join("");
    if (doc.footnotes.length == 0) return body;
    val notes = doc.footnotes.map({ f -> footnoteHtml(f) }).join("");
    return [
        body,
        "<section class=\"footnotes\" data-footnotes>\n<ol>\n",
        notes,
        "</ol>\n</section>\n",
    ].join("");
}

fn attr(name: string, value: string) -> string {
    return [" ", name, "=\"", escapeHtml(value), "\""].join("");
}

fn blockHtml(n: MdNode, tight: bool) -> string {
    return case n {
        Paragraph(kids) -> if (tight)
            inlinesHtml(kids)
        else
            ["<p>", inlinesHtml(kids), "</p>\n"].join("");
        Heading(depth, id, kids) -> headingHtml(depth, id, kids);
        Code(lang, text) -> codeHtml(lang, text);
        Rule -> "<hr />\n";
        Html(text) -> text + "\n";
        Quote(kids) -> [
            "<blockquote>\n",
            kids.map({ k -> blockHtml(k, false) }).join(""),
            "</blockquote>\n",
        ].join("");
        List(ordered, start, tight: isTight, items) -> listHtml(
            ordered,
            start,
            isTight,
            items,
        );
        Table(aligns, head, rows) -> tableHtml(aligns, head, rows);
        _ -> inlineHtml(n);
    };
}

fn headingHtml(depth: i32, id: string, kids: Array<MdNode>) -> string {
    val tag = "h" + depth.toString();
    val idAttr = if (id == "") "" else attr("id", id);
    return ["<", tag, idAttr, ">", inlinesHtml(kids), "</", tag, ">\n"].join(
        "",
    );
}

fn codeHtml(lang: string, text: string) -> string {
    val cls = if (lang == "")
        ""
    else if (lang.startsWith("language-"))
        attr("class", lang)
    else
        attr("class", "language-" + lang);
    return ["<pre><code", cls, ">", escapeHtml(text), "</code></pre>\n"].join(
        "",
    );
}

fn listHtml(
    ordered: bool,
    start: i32,
    tight: bool,
    items: Array<MdNode>,
) -> string {
    val tag = if (ordered) "ol" else "ul";
    val startAttr = if (ordered && start != 1)
        attr("start", start.toString())
    else
        "";
    val body = items.map({ i -> itemHtml(i, tight) }).join("");
    return ["<", tag, startAttr, ">\n", body, "</", tag, ">\n"].join("");
}

fn taskBox(task: i32) -> string {
    if (task == 1) return "<input disabled=\"\" type=\"checkbox\"> ";
    if (task == 2)
        return "<input checked=\"\" disabled=\"\" type=\"checkbox\"> ";
    return "";
}

fn itemHtml(item: MdNode, tight: bool) -> string {
    val parts = case item {
        Item(task, kids) -> #(task, kids);
        _ -> #(0, []);
    };
    var out: string[] = ["<li>"];
    var atLineStart = false;
    var first = true;
    for (parts._1) { k ->
        val isPara = case k {
            Paragraph(_) -> true;
            _ -> false;
        };
        val box = if (first) taskBox(parts._0) else "";
        if (isPara && tight) {
            out.push(box);
            out.push(blockHtml(k, true));
            atLineStart = false;
        } else {
            if (!atLineStart) out.push("\n");
            if (isPara && box != "")
                out.push(["<p>", box, blockHtml(k, true), "</p>\n"].join(""))
            else
                out.push(blockHtml(k, false));
            atLineStart = true;
        }
        first = false;
    }
    if (first) out.push(taskBox(parts._0));
    out.push("</li>\n");
    return out.join("");
}

fn tableHtml(
    aligns: Array<string>,
    head: Array<MdNode>,
    rows: Array<MdNode>,
) -> string {
    val headHtml = rowHtml(head, aligns, "th");
    val bodyRows = rows
        .map({ r ->
            case r {
                Row(cells) -> rowHtml(cells, aligns, "td");
                _ -> "";
            }
        })
        .join("");
    val body = if (rows.length == 0)
        ""
    else
        ["<tbody>\n", bodyRows, "</tbody>\n"].join("");
    return [
        "<table>\n<thead>\n",
        headHtml,
        "</thead>\n",
        body,
        "</table>\n",
    ].join("");
}

fn rowHtml(cells: Array<MdNode>, aligns: Array<string>, tag: string) -> string {
    var out: string[] = ["<tr>\n"];
    var i = 0;
    for (cells) { cell ->
        val align = aligns.at(i) ?? "";
        val alignAttr = if (align == "") "" else attr("align", align);
        val kids = case cell {
            Cell(kids) -> kids;
            _ -> [];
        };
        out.push(
            [
                "<",
                tag,
                alignAttr,
                ">",
                inlinesHtml(kids),
                "</",
                tag,
                ">\n",
            ].join(""),
        );
        i = i + 1;
    }
    out.push("</tr>\n");
    return out.join("");
}

fn inlinesHtml(nodes: Array<MdNode>) -> string {
    return nodes.map({ n -> inlineHtml(n) }).join("");
}

fn inlineHtml(n: MdNode) -> string {
    return case n {
        Text(value) -> escapeHtml(value);
        SoftBreak -> "\n";
        HardBreak -> "<br />\n";
        CodeSpan(text) -> ["<code>", escapeHtml(text), "</code>"].join("");
        Emph(kids) -> ["<em>", inlinesHtml(kids), "</em>"].join("");
        Strong(kids) -> ["<strong>", inlinesHtml(kids), "</strong>"].join("");
        Strike(kids) -> ["<del>", inlinesHtml(kids), "</del>"].join("");
        Link(href, title, kids) -> linkHtml(href, title, kids);
        Image(src, alt, title) -> imageHtml(src, alt, title);
        InlineHtml(text) -> text;
        FootnoteRef(label, index, nth) -> footnoteRefHtml(label, index, nth);
        _ -> "";
    };
}

fn linkHtml(href: string, title: string, kids: Array<MdNode>) -> string {
    val titleAttr = if (title == "") "" else attr("title", title);
    return [
        "<a",
        attr("href", href),
        titleAttr,
        ">",
        inlinesHtml(kids),
        "</a>",
    ].join("");
}

fn imageHtml(src: string, alt: string, title: string) -> string {
    val titleAttr = if (title == "") "" else attr("title", title);
    return ["<img", attr("src", src), attr("alt", alt), titleAttr, " />"].join(
        "",
    );
}

fn noteId(label: string) -> string {
    return escapeHtml(normalizeUri(label));
}

fn footnoteRefHtml(label: string, index: i32, nth: i32) -> string {
    val suffix = if (nth > 1) "-" + nth.toString() else "";
    return [
        "<sup class=\"footnote-ref\"><a href=\"#fn-",
        noteId(label),
        "\" id=\"fnref-",
        noteId(label),
        suffix,
        "\" data-footnote-ref>",
        index.toString(),
        "</a></sup>",
    ].join("");
}

fn backrefsHtml(f: Footnote) -> string {
    var refs: string[] = [];
    var k = 1;
    while (k <= f.refs) {
        val suffix = if (k > 1) "-" + k.toString() else "";
        val idx = f.index.toString() + suffix;
        val sup = if (k > 1)
            ["<sup class=\"footnote-ref\">", k.toString(), "</sup>"].join("")
        else
            "";
        refs.push(
            [
                "<a href=\"#fnref-",
                noteId(f.label),
                suffix,
                "\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"",
                idx,
                "\" aria-label=\"Back to reference ",
                idx,
                "\">↩",
                sup,
                "</a>",
            ].join(""),
        );
        k = k + 1;
    }
    return refs.join(" ");
}

fn footnoteHtml(f: Footnote) -> string {
    val n = f.kids.length;
    val last = f.kids.at(n - 1);
    val endsInParagraph = case last {
        null {
            false;
        }
        node {
            case node {
                Paragraph(_) -> true;
                _ -> false;
            }
        }
    };
    val backrefs = backrefsHtml(f);
    var body = "";
    if (endsInParagraph) {
        val before = f.kids
            .slice(0, n - 1)
            .map({ k -> blockHtml(k, false) })
            .join("");
        val lastKids = case last {
            null {
                [];
            }
            node {
                case node {
                    Paragraph(kids) -> kids;
                    _ -> [];
                }
            }
        };
        body = [
            before,
            "<p>",
            inlinesHtml(lastKids),
            " ",
            backrefs,
            "</p>\n",
        ].join("");
    } else body = [
        f.kids.map({ k -> blockHtml(k, false) }).join(""),
        backrefs,
        "\n",
    ].join("");
    return ["<li id=\"fn-", noteId(f.label), "\">\n", body, "</li>\n"].join("");
}

// ── Element ─────────────────────────────────────────────────────────────────

pub fn toElement(doc: MdDoc) -> Element {
    val body = doc.nodes.map({ n -> blockElement(n, false) });
    if (doc.footnotes.length == 0) return fragment(body, attrs: []);
    val items = doc.footnotes.map({ f -> footnoteElement(f) });
    val section = el(
        "section",
        [el("ol", items, attrs: [])],
        attrs: [#("class", "footnotes"), #("data-footnotes", "")],
    );
    return fragment(body.append([section]), attrs: []);
}

fn blockElement(n: MdNode, tight: bool) -> Element {
    return case n {
        Paragraph(kids) -> if (tight)
            fragment(inlineElements(kids), attrs: [])
        else
            el("p", inlineElements(kids), attrs: []);
        Heading(depth, id, kids) -> el(
            "h" + depth.toString(),
            inlineElements(kids),
            attrs: if (id == "") [] else [#("id", id)],
        );
        Code(lang, text) -> codeElement(lang, text);
        Rule -> voidEl("hr", []);
        Html(text) -> raw(text);
        Quote(kids) -> el(
            "blockquote",
            kids.map({ k -> blockElement(k, false) }),
            attrs: [],
        );
        List(ordered, start, tight: isTight, items) -> listElement(
            ordered,
            start,
            isTight,
            items,
        );
        Table(aligns, head, rows) -> tableElement(aligns, head, rows);
        _ -> inlineElement(n);
    };
}

fn codeElement(lang: string, body: string) -> Element {
    val cls = if (lang == "")
        []
    else if (lang.startsWith("language-"))
        [#("class", lang)]
    else
        [#("class", "language-" + lang)];
    return el(
        "pre",
        [el("code", [text(body, attrs: [])], attrs: cls)],
        attrs: [],
    );
}

fn taskElement(task: i32) -> Array<Element> {
    if (task == 0) return [];
    val checked = if (task == 2) [#("checked", "")] else [];
    val box = voidEl(
        "input",
        [#("type", "checkbox")].append(checked).append([#("disabled", "")]),
    );
    return [box, text(" ", attrs: [])];
}

fn listElement(
    ordered: bool,
    start: i32,
    tight: bool,
    items: Array<MdNode>,
) -> Element {
    val tag = if (ordered) "ol" else "ul";
    val attrs = if (ordered && start != 1)
        [#("start", start.toString())]
    else
        [];
    val lis = items.map({ item ->
        case item {
            Item(task, kids) -> itemElement(task, kids, tight);
            _ -> fragment([], attrs: []);
        }
    });
    return el(tag, lis, attrs: attrs);
}

fn itemElement(task: i32, kids: Array<MdNode>, tight: bool) -> Element {
    var out: Element[] = [];
    var first = true;
    for (kids) { k ->
        val isPara = case k {
            Paragraph(_) -> true;
            _ -> false;
        };
        val box = if (first) taskElement(task) else [];
        if (isPara && !tight && box.length > 0) {
            val inner = case k {
                Paragraph(ks) -> inlineElements(ks);
                _ -> [];
            };
            out.push(el("p", box.append(inner), attrs: []));
        } else {
            out = out.append(box);
            out.push(blockElement(k, tight));
        }
        first = false;
    }
    if (first) out = out.append(taskElement(task));
    return el("li", out, attrs: []);
}

fn tableElement(
    aligns: Array<string>,
    head: Array<MdNode>,
    rows: Array<MdNode>,
) -> Element {
    val thead = el("thead", [rowElement(head, aligns, "th")], attrs: []);
    val trs = rows.map({ r ->
        case r {
            Row(cells) -> rowElement(cells, aligns, "td");
            _ -> fragment([], attrs: []);
        }
    });
    val parts = if (rows.length == 0)
        [thead]
    else
        [thead, el("tbody", trs, attrs: [])];
    return el("table", parts, attrs: []);
}

fn rowElement(
    cells: Array<MdNode>,
    aligns: Array<string>,
    tag: string,
) -> Element {
    var out: Element[] = [];
    var i = 0;
    for (cells) { cell ->
        val align = aligns.at(i) ?? "";
        val attrs = if (align == "")
            []
        else
            [#("style", "text-align:" + align)];
        val kids = case cell {
            Cell(kids) -> kids;
            _ -> [];
        };
        out.push(el(tag, inlineElements(kids), attrs: attrs));
        i = i + 1;
    }
    return el("tr", out, attrs: []);
}

fn imageAttrs(
    src: string,
    alt: string,
    title: string,
) -> Array<#(string, string)> {
    val shown = [#("src", src)].append([#("alt", alt)]);
    if (title == "") return shown;
    return shown.append([#("title", title)]);
}

fn inlineElements(nodes: Array<MdNode>) -> Array<Element> {
    return nodes.map({ n -> inlineElement(n) });
}

fn inlineElement(n: MdNode) -> Element {
    return case n {
        Text(value) -> text(value, attrs: []);
        SoftBreak -> text("\n", attrs: []);
        HardBreak -> voidEl("br", []);
        CodeSpan(body) -> el("code", [text(body, attrs: [])], attrs: []);
        Emph(kids) -> el("em", inlineElements(kids), attrs: []);
        Strong(kids) -> el("strong", inlineElements(kids), attrs: []);
        Strike(kids) -> el("del", inlineElements(kids), attrs: []);
        Link(href, title, kids) -> el(
            "a",
            inlineElements(kids),
            attrs: [#("href", href)].append(
                if (title == "") [] else [#("title", title)],
            ),
        );
        Image(src, alt, title) -> voidEl("img", imageAttrs(src, alt, title));
        InlineHtml(body) -> raw(body);
        FootnoteRef(label, index, nth) -> el(
            "sup",
            [
                el(
                    "a",
                    [text(index.toString(), attrs: [])],
                    attrs: [
                        #("href", "#fn-" + normalizeUri(label)),
                        #("id", refAnchor(label, nth)),
                        #("data-footnote-ref", ""),
                    ],
                ),
            ],
            attrs: [#("class", "footnote-ref")],
        );
        _ -> fragment([], attrs: []);
    };
}

fn refAnchor(label: string, nth: i32) -> string {
    val suffix = if (nth > 1) "-" + nth.toString() else "";
    return "fnref-" + normalizeUri(label) + suffix;
}

fn footnoteElement(f: Footnote) -> Element {
    val blocks = f.kids.map({ k -> blockElement(k, false) });
    var refs: Element[] = [];
    var k = 1;
    while (k <= f.refs) {
        val suffix = if (k > 1) "-" + k.toString() else "";
        refs.push(text(" ", attrs: []));
        refs.push(
            el(
                "a",
                [text("↩", attrs: [])],
                attrs: [
                    #("href", "#fnref-" + normalizeUri(f.label) + suffix),
                    #("class", "footnote-backref"),
                    #(
                        "aria-label",
                        "Back to reference " + f.index.toString() + suffix,
                    ),
                ],
            ),
        );
        k = k + 1;
    }
    return el(
        "li",
        blocks.append(refs),
        attrs: [#("id", "fn-" + normalizeUri(f.label))],
    );
}
