//// onze core — the project configuration (front 49 step 2) and the
//// environment split (step 7).
////
//// `onze.json` is the project's configuration file, the analogue of
//// `next.config.js`. It is read by the CLI, not by the library:
//// `OnzeConfig` is a plain record, `defaultConfig()` supplies every field the
//// file omits, and the `with*` functions return new records. `loadConfig`
//// is the one reader — an unknown key, a value of the wrong kind or a port
//// out of range is an `Error` naming the key (decision 67: refuse, never
//// guess).
////
//// The environment rule: a variable is inlinable into the client bundle
//// only if its name begins with `ONZE_PUBLIC_`, compared case-sensitively.
//// This file owns the prefix and the two predicates; front 68 owns the graph
//// walk that applies them. No flag downgrades the rule.

import {json.Json, json.decode, io.env} from "std";

// ── the record ──────────────────────────────────────────────────────────────

pub type OnzeConfig(
    name: string,
    port: i32,
    basePath: string,
    appDir: string,
    publicDir: string,
    outDir: string,
    dev: bool,
    actionsBodyLimit: i32,
    allowedRedirects: Array<string>,
) {
    pub fn origin(self: Self) -> string {
        return "http://localhost:" + self.port.toString();
    }
}

// The wire names of a server action (decision 114): onze's defaults, handed
// to rakun as `rakun.actions.field` / `rakun.actions.header` and to jhonstart
// as `actionField` / `actionHeader`. Neither library spells them.
pub fn defaultActionField() -> string {
    return "__bp_action";
}

pub fn defaultActionHeader() -> string {
    return "X-Bp-Action";
}

// rakun front 24's 1 MiB default (decision 117).
pub fn defaultActionsBodyLimit() -> i32 {
    return 1048576;
}

// The URL prefix every onze-served asset lives under (decision 116): appended
// to `rakun.i18n.exclude` at boot so rakun's locale redirect skips it.
pub fn assetPrefix() -> string {
    return "/_onze";
}

pub fn defaultConfig() -> OnzeConfig {
    return OnzeConfig(
        name: "",
        port: 3000,
        basePath: "",
        appDir: "app",
        publicDir: "public",
        outDir: ".onze",
        dev: false,
        actionsBodyLimit: defaultActionsBodyLimit(),
        allowedRedirects: [],
    );
}

pub fn withName(base: OnzeConfig, name: string) -> OnzeConfig {
    return OnzeConfig(name: name, port: base.port, basePath: base.basePath, appDir: base.appDir, publicDir: base.publicDir, outDir: base.outDir, dev: base.dev, actionsBodyLimit: base.actionsBodyLimit, allowedRedirects: base.allowedRedirects);
}

pub fn withPort(base: OnzeConfig, port: i32) -> OnzeConfig {
    return OnzeConfig(name: base.name, port: port, basePath: base.basePath, appDir: base.appDir, publicDir: base.publicDir, outDir: base.outDir, dev: base.dev, actionsBodyLimit: base.actionsBodyLimit, allowedRedirects: base.allowedRedirects);
}

pub fn withDev(base: OnzeConfig, dev: bool) -> OnzeConfig {
    return OnzeConfig(name: base.name, port: base.port, basePath: base.basePath, appDir: base.appDir, publicDir: base.publicDir, outDir: base.outDir, dev: dev, actionsBodyLimit: base.actionsBodyLimit, allowedRedirects: base.allowedRedirects);
}

fn withText(base: OnzeConfig, key: string, value: string) -> OnzeConfig {
    val basePath = if (key == "basePath") value else base.basePath;
    val appDir = if (key == "appDir") value else base.appDir;
    val publicDir = if (key == "publicDir") value else base.publicDir;
    val outDir = if (key == "outDir") value else base.outDir;
    val name = if (key == "name") value else base.name;
    return OnzeConfig(name: name, port: base.port, basePath: basePath, appDir: appDir, publicDir: publicDir, outDir: outDir, dev: base.dev, actionsBodyLimit: base.actionsBodyLimit, allowedRedirects: base.allowedRedirects);
}

fn withBodyLimit(base: OnzeConfig, limit: i32) -> OnzeConfig {
    return OnzeConfig(name: base.name, port: base.port, basePath: base.basePath, appDir: base.appDir, publicDir: base.publicDir, outDir: base.outDir, dev: base.dev, actionsBodyLimit: limit, allowedRedirects: base.allowedRedirects);
}

fn withRedirects(base: OnzeConfig, allowed: Array<string>) -> OnzeConfig {
    return OnzeConfig(name: base.name, port: base.port, basePath: base.basePath, appDir: base.appDir, publicDir: base.publicDir, outDir: base.outDir, dev: base.dev, actionsBodyLimit: base.actionsBodyLimit, allowedRedirects: allowed);
}

// ── reading `onze.json` ─────────────────────────────────────────────────────

#[@External.Node("""Math.trunc($0)""")]
#[@External.Erlang("""trunc($0)""")]
declare fn truncToI32(x: f64) -> i32;

#[@External.Node("""Math.floor($0)""")]
#[@External.Erlang("""float(floor($0))""")]
declare fn floorF(x: f64) -> f64;

pub fn membersOf(v: Json) -> Array<#(string, Json)> {
    return case v {
        Obj(members: ms) -> ms;
        _ -> [];
    };
}

pub fn isObject(v: Json) -> bool {
    return case v {
        Obj(members: _) -> true;
        _ -> false;
    };
}

pub fn kindName(v: Json) -> string {
    return case v {
        Null -> "null";
        Bool(value: _) -> "a boolean";
        Num(value: _) -> "a number";
        Str(value: _) -> "a string";
        Arr(items: _) -> "an array";
        Obj(members: _) -> "an object";
    };
}

pub fn isString(v: Json) -> bool {
    return case v {
        Str(value: _) -> true;
        _ -> false;
    };
}

pub fn strOf(v: Json) -> string {
    return case v {
        Str(value: s) -> s;
        _ -> "";
    };
}

fn wrongKind(key: string, want: string, got: Json) -> string {
    return ["onze.json: \"", key, "\" must be ", want, ", not ", kindName(got)].join("");
}

// A JSON number that is a whole value in `lo..hi`, as an `i32`.
fn wholeIn(key: string, v: Json, lo: i32, hi: i32) -> @Result<i32, string> {
    val x = case v {
        Num(value: n) -> n;
        _ -> 0.5;
    };
    val isNum = case v {
        Num(value: _) -> true;
        _ -> false;
    };
    if (isNum == false) throw wrongKind(key, "a whole number", v);
    if (floorF(x) != x) throw ["onze.json: \"", key, "\" must be a whole number"].join("");
    val n = truncToI32(x);
    if (n < lo || n > hi) throw ["onze.json: \"", key, "\" is ", n.toString(), ", outside ", lo.toString(), "..", hi.toString()].join("");
    return n;
}

fn stringsOf(key: string, v: Json) -> @Result<Array<string>, string> {
    val items = case v {
        Arr(items: xs) -> xs;
        _ -> [];
    };
    val isArr = case v {
        Arr(items: _) -> true;
        _ -> false;
    };
    if (isArr == false) throw wrongKind(key, "an array of strings", v);
    var out: string[] = [];
    for (items) { item ->
        if (isString(item) == false) throw wrongKind(key, "an array of strings", item);
        out.push(strOf(item));
    };
    return out;
}

// The keys `onze.json` may carry, each once.
pub fn configKeys() -> string[] {
    return ["name", "port", "basePath", "appDir", "publicDir", "outDir", "dev", "actionsBodyLimit", "allowedRedirects"];
}

fn applyKey(cfg: OnzeConfig, key: string, v: Json) -> @Result<OnzeConfig, string> {
    if (key == "port") {
        val port = try wholeIn(key, v, 1, 65535);
        return withPort(cfg, port);
    }
    if (key == "actionsBodyLimit") {
        val limit = try wholeIn(key, v, 1, 2147483647);
        return withBodyLimit(cfg, limit);
    }
    if (key == "dev") {
        val isBool = case v {
            Bool(value: _) -> true;
            _ -> false;
        };
        if (isBool == false) throw wrongKind(key, "a boolean", v);
        val b = case v {
            Bool(value: x) -> x;
            _ -> false;
        };
        return withDev(cfg, b);
    }
    if (key == "allowedRedirects") {
        val allowed = try stringsOf(key, v);
        return withRedirects(cfg, allowed);
    }
    if (isString(v) == false) throw wrongKind(key, "a string", v);
    return withText(cfg, key, strOf(v));
}

// `botopink.json`'s `name` — the project name `onze.json` may override.
pub fn packageName(botopinkJson: string) -> @Result<string, string> {
    val doc = try decode(botopinkJson);
    if (isObject(doc) == false) throw "botopink.json: the document must be an object, not " + kindName(doc);
    val hit = membersOf(doc).filter({ m -> m._0 == "name" });
    if (hit.length == 0) throw "botopink.json: no \"name\"";
    val v = hit.at(0).unwrapOr(#("", Json.Null))._1;
    if (isString(v) == false) throw "botopink.json: \"name\" must be a string, not " + kindName(v);
    return strOf(v);
}

// The resolved configuration of a project: `defaultConfig()`, named after
// `botopink.json`, overridden by every key `onze.json` carries.
pub fn loadConfig(botopinkJson: string, onzeJson: string) -> @Result<OnzeConfig, string> {
    val name = try packageName(botopinkJson);
    val doc = try decode(onzeJson);
    if (isObject(doc) == false) throw "onze.json: the document must be an object, not " + kindName(doc);
    var cfg = withName(defaultConfig(), name);
    var seen: string[] = [];
    for (membersOf(doc)) { m ->
        if (configKeys().contains(m._0) == false) throw ["onze.json: unknown key \"", m._0, "\" (known: ", configKeys().join(", "), ")"].join("");
        if (seen.contains(m._0)) throw ["onze.json: \"", m._0, "\" appears twice"].join("");
        seen.push(m._0);
        cfg = try applyKey(cfg, m._0, m._1);
    };
    return cfg;
}

// The resolved configuration as the table `onze info` prints and the
// `config` snapshots record: one `key = value` row per field, aligned.
pub fn describeConfig(cfg: OnzeConfig) -> string {
    val redirects = if (cfg.allowedRedirects.length == 0) "(none)" else cfg.allowedRedirects.join(", ");
    val rows = [
        #("name", cfg.name),
        #("port", cfg.port.toString()),
        #("basePath", cfg.basePath),
        #("appDir", cfg.appDir),
        #("publicDir", cfg.publicDir),
        #("outDir", cfg.outDir),
        #("dev", if (cfg.dev) "true" else "false"),
        #("actionsBodyLimit", cfg.actionsBodyLimit.toString()),
        #("allowedRedirects", redirects),
        #("origin", cfg.origin()),
    ];
    return rows.map({ r -> (r._0.padEnd(16, " ") + " = " + r._1).trimEnd() }).join("\n");
}

// ── the environment split (seam 4) ──────────────────────────────────────────

pub fn publicEnvPrefix() -> string {
    return "ONZE_PUBLIC_";
}

// True only for a name that begins with `ONZE_PUBLIC_` exactly — the match is
// case-sensitive, because a case-insensitive one is how a secret named
// `Onze_Public_Secret` would leak.
pub fn isPublicEnvName(name: string) -> bool {
    return name.startsWith(publicEnvPrefix()) && name.length() > publicEnvPrefix().length();
}

// The public names among `names`, each with its value from the process
// environment (`""` when unset). A name the predicate rejects is dropped, so
// the list front 68 inlines cannot hold a non-public value even when its
// caller passes one.
pub fn publicEnv(names: string[]) -> Array<#(string, string)> {
    return publicEnvFrom(names, { n -> env.read(n) });
}

// `publicEnv` over an explicit reader — the same filter, testable without
// touching the process environment.
pub fn publicEnvFrom(names: string[], read: fn(name: string) -> ?string) -> Array<#(string, string)> {
    var out: Array<#(string, string)> = [];
    for (names) { n ->
        if (isPublicEnvName(n)) out.push(#(n, read(n) ?? ""));
    };
    return out;
}

// The length of the longest of `xs`, at least `floor`.
pub fn widest(xs: string[], floor: i32) -> i32 {
    var w = floor;
    for (xs) { x ->
        val n: i32 = x.length();
        if (n > w) w = n;
    };
    return w;
}

fn envCell(envPairs: Array<#(string, string)>, name: string) -> string {
    if (isPublicEnvName(name) == false) return "dropped";
    val found = publicEnvFrom([name], { n -> pairValue(envPairs, n) });
    val value = found.at(0).unwrapOr(#("", ""))._1;
    return if (value == "") "public   (unset)" else "public   " + value;
}

// The value of `name` in `pairs`, `null` when absent.
pub fn pairValue(pairs: Array<#(string, string)>, name: string) -> ?string {
    val hit: Array<#(string, string)> = pairs.filter({ p -> p._0 == name });
    if (hit.length == 0) return null;
    return hit.at(0).unwrapOr(#("", ""))._1;
}

// The env table the `env` snapshots record: every name, `public` with its
// value (`(unset)` when absent) or `dropped`.
pub fn describePublicEnv(envPairs: Array<#(string, string)>, names: string[]) -> string {
    val width = widest(names, 0);
    var rows: string[] = ["prefix = " + publicEnvPrefix()];
    for (names) { n ->
        rows.push(n.padEnd(width + 3, " ") + envCell(envPairs, n));
    };
    return rows.join("\n");
}
