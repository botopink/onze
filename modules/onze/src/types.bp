//// onze core — the project-level vocabulary (front 49 steps 3 and 6).
////
//// What is left once jhonstart front 30 and rakun fronts 22 and 23 own the
//// render and routing vocabulary: the project (`OnzeProject`), the routing
//// file table (`AppFile`) the CLI's scan and rakun front 22 both read, and the
//// import alias map. Nothing here duplicates a rakun or jhonstart type.
////
//// The alias map is textual and build-time: front 50's scan rewrites an
//// alias prefix to its mapped path before the compiler sees the import. The
//// compiler does not know aliases exist — an alias is visible through
//// `onze dev` / `onze build` only, never to a bare `botopink check`.

import {json.Json, json.decode} from "std";
import {OnzeConfig, membersOf, isObject, isString, strOf, kindName, widest} from "config";

// ── the alias map (step 6) ──────────────────────────────────────────────────

pub type AliasMap(entries: Array<#(string, string)>)

pub fn emptyAliases() -> AliasMap {
    return AliasMap(entries: []);
}

// A target escapes the package root when a `..` segment climbs above it or
// when it is absolute.
fn escapesRoot(target: string) -> bool {
    if (target.startsWith("/")) return true;
    var depth = 0;
    var escaped = false;
    for (target.split("/")) { seg ->
        if (seg == "..") {
            depth = depth - 1;
        } else if (seg != "" && seg != ".") {
            depth = depth + 1;
        };
        if (depth < 0) escaped = true;
    };
    return escaped;
}

// The `alias` object of a project's `botopink.json`, validated: every target
// a string that stays inside the package root. A `botopink.json` with no
// `alias` key has an empty map.
pub fn loadAliases(botopinkJson: string) -> @Result<AliasMap, string> {
    val doc = try decode(botopinkJson);
    if (isObject(doc) == false) throw "botopink.json: the document must be an object, not " + kindName(doc);
    val hit = membersOf(doc).filter({ m -> m._0 == "alias" });
    if (hit.length == 0) return emptyAliases();
    val v = hit.at(0).unwrapOr(#("", Json.Null))._1;
    if (isObject(v) == false) throw "botopink.json: \"alias\" must be an object, not " + kindName(v);
    var entries: Array<#(string, string)> = [];
    for (membersOf(v)) { m ->
        if (isString(m._1) == false) throw ["alias \"", m._0, "\" must map to a string, not ", kindName(m._1)].join("");
        if (escapesRoot(strOf(m._1))) throw ["alias \"", m._0, "\" -> \"", strOf(m._1), "\" escapes the package root"].join("");
        entries.push(#(m._0, strOf(m._1)));
    };
    return AliasMap(entries: entries);
}

// `spec` with its longest matching alias prefix replaced by the mapped path;
// unchanged when no prefix matches. A prefix matches at a module boundary
// only: the whole spec, or the prefix followed by `.` or `/`.
pub fn resolveAlias(map: AliasMap, spec: string) -> string {
    var best = "";
    var target = "";
    for (map.entries) { e ->
        val whole = spec == e._0;
        val dotted = spec.startsWith(e._0 + ".");
        val slashed = spec.startsWith(e._0 + "/");
        val hits = whole || dotted || slashed;
        if (hits && e._0.length() > best.length()) {
            best = e._0;
            target = e._1;
        };
    };
    if (best == "") return spec;
    return target + spec.slice(best.length());
}

// The alias table the `alias` snapshots record: each spec and what it
// resolves to, aligned.
pub fn describeAliases(map: AliasMap, specs: string[]) -> string {
    val width = widest(specs, 0);
    return specs.map({ s -> s.padEnd(width + 2, " ") + "->  " + resolveAlias(map, s) }).join("\n");
}

// ── the project (step 3) ────────────────────────────────────────────────────

pub type OnzeProject(
    root: string,
    config: OnzeConfig,
    aliases: AliasMap,
)

// ── the routing-file table (step 3) ─────────────────────────────────────────

// `authoredPath` is what an error message names; `segment` is the
// app-relative directory — the decorator argument, rakun front 22's segment
// grammar, a route group kept (`(marketing)/about`); `kind` is one of
// `appFileKinds()`.
pub type AppFile(
    authoredPath: string,
    segment: string,
    kind: string,
)

// The eight routing conventions (`NEXTJS-DOCS.md § 3`), no more, no fewer.
pub fn appFileKinds() -> string[] {
    return ["page", "layout", "template", "default", "loading", "error", "not-found", "route"];
}

// The routing file at `path` under `appDir`, or `null` when `path` is not
// one: outside `appDir`, not a `.bp` file, not named after a convention, or
// inside a private `_folder` (which opts out with everything below it).
pub fn classifyAppFile(appDir: string, path: string) -> ?AppFile {
    val prefix = appDir + "/";
    if (path.startsWith(prefix) == false) return null;
    val rel = path.slice(prefix.length());
    val parts = rel.split("/");
    val file = parts.at(parts.length - 1).unwrapOr("");
    if (file.endsWith(".bp") == false) return null;
    val kind = file.slice(0, file.length() - 3);
    if (appFileKinds().contains(kind) == false) return null;
    val dirs = parts.take(parts.length - 1);
    if (dirs.any({ d -> d.startsWith("_") })) return null;
    return AppFile(authoredPath: path, segment: dirs.join("/"), kind: kind);
}

// The classification table the `types` snapshots record.
pub fn describeAppFiles(appDir: string, paths: string[]) -> string {
    val w0 = widest(paths, 12);
    val segs = paths.map({ p -> segmentCell(appDir, p) });
    val w1 = widest(segs, 7);
    var rows: string[] = [("authoredPath".padEnd(w0 + 2, " ") + "segment".padEnd(w1 + 2, " ") + "kind")];
    for (paths) { p ->
        val kindCell = kindCellOf(appDir, p);
        rows.push((p.padEnd(w0 + 2, " ") + segmentCell(appDir, p).padEnd(w1 + 2, " ") + kindCell).trimEnd());
    };
    return rows.join("\n");
}

fn segmentCell(appDir: string, path: string) -> string {
    val f = classifyAppFile(appDir, path);
    if (f == null) return "-";
    return f?.segment ?? "-";
}

fn kindCellOf(appDir: string, path: string) -> string {
    val f = classifyAppFile(appDir, path);
    if (f == null) return "(not an app file)";
    return f?.kind ?? "(not an app file)";
}
